@page
@model WebAppPet.Pages.Account.EditProfileModel
@using System.Globalization
@{
    ViewData["Title"] = L["Profile_Edit"].Value;
    ViewData["HideNav"] = true;
    ViewData["LangCompact"] = true;
    ViewData["OnboardBackHref"] = Url.Page("/Account/Profile");
    var HideNav = true;
    var inv = CultureInfo.InvariantCulture;
}
<div class="onboard onboard-app">
    <partial name="_OnboardTop" />
    <div class="home-body @(HideNav ? "no-nav" : "")">
    <h1 class="app-page-heading">@L["Profile_Edit"]</h1>
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    <form method="post" id="edit-profile-form" data-feedback="save"
          data-feedback-loading="@L["Feedback_Saving"]"
          data-feedback-done="@L["Feedback_Saved"]"
          data-validate-i18n="1"
          data-msg-required="@L["Validation_Required"]"
          data-msg-email="@L["Profile_Edit_EmailInvalid"]"
          data-msg-phone="@L["Phone_Invalid"]"
          data-msg-password="@L["Profile_Edit_PasswordShort"]"
          data-msg-password-mismatch="@L["Profile_Edit_PasswordMismatch"]"
          data-msg-city-maps="@L["Profile_Edit_CityMapsRequired"]">
        <div class="form-group">
            <label>@L["Register_FullName"]</label>
            <input class="form-control" asp-for="FullName" required maxlength="100" autocomplete="name" />
        </div>
        <div class="form-group">
            <label>@L["Common_Email"]</label>
            <input class="form-control" asp-for="Email" type="email" required maxlength="150" autocomplete="email"
                   placeholder="@L["Common_EmailPlaceholder"]" />
        </div>
        <div class="form-group">
            <label>@L["Common_Phone"]</label>
            <input class="form-control" asp-for="Phone" type="tel" inputmode="numeric" data-phone="1"
                   maxlength="10" pattern="[0-9]{7,10}" autocomplete="tel" placeholder="7045551234" />
        </div>
        <div class="form-group">
            <label>@L["Common_City"]</label>
            <input class="form-control" asp-for="City" id="City" data-places="city" data-places-fill="city"
                   data-places-lat="#Latitude" data-places-lng="#Longitude" data-places-require="1"
                   placeholder="@L["Home_LocationPlaceholder"]" autocomplete="off" />
            <input type="hidden" asp-for="Latitude" id="Latitude" data-places-fill="lat" />
            <input type="hidden" asp-for="Longitude" id="Longitude" data-places-fill="lng" />
            <p class="field-hint" style="margin:8px 0 0">@L["Profile_Edit_CityHint"]</p>
            <p class="field-error" id="city-maps-error" hidden>@L["Profile_Edit_CityMapsRequired"]</p>
        </div>

        <h3 class="section-title" style="margin-top:8px">@L["Profile_Edit_ChangePassword"]</h3>
        <p class="muted small" style="margin-top:-6px">@L["Profile_Edit_PasswordOptional"]</p>
        <div class="form-group">
            <label>@L["Profile_Edit_NewPassword"]</label>
            <input class="form-control" asp-for="NewPassword" type="password" minlength="6"
                   data-password-policy="1" autocomplete="new-password" />
            <p class="muted small" style="margin:6px 0 0">@L["Profile_Edit_PasswordShort"]</p>
        </div>
        <div class="form-group">
            <label>@L["Register_ConfirmPassword"]</label>
            <input class="form-control" asp-for="ConfirmPassword" type="password" minlength="6" autocomplete="new-password" />
        </div>

        <button class="btn btn-primary btn-block" type="submit">@L["Common_Save"]</button>
        <a class="btn btn-outline btn-block" asp-page="/Account/Profile" style="margin-top:10px">@L["Common_Cancel"]</a>
    </form>
    </div>
    @if (!HideNav) { <div class="bottom-nav-clearance" aria-hidden="true"></div> }
</div>

@section Scripts {
    <partial name="_GooglePlaces" />
<script>
(function () {
  var city = document.getElementById('City');
  var lat = document.getElementById('Latitude');
  var lng = document.getElementById('Longitude');
  var err = document.getElementById('city-maps-error');
  var form = document.getElementById('edit-profile-form');
  if (!city || !lat || !lng || !form) return;

  var baseline = (city.value || '').trim();

  function refreshBaseline() {
    baseline = (city.value || '').trim();
  }

  lat.addEventListener('change', refreshBaseline);
  lng.addEventListener('change', refreshBaseline);

  city.addEventListener('input', function () {
    // Si edita a mano tras elegir Maps, invalida coords hasta nueva sugerencia.
    if ((city.value || '').trim() !== baseline || !lat.value || !lng.value) {
      if ((city.value || '').trim() !== baseline) {
        lat.value = '';
        lng.value = '';
      }
    }
    if (err) err.hidden = true;
  });

  form.addEventListener('submit', function (e) {
    var c = (city.value || '').trim();
    if (!c) return;
    var hasCoords = !!(lat.value && lng.value) && !(Number(lat.value) === 0 && Number(lng.value) === 0);
    if (hasCoords) return;
    e.preventDefault();
    if (err) err.hidden = false;
    city.focus();
  });
})();
</script>
}
