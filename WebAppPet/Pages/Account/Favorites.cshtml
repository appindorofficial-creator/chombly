@page
@model WebAppPet.Pages.Account.FavoritesModel
@using WebAppPet.Services
@{
    ViewData["Title"] = L["Favorites_Title"].Value;
    ViewData["LangCompact"] = true;
    ViewData["OnboardBackHref"] = Url.Page("/Account/Profile");
    var HideNav = ViewData["HideNav"] as bool? == true;
}
<div class="onboard onboard-app">
    <partial name="_OnboardTop" />
    <div class="home-body @(HideNav ? "no-nav" : "")">
    <h1 class="app-page-heading">@L["Favorites_Title"]</h1>
    @if (!Model.Groomers.Any())
    {
        <div class="empty">@L["Favorites_Empty"]</div>
    }
    @foreach (var g in Model.Groomers)
    {
        var img = CatalogImages.Business(g.ImageUrl, g.Category?.Slug);
        <div class="groomer-card-wrap">
            <a class="groomer-card" asp-page="/Groomers/Details" asp-route-id="@g.Id">
                <img src="~@img" asp-append-version="true" alt="@g.BusinessName" onerror="this.onerror=null;this.src='/images/pet-other.svg';" />
                <div class="info">
                    <h3>@g.BusinessName</h3>
                    <div class="meta-row">
                        <span class="stars">★ @g.Rating.ToString("0.0")</span>
                        <span class="price">@L["Home_FromPrice"] $@g.StartingPrice.ToString("0")</span>
                    </div>
                </div>
            </a>
            <partial name="_FavoriteHeart" model="@((g.Id, true, "fav-remove-card"))" />
        </div>
    }
    </div>
    @if (!HideNav) { <div class="bottom-nav-clearance" aria-hidden="true"></div> }
</div>
