@page
@model WebAppPet.Pages.Account.LoginModel
@{
    ViewData["Title"] = L["Login_Title"].Value;
    ViewData["HideNav"] = true;
    ViewData["LangCompact"] = true;
    Layout = "_Layout";
}
<div class="onboard onboard-auth">
    <header class="onboard-top">
        <div class="onboard-brand">
            <img src="~/brand/v2/chombly-mark-lime.png" alt="Chombly" class="onboard-mark" />
            <strong class="onboard-word">Chombly</strong>
        </div>
        <partial name="_LanguageSwitch" />
    </header>

    <div class="onboard-stage">
        <div class="onboard-card onboard-auth-card">
            <a class="onboard-back" href="@(Model.BackPage == "/Index" ? Url.Page("/Welcome") : Model.BackPage)">← @L["Login_Welcome"]</a>
            <h1>@L["Login_Title"]</h1>
            <p class="onboard-auth-lead">@L["Home_HeroSubtitle"]</p>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger">@Model.ErrorMessage</div>
            }

            <form method="post" id="loginForm" class="onboard-auth-form" data-validate-i18n="1"
                  data-msg-required="@L["Validation_Required"]"
                  data-msg-email="@L["Profile_Edit_EmailInvalid"]"
                  data-msg-password="@L["Profile_Edit_PasswordShort"]">
                <input type="hidden" asp-for="ReturnUrl" />
                <input type="hidden" asp-for="Culture" id="cultureInput" />
                <div class="form-group">
                    <label>@L["Common_Email"]</label>
                    <input class="form-control" asp-for="Email" type="email" required autocomplete="username"
                           placeholder="@L["Common_EmailPlaceholder"]" />
                </div>
                <div class="form-group">
                    <label>@L["Common_Password"]</label>
                    <input class="form-control" asp-for="Password" type="password" required autocomplete="current-password" />
                </div>
                <button class="btn btn-enter btn-block" type="submit">@L["Login_Submit"]</button>
            </form>

            <p class="onboard-auth-links">
                @L["Login_NoAccount"]
                <a asp-page="/Account/Register">@L["Login_Register"]</a>
            </p>
            <a class="onboard-secondary" asp-page="/Account/RegisterBusiness">@L["Login_ImBusiness"]</a>
        </div>
    </div>

    <p class="onboard-version">Chombly · Pet Care</p>
</div>
