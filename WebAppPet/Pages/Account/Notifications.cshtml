@page
@model WebAppPet.Pages.Account.NotificationsModel
@using WebAppPet.Localization
@using WebAppPet.Services
@inject AuthService Auth
@{
    ViewData["Title"] = L["Profile_Notifications"].Value;
    ViewData["LangCompact"] = true;
    ViewData["OnboardBackHref"] = Model.BackHref;
    var HideNav = ViewData["HideNav"] as bool? == true;
    var i = 0;
    var businessShell = Auth.IsBusinessShell;
    var isAdmin = Auth.IsAdmin;
}
<div class="onboard onboard-app">
    <partial name="_OnboardTop" />
    <div class="home-body @(HideNav ? "no-nav" : "")">
    <div class="notif-page-head">
        <h1 class="app-page-heading">@L["Profile_Notifications"]</h1>
        @if (Model.Items.Any())
        {
            <form method="post" asp-page-handler="Clear"
                  data-confirm
                  data-confirm-title="@L["Notif_ClearAllTitle"]"
                  data-confirm-message="@L["Notif_ClearAllConfirm"]"
                  data-confirm-cancel="@L["Common_Cancel"]"
                  data-confirm-ok="@L["Notif_ClearAllOk"]"
                  data-animate-clear=".notif-swipe">
                <input type="hidden" asp-for="ReturnUrl" />
                <button type="submit" class="notif-clear-btn">@L["Notif_ClearAll"]</button>
            </form>
        }
    </div>
    @if (!Model.Items.Any())
    {
        <app-card animation="FadeIn" variant="soft" class="empty notif-empty">
            @L["Notif_Empty"]
        </app-card>
    }
    else
    {
        <p class="muted small notif-swipe-hint">@L["Notif_SwipeHint"]</p>
        <div class="notif-list">
        @foreach (var n in Model.Items)
        {
            var href = NotificationDeepLink.Resolve(n, businessShell, isAdmin)!;
            <div class="notif-swipe" style="--i:@i">
                <div class="notif-swipe-bg" aria-hidden="true">
                    <span>🗑️</span>
                    <span>@L["Common_Delete"]</span>
                </div>
                <div class="notif-item @(n.IsRead ? "" : "unread") is-openable" data-notif-swipe>
                    <a class="notif-item-open" href="@href">
                        <span class="notif-item-body">
                            <strong>@NotificationLocalizer.Title(n.Title)</strong>
                            <span class="muted small notif-item-msg">@NotificationLocalizer.Message(n.Message)</span>
                            <span class="muted small notif-item-time">@AppTimeZones.FormatShort(n.CreatedAt)</span>
                        </span>
                        <span class="notif-item-chev" aria-hidden="true">›</span>
                    </a>
                    <form method="post" asp-page-handler="Delete" class="notif-delete-form"
                          data-confirm
                          data-confirm-title="@L["Notif_DeleteTitle"]"
                          data-confirm-message="@L["Notif_DeleteConfirm"]"
                          data-confirm-cancel="@L["Common_Cancel"]"
                          data-confirm-ok="@L["Pets_DeleteOk"]"
                          data-animate-remove=".notif-swipe">
                        <input type="hidden" name="id" value="@n.Id" />
                        <input type="hidden" asp-for="ReturnUrl" />
                        <button type="submit" tabindex="-1">@L["Notif_Delete"]</button>
                    </form>
                </div>
            </div>
            i++;
        }
        </div>
    }
    </div>
    @if (!HideNav) { <div class="bottom-nav-clearance" aria-hidden="true"></div> }
</div>
