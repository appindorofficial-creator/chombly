@page
@model WebAppPet.Pages.Account.ProfileModel
@{
    ViewData["Title"] = L["Profile_Title"].Value;
}
<header class="topbar">
    <partial name="_Brand" />
    @if (Model.UserEntity != null)
    {
        <div class="topbar-right">
            <a class="icon-btn" asp-page="/Account/Notifications" asp-route-returnUrl="/Account/Profile" title="@L["Profile_Notifications"]" aria-label="@L["Profile_Notifications"]">
                <svg class="ui-ico" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 22a2.5 2.5 0 0 0 2.45-2h-4.9A2.5 2.5 0 0 0 12 22zm7-6V11a7 7 0 1 0-14 0v5l-2 2v1h18v-1l-2-2z"/></svg>
            </a>
        </div>
    }
</header>

<main class="app-main">
    <div class="lang-profile-block">
        <div>
            <strong>@L["Profile_Language"]</strong>
            <p class="muted small" style="margin:2px 0 0">@L["Common_LanguageHint"]</p>
        </div>
        <partial name="_LanguageSwitch" />
    </div>

    @if (Model.UserEntity == null)
    {
        <div class="empty-chombly">
            <img src="~/brand/v2/chombly-mark.png" alt="" class="empty-illu" style="max-width:140px" />
            <h2>@L["Profile_GuestTitle"]</h2>
            <p>@L["Profile_GuestSub"]</p>
            <a class="btn btn-primary btn-block" asp-page="/Account/Login" asp-route-returnUrl="/Account/Profile">@L["Login_Title"]</a>
            <a class="btn btn-outline btn-block" asp-page="/Account/Register" style="margin-top:10px">@L["Register_Title"]</a>
        </div>

        <div class="menu-list menu-chombly" style="margin-top:16px">
            <a asp-page="/Index"><span class="menu-left"><span class="menu-ico">🏠</span> @L["Profile_Explore"]</span><span class="chev">›</span></a>
            <a asp-page="/Account/RegisterBusiness"><span class="menu-left"><span class="menu-ico">🏪</span> @L["Profile_BecomeBusiness"]</span><span class="chev">›</span></a>
            <a asp-page="/Welcome"><span class="menu-left"><span class="menu-ico">✨</span> @L["Profile_WelcomeLink"]</span><span class="chev">›</span></a>
        </div>
    }
    else
    {
        <div class="profile-card">
            <div class="profile-avatar">👤</div>
            <h2>@Model.UserEntity.FullName</h2>
            <p class="muted small">@Model.UserEntity.Email</p>
            @if (!string.IsNullOrWhiteSpace(Model.UserEntity.Phone))
            {
                <p class="muted small">📞 @Model.UserEntity.Phone</p>
            }
            <p class="muted small location" id="profile-city-line">
                📍 @(string.IsNullOrWhiteSpace(Model.UserEntity.City) ? L["Profile_LocationMissing"].Value : Model.UserEntity.City)
            </p>
            @if (Model.HasGpsLocation)
            {
                <p class="muted small" id="profile-gps-status" style="margin-top:4px">✅ @L["Profile_LocationGpsOk"]</p>
            }
            else
            {
                <p class="muted small" id="profile-gps-status" style="margin-top:4px">⚠️ @L["Profile_LocationGpsMissing"]</p>
            }
            <button type="button" class="btn btn-outline btn-block" id="btn-profile-loc" style="margin-top:10px">
                📍 @L["Search_UseMyLocation"]
            </button>
            <a class="btn btn-outline btn-block" asp-page="/Account/EditProfile" style="margin-top:10px">✏️ @L["Profile_Edit"]</a>
        </div>

        <div class="menu-list menu-chombly">
            @if (Model.UserEntity.Role == UserRole.Groomer)
            {
                <a asp-page="/Groomer/Dashboard"><span class="menu-left"><span class="menu-ico">💼</span> @L["Profile_BusinessPanel"]</span><span class="chev">›</span></a>
                <a asp-page="/Professional/Onboarding"><span class="menu-left"><span class="menu-ico">🩺</span> @CatalogLocalizer.Loc("Onboarding profesional", "Professional onboarding")</span><span class="chev">›</span></a>
                <a asp-page="/Professional/Payouts"><span class="menu-left"><span class="menu-ico">💵</span> @CatalogLocalizer.Loc("Mis pagos", "My payouts")</span><span class="chev">›</span></a>
            }
            else if (Model.UserEntity.Role == UserRole.Admin)
            {
                <a asp-page="/Admin/Approvals"><span class="menu-left"><span class="menu-ico">✅</span> @L["Profile_AdminApprovals"]</span><span class="chev">›</span></a>
                <a asp-page="/Admin/ProfessionalApprovals"><span class="menu-left"><span class="menu-ico">🩺</span> Onboarding profesional</span><span class="chev">›</span></a>
                <a asp-page="/Admin/Payouts"><span class="menu-left"><span class="menu-ico">💵</span> Payouts</span><span class="chev">›</span></a>
            }
            else
            {
                <a asp-page="/Account/RegisterBusiness"><span class="menu-left"><span class="menu-ico">🏪</span> @L["Profile_BecomeBusiness"]</span><span class="chev">›</span></a>
            }
            <a asp-page="/Pets/Index"><span class="menu-left"><span class="menu-ico">🐾</span> @L["Profile_MyPets"]</span><span class="chev">›</span></a>
            <a asp-page="/Chat/Inbox"><span class="menu-left"><span class="menu-ico">💬</span> @L["Profile_Messages"]</span><span class="chev">›</span></a>
            <a asp-page="/Account/Favorites"><span class="menu-left"><span class="menu-ico">❤️</span> @L["Profile_Favorites"]</span><span class="chev">›</span></a>
            <a asp-page="/Appointments/Index"><span class="menu-left"><span class="menu-ico">📅</span> @L["Profile_MyAppointments"]</span><span class="chev">›</span></a>
            <a asp-page="/Account/PaymentMethods"><span class="menu-left"><span class="menu-ico">💳</span> @L["Profile_Payments"]</span><span class="chev">›</span></a>
            <a asp-page="/Account/Notifications" asp-route-returnUrl="/Account/Profile"><span class="menu-left"><span class="menu-ico">🔔</span> @L["Profile_Notifications"]</span><span class="chev">›</span></a>
            <a asp-page="/Welcome"><span class="menu-left"><span class="menu-ico">✨</span> @L["Profile_WelcomeLink"]</span><span class="chev">›</span></a>
            <a asp-page="/Account/Logout" class="menu-logout"><span class="menu-left"><span class="menu-ico">🚪</span> @L["Profile_Logout"]</span><span class="chev">›</span></a>
        </div>
    }
</main>

@section Scripts {
@if (Model.UserEntity != null)
{
    <partial name="_GooglePlaces" />
<script>
(function () {
  var btn = document.getElementById('btn-profile-loc');
  if (!btn || !navigator.geolocation) return;
  var cityLine = document.getElementById('profile-city-line');
  var gpsStatus = document.getElementById('profile-gps-status');
  var okMsg = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Profile_LocationGpsOk"].Value));
  var failMsg = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Search_LocationFail"].Value));
  var updatedMsg = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Profile_LocationUpdated"].Value));

  function reverseCity(lat, lng) {
    return new Promise(function (resolve) {
      if (!(window.google && google.maps && google.maps.Geocoder)) {
        resolve(null);
        return;
      }
      try {
        new google.maps.Geocoder().geocode({ location: { lat: lat, lng: lng } }, function (results, status) {
          if (status !== 'OK' || !results || !results[0]) {
            resolve(null);
            return;
          }
          var comps = results[0].address_components || [];
          var city = '', state = '';
          comps.forEach(function (c) {
            var t = c.types || [];
            if (t.indexOf('locality') >= 0) city = c.long_name;
            if (t.indexOf('sublocality') >= 0 && !city) city = c.long_name;
            if (t.indexOf('administrative_area_level_1') >= 0) state = c.short_name;
          });
          resolve([city, state].filter(Boolean).join(', ') || null);
        });
      } catch (_) {
        resolve(null);
      }
    });
  }

  btn.addEventListener('click', function () {
    btn.disabled = true;
    navigator.geolocation.getCurrentPosition(async function (pos) {
      var lat = pos.coords.latitude;
      var lng = pos.coords.longitude;
      var city = await reverseCity(lat, lng);
      var body = new URLSearchParams();
      body.set('lat', String(lat));
      body.set('lng', String(lng));
      if (city) body.set('city', city);
      try {
        var res = await fetch('/Account/Location', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: body,
          credentials: 'same-origin'
        });
        var data = await res.json().catch(function () { return {}; });
        if (!res.ok || !data.ok) {
          alert(failMsg);
          btn.disabled = false;
          return;
        }
        if (cityLine && (data.city || city))
          cityLine.textContent = '📍 ' + (data.city || city);
        if (gpsStatus) gpsStatus.textContent = '✅ ' + okMsg;
        btn.disabled = false;
        alert(updatedMsg);
      } catch (_) {
        alert(failMsg);
        btn.disabled = false;
      }
    }, function () {
      alert(failMsg);
      btn.disabled = false;
    });
  });
})();
</script>
}
}
