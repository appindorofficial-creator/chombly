@page
@model WebAppPet.Pages.Account.ProfileModel
@{
    ViewData["Title"] = L["Profile_Title"].Value;
    ViewData["LangCompact"] = true;
    ViewData["OnboardShowLang"] = true;
    ViewData["OnboardShowNotif"] = true;
    ViewData["OnboardNotifReturn"] = Model.UserEntity?.Role == UserRole.Admin
        ? "/Admin/Approvals"
        : "/Account/Profile";
    var isAdminOnly = Model.UserEntity?.Role == UserRole.Admin;
}
<div class="onboard onboard-app">
    <partial name="_OnboardTop" />
    <div class="home-body">
        @if (Model.UserEntity == null)
        {
            <div class="empty-chombly">
                <img src="~/brand/v2/chombly-mark.png" alt="" class="empty-illu" style="max-width:140px" />
                <h2>@L["Profile_GuestTitle"]</h2>
                <p>@L["Profile_GuestSub"]</p>
                <a class="btn btn-primary btn-block" asp-page="/Account/Login" asp-route-returnUrl="/Account/Profile">@L["Login_Title"]</a>
                <a class="btn btn-outline btn-block" asp-page="/Account/Register" asp-route-returnUrl="/Account/Profile" style="margin-top:10px">@L["Register_Title"]</a>
            </div>

            <div class="menu-list menu-chombly" style="margin-top:16px">
                <p class="menu-section-label">@CatalogLocalizer.Loc("Explorar", "Explore")</p>
                <a asp-page="/Index"><span class="menu-left"><span class="menu-ico" aria-hidden="true">🏠</span> @L["Profile_Explore"]</span><span class="chev" aria-hidden="true">›</span></a>
                <a asp-page="/Account/RegisterBusiness"><span class="menu-left"><span class="menu-ico" aria-hidden="true">🏪</span> @L["Profile_BecomeBusiness"]</span><span class="chev" aria-hidden="true">›</span></a>
                @if (Model.InPresentationTour)
                {
                    <a asp-page="/Business/Explore/Exit" asp-route-returnUrl="/Account/Profile"><span class="menu-left"><span class="menu-ico" aria-hidden="true">↩</span> @L["Home_ExitWelcome"]</span><span class="chev" aria-hidden="true">›</span></a>
                }
                else
                {
                    <a asp-page="/Welcome" asp-route-returnUrl="/Account/Profile"><span class="menu-left"><span class="menu-ico" aria-hidden="true">✨</span> @L["Profile_WelcomeLink"]</span><span class="chev" aria-hidden="true">›</span></a>
                }
            </div>
        }
        else
        {
            <div class="profile-card">
                <div class="profile-avatar" aria-hidden="true">
                    <img src="~/images/chombly-profile-avatar.png" asp-append-version="true" alt="" />
                </div>
                <h2>@Model.UserEntity.FullName</h2>
                @if (isAdminOnly)
                {
                    <p class="muted small" style="margin:0 0 8px">@CatalogLocalizer.Loc("Panel de operaciones Chombly", "Chombly operations panel")</p>
                }
                <ul class="profile-facts">
                    <li class="profile-fact">
                        <span class="profile-fact-ico" aria-hidden="true">✉️</span>
                        <span class="profile-fact-value">@Model.UserEntity.Email</span>
                        <button type="button" class="profile-fact-copy"
                                data-copy="@Model.UserEntity.Email"
                                data-copy-ok="✓ @L["Feedback_Copied"]"
                                data-copy-fail="@L["Feedback_CopyFail"]"
                                aria-label="@L["Feedback_Copied"]">⧉</button>
                    </li>
                    @if (!string.IsNullOrWhiteSpace(Model.UserEntity.Phone))
                    {
                        <li class="profile-fact">
                            <span class="profile-fact-ico" aria-hidden="true">📞</span>
                            <span class="profile-fact-value">@Model.UserEntity.Phone</span>
                        </li>
                    }
                    @if (!isAdminOnly)
                    {
                        <li class="profile-fact" id="profile-city-line">
                            <span class="profile-fact-ico" aria-hidden="true">📍</span>
                            <span class="profile-fact-value">@(string.IsNullOrWhiteSpace(Model.UserEntity.City) ? L["Profile_LocationMissing"].Value : Model.UserEntity.City)</span>
                        </li>
                    }
                </ul>
                @if (!isAdminOnly)
                {
                    if (Model.HasGpsLocation)
                    {
                        <p class="profile-loc-status is-ok" id="profile-gps-status">
                            <span aria-hidden="true">✅</span>
                            <span>@L["Profile_LocationGpsOk"]</span>
                        </p>
                    }
                    else
                    {
                        <p class="profile-loc-status is-warn" id="profile-gps-status">
                            <span aria-hidden="true">⚠️</span>
                            <span>@L["Profile_LocationGpsMissing"]</span>
                        </p>
                    }
                    <div class="profile-actions">
                        <button type="button" class="btn profile-action-btn" id="btn-profile-loc">
                            📍 @(Model.HasGpsLocation ? L["Profile_UpdateLocation"] : L["Search_UseMyLocation"])
                        </button>
                        <a class="btn profile-action-btn" asp-page="/Account/EditProfile">✏️ @L["Profile_Edit"]</a>
                    </div>
                }
                else
                {
                    <div class="profile-actions">
                        <a class="btn profile-action-btn" asp-page="/Account/EditProfile">✏️ @L["Profile_Edit"]</a>
                    </div>
                }
            </div>

            @if (Model.CanSwitchShell)
            {
                <div class="profile-shell-switch" role="group" aria-label="@L["Profile_ShellMode"]">
                    <p class="profile-shell-label">@L["Profile_ShellMode"]</p>
                    <div class="profile-shell-toggle">
                        <a class="profile-shell-opt @(Model.IsBusinessShell ? "" : "is-active")"
                           asp-page="/Account/SetAppMode"
                           asp-route-mode="owner"
                           asp-route-returnUrl="/Account/Profile">
                            🐾 @L["Profile_ShellOwner"]
                        </a>
                        <a class="profile-shell-opt @(Model.IsBusinessShell ? "is-active" : "")"
                           asp-page="/Account/SetAppMode"
                           asp-route-mode="business"
                           asp-route-returnUrl="/Account/Profile">
                            💼 @L["Profile_ShellBusiness"]
                        </a>
                    </div>
                    <p class="muted small profile-shell-hint">@L["Profile_ShellHint"]</p>
                </div>
            }

            <div class="menu-list menu-chombly">
                @{
                    // Dual-role: filter menu by shell. Clients always see owner activity.
                    // Pure admin accounts skip owner/business shells — only Admin links.
                    var showBusinessMenu = !isAdminOnly && Model.CanSwitchShell && Model.IsBusinessShell;
                    var showOwnerActivity = !isAdminOnly && (!Model.CanSwitchShell || !Model.IsBusinessShell);
                }
                @if (isAdminOnly)
                {
                    <p class="menu-section-label">Admin</p>
                    <a asp-page="/Admin/Approvals"><span class="menu-left"><span class="menu-ico" aria-hidden="true">✅</span> @L["Profile_AdminApprovals"]</span><span class="chev" aria-hidden="true">›</span></a>
                    <a asp-page="/Admin/ProfessionalApprovals"><span class="menu-left"><span class="menu-ico" aria-hidden="true">🩺</span> Onboarding profesional</span><span class="chev" aria-hidden="true">›</span></a>
                    <a asp-page="/Admin/Payments"><span class="menu-left"><span class="menu-ico" aria-hidden="true">💳</span> @CatalogLocalizer.Loc("Pagos", "Payments")</span><span class="chev" aria-hidden="true">›</span></a>
                    <a asp-page="/Admin/Payouts"><span class="menu-left"><span class="menu-ico" aria-hidden="true">💵</span> Payouts</span><span class="chev" aria-hidden="true">›</span></a>
                }

                @if (showBusinessMenu)
                {
                    <p class="menu-section-label">@CatalogLocalizer.Loc("Negocio", "Business")</p>
                    <a asp-page="/Account/SetAppMode" asp-route-mode="business" asp-route-returnUrl="/Groomer/Dashboard"><span class="menu-left"><span class="menu-ico" aria-hidden="true">💼</span> @L["Profile_BusinessPanel"]</span><span class="chev" aria-hidden="true">›</span></a>
                    <a asp-page="/Professional/Onboarding"><span class="menu-left"><span class="menu-ico" aria-hidden="true">🩺</span> @CatalogLocalizer.Loc("Onboarding profesional", "Professional onboarding")</span><span class="chev" aria-hidden="true">›</span></a>
                    <a asp-page="/Professional/Payouts"><span class="menu-left"><span class="menu-ico" aria-hidden="true">💵</span> @CatalogLocalizer.Loc("Mis pagos", "My payouts")</span><span class="chev" aria-hidden="true">›</span></a>
                }

                @if (showOwnerActivity)
                {
                    <p class="menu-section-label">@CatalogLocalizer.Loc("Tu actividad", "Your activity")</p>
                    @if (Model.CanSwitchShell)
                    {
                        <a asp-page="/Account/SetAppMode" asp-route-mode="owner" asp-route-returnUrl="/Pets/Index"><span class="menu-left"><span class="menu-ico" aria-hidden="true">🐾</span> @L["Profile_MyPets"]</span><span class="chev" aria-hidden="true">›</span></a>
                    }
                    else
                    {
                        <a asp-page="/Pets/Index"><span class="menu-left"><span class="menu-ico" aria-hidden="true">🐾</span> @L["Profile_MyPets"]</span><span class="chev" aria-hidden="true">›</span></a>
                    }
                    <a asp-page="/Chat/Inbox"><span class="menu-left"><span class="menu-ico" aria-hidden="true">💬</span> @L["Profile_Messages"]</span><span class="chev" aria-hidden="true">›</span></a>
                    <a asp-page="/Account/Favorites"><span class="menu-left"><span class="menu-ico" aria-hidden="true">❤️</span> @L["Profile_Favorites"]</span><span class="chev" aria-hidden="true">›</span></a>
                    <a asp-page="/Appointments/Index"><span class="menu-left"><span class="menu-ico" aria-hidden="true">📅</span> @L["Profile_MyAppointments"]</span><span class="chev" aria-hidden="true">›</span></a>
                }
                else if (showBusinessMenu)
                {
                    <p class="menu-section-label">@CatalogLocalizer.Loc("Tu actividad", "Your activity")</p>
                    <a asp-page="/Chat/Inbox"><span class="menu-left"><span class="menu-ico" aria-hidden="true">💬</span> @L["Profile_Messages"]</span><span class="chev" aria-hidden="true">›</span></a>
                }

                <p class="menu-section-label">@CatalogLocalizer.Loc("Cuenta", "Account")</p>
                @if (Model.UserEntity.Role != UserRole.Groomer && Model.UserEntity.Role != UserRole.Admin)
                {
                    <a asp-page="/Account/RegisterBusiness"><span class="menu-left"><span class="menu-ico" aria-hidden="true">🏪</span> @L["Profile_BecomeBusiness"]</span><span class="chev" aria-hidden="true">›</span></a>
                }
                @if (!isAdminOnly && (showOwnerActivity || !Model.CanSwitchShell))
                {
                    <a asp-page="/Account/PaymentMethods"><span class="menu-left"><span class="menu-ico" aria-hidden="true">💳</span> @L["Profile_Payments"]</span><span class="chev" aria-hidden="true">›</span></a>
                }
                <a asp-page="/Account/Notifications" asp-route-returnUrl="@(isAdminOnly ? "/Admin/Approvals" : "/Account/Profile")"><span class="menu-left"><span class="menu-ico" aria-hidden="true">🔔</span> @L["Profile_Notifications"]</span><span class="chev" aria-hidden="true">›</span></a>
            </div>

            <div class="menu-list menu-chombly menu-chombly-logout">
                <a asp-page="/Account/Logout" class="menu-logout"><span class="menu-left"><span class="menu-ico" aria-hidden="true">🚪</span> @L["Profile_Logout"]</span><span class="chev" aria-hidden="true">›</span></a>
            </div>
        }
    </div>
    <div class="bottom-nav-clearance" aria-hidden="true"></div>
</div>

@section Scripts {
@if (Model.UserEntity != null)
{
    <partial name="_GooglePlaces" />
<script>
(function () {
  var btn = document.getElementById('btn-profile-loc');
  if (!btn || !navigator.geolocation) return;
  var cityLine = document.getElementById('profile-city-line');
  var gpsStatus = document.getElementById('profile-gps-status');
  var hadGps = @(Model.HasGpsLocation ? "true" : "false");
  var okMsg = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Profile_LocationGpsOk"].Value));
  var failMsg = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Search_LocationFail"].Value));
  var deniedMsg = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Search_LocationDenied"].Value));
  var timeoutMsg = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Search_LocationTimeout"].Value));
  var keepMsg = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Profile_LocationRefreshFailKeep"].Value));
  var updatedMsg = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Profile_LocationUpdated"].Value));

  function notify(msg, kind) {
    if (window.ChomblyToast && typeof ChomblyToast.show === 'function') {
      ChomblyToast.show(msg, { kind: kind || 'error' });
      return;
    }
    alert(msg);
  }

  function reverseCity(lat, lng) {
    return new Promise(function (resolve) {
      if (!(window.google && google.maps && google.maps.Geocoder)) {
        resolve(null);
        return;
      }
      try {
        new google.maps.Geocoder().geocode({ location: { lat: lat, lng: lng } }, function (results, status) {
          if (status !== 'OK' || !results || !results[0]) {
            resolve(null);
            return;
          }
          var comps = results[0].address_components || [];
          var city = '', state = '';
          comps.forEach(function (c) {
            var t = c.types || [];
            if (t.indexOf('locality') >= 0) city = c.long_name;
            if (t.indexOf('sublocality') >= 0 && !city) city = c.long_name;
            if (t.indexOf('administrative_area_level_1') >= 0) state = c.short_name;
          });
          resolve([city, state].filter(Boolean).join(', ') || null);
        });
      } catch (_) {
        resolve(null);
      }
    });
  }

  function unlockBtn() {
    btn.disabled = false;
    btn.classList.remove('is-active');
  }

  function onGeoError(err) {
    unlockBtn();
    if (hadGps) {
      // Already have saved coords — don't contradict the green "ready" status.
      notify(keepMsg, 'info');
      return;
    }
    var code = err && err.code;
    if (code === 1) notify(deniedMsg, 'error');
    else if (code === 3) notify(timeoutMsg, 'error');
    else notify(failMsg, 'error');
  }

  btn.addEventListener('click', function () {
    btn.disabled = true;
    btn.classList.add('is-active');
    navigator.geolocation.getCurrentPosition(async function (pos) {
      var lat = pos.coords.latitude;
      var lng = pos.coords.longitude;
      var city = await reverseCity(lat, lng);
      var body = new URLSearchParams();
      body.set('lat', String(lat));
      body.set('lng', String(lng));
      if (city) body.set('city', city);
      try {
        var res = await fetch('/Account/Location', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: body,
          credentials: 'same-origin'
        });
        var data = await res.json().catch(function () { return {}; });
        if (!res.ok || !data.ok) {
          onGeoError(null);
          return;
        }
        hadGps = true;
        if (cityLine && (data.city || city)) {
          var cityText = cityLine.querySelector('.profile-fact-value');
          if (cityText) cityText.textContent = data.city || city;
          else cityLine.textContent = '📍 ' + (data.city || city);
        }
        if (gpsStatus) {
          gpsStatus.className = 'profile-loc-status is-ok';
          gpsStatus.innerHTML = '<span aria-hidden="true">✅</span><span>' + okMsg + '</span>';
        }
        unlockBtn();
        notify(updatedMsg, 'success');
      } catch (_) {
        onGeoError(null);
      }
    }, onGeoError, {
      enableHighAccuracy: true,
      timeout: 15000,
      maximumAge: 120000
    });
  });
})();
</script>
}
}
