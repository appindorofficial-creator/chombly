@page
@model WebAppPet.Pages.Admin.ApprovalsModel
@{
    ViewData["Title"] = "Aprobar negocios";
    ViewData["LangCompact"] = true;
    ViewData["OnboardShowNotif"] = true;
    ViewData["OnboardNotifReturn"] = "/Admin/Approvals";
}
<div class="onboard onboard-app">
    <partial name="_OnboardTop" />
    <div class="home-body">
    <h1 class="app-page-heading">@CatalogLocalizer.Loc("Aprobaciones de negocio", "Business approvals")</h1>
    <p class="muted small">@CatalogLocalizer.Loc("Negocios en revisión. Al aprobar aparecen en Hotel, Vet, Daycare, etc.", "Businesses under review. After approval they appear in Hotel, Vet, Daycare, etc.")</p>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert alert-info">@Model.Message</div>
    }

    @if (!Model.Pending.Any())
    {
        <div class="empty">@CatalogLocalizer.Loc("No hay solicitudes pendientes.", "No pending requests.")</div>
    }

    @foreach (var g in Model.Pending)
    {
        <div class="card card-pad" style="margin-bottom:12px">
            <h3 style="margin:0 0 4px">@(g.Category?.Emoji) @g.BusinessName</h3>
            <p class="muted small" style="margin:0">@g.User.FullName · @g.User.Email · @g.Phone</p>
            <p class="muted small">@g.Address · @g.City</p>
            <p class="muted small">@(g.Latitude), @(g.Longitude)</p>
            <p class="muted small">Servicios: @g.Services.Count · Días abiertos/sem: @g.WeeklyHours.Count(h => h.IsOpen)</p>
            <p style="margin:8px 0">@CatalogLocalizer.Text(g.About)</p>
            <div style="display:flex;gap:8px">
                <form method="post" asp-page-handler="Approve" style="flex:1">
                    <input type="hidden" name="id" value="@g.Id" />
                    <button class="btn btn-primary btn-block" type="submit">@CatalogLocalizer.Loc("Aprobar", "Approve")</button>
                </form>
                <form method="post" asp-page-handler="Reject" style="flex:1">
                    <input type="hidden" name="id" value="@g.Id" />
                    <button class="btn btn-outline btn-block" type="submit">@CatalogLocalizer.Loc("Rechazar", "Reject")</button>
                </form>
            </div>
        </div>
    }
    </div>
    <div class="bottom-nav-clearance" aria-hidden="true"></div>
</div>
