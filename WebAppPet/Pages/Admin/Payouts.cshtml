@page
@model WebAppPet.Pages.Admin.PayoutsModel
@{
    ViewData["Title"] = L["AdminPayout_Title"].Value;
    ViewData["LangCompact"] = true;
    ViewData["OnboardShowNotif"] = true;
    ViewData["OnboardNotifReturn"] = "/Admin/Payouts";
    string Money(decimal amount, string currency) => AppMoney.FormatCurrency(amount, currency);
    string ProviderName(WebAppPet.Domain.ProviderPayout p) =>
        p.ProviderUser?.FullName ?? string.Format(L["AdminPayout_UnknownProvider"].Value, p.ProviderUserId);
    string StatusLabel(WebAppPet.Domain.ProviderPayoutStatus s) => s switch
    {
        WebAppPet.Domain.ProviderPayoutStatus.Pending => L["Payout_Status_Pending"].Value,
        WebAppPet.Domain.ProviderPayoutStatus.Processing => L["Payout_Status_Processing"].Value,
        WebAppPet.Domain.ProviderPayoutStatus.Paid => L["Payout_Status_Paid"].Value,
        WebAppPet.Domain.ProviderPayoutStatus.Failed => L["Payout_Status_Failed"].Value,
        WebAppPet.Domain.ProviderPayoutStatus.Held => L["Payout_Status_Held"].Value,
        _ => s.ToString()
    };
}
<div class="onboard onboard-app">
    <partial name="_OnboardTop" />
    <div class="home-body">
    <h1 class="app-page-heading">@CatalogLocalizer.Loc("Liquidaciones", "Payouts")</h1>
    <p class="muted small">@CatalogLocalizer.Loc("Liquidaciones a proveedores (simulado · sin Stripe Connect real).", "Provider settlements (simulated · no live Stripe Connect).")</p>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert alert-info">@Model.Message</div>
    }

    <h2 class="section-title">@CatalogLocalizer.Loc("Pendientes", "Pending")</h2>
    @if (!Model.Pending.Any())
    {
        <div class="empty">@CatalogLocalizer.Loc("No hay liquidaciones pendientes.", "No pending payouts.")</div>
    }
    @foreach (var p in Model.Pending)
    {
        var currency = Model.CurrencyOf(p);
        <div class="card card-pad" style="margin-bottom:10px">
            <strong>@ProviderName(p)</strong>
            <span class="muted small" style="display:block">
                @AppTimeZones.FormatDate(p.PeriodStart) – @AppTimeZones.FormatDate(p.PeriodEnd)
                · @p.ConsultationCount @CatalogLocalizer.Loc("ítems", "items")
            </span>
            <span class="muted small" style="display:block">
                @CatalogLocalizer.Loc("Bruto", "Gross") @Money(p.GrossAmountUsd, currency)
                · @CatalogLocalizer.Loc("Comisión", "Commission") @Money(p.CommissionAmountUsd, currency)
                @if (p.RefundDeduction > 0) { <text>· @CatalogLocalizer.Loc("Reembolsos ya pagados", "Refunds already paid out") −@Money(p.RefundDeduction, currency)</text> }
                · <strong>@CatalogLocalizer.Loc("Neto", "Net") @Money(p.NetAmountUsd, currency)</strong>
                · @currency
            </span>
            <form method="post" asp-page-handler="MarkPaid" style="margin-top:8px">
                <input type="hidden" name="id" value="@p.Id" />
                <button class="btn btn-primary btn-block" type="submit">@CatalogLocalizer.Loc("Marcar pagado (simulado)", "Mark paid (simulated)")</button>
            </form>
        </div>
    }

    <h2 class="section-title" style="margin-top:20px">@CatalogLocalizer.Loc("Recientes", "Recent")</h2>
    @foreach (var p in Model.Recent.Where(x => x.Status != WebAppPet.Domain.ProviderPayoutStatus.Pending))
    {
        var currency = Model.CurrencyOf(p);
        <div class="card card-pad" style="margin-bottom:8px">
            <strong>@StatusLabel(p.Status)</strong> · @ProviderName(p)
            <span class="muted small" style="display:block">
                @CatalogLocalizer.Loc("Bruto", "Gross") @Money(p.GrossAmountUsd, currency)
                · @CatalogLocalizer.Loc("Comisión", "Commission") @Money(p.CommissionAmountUsd, currency)
                @if (p.RefundDeduction > 0) { <text>· @CatalogLocalizer.Loc("Reembolsos ya pagados", "Refunds already paid out") −@Money(p.RefundDeduction, currency)</text> }
                · <strong>@CatalogLocalizer.Loc("Neto", "Net") @Money(p.NetAmountUsd, currency)</strong>
                · @p.ConsultationCount @CatalogLocalizer.Loc("ítems", "items")
            </span>
            <span class="muted small" style="display:block">
                @if (p.PaidUtc is DateTime paid) { <text>@AppTimeZones.FormatShort(paid)</text> }
                @if (!string.IsNullOrEmpty(p.ExternalReference)) { <text> · @p.ExternalReference</text> }
            </span>
        </div>
    }
    </div>
    <div class="bottom-nav-clearance" aria-hidden="true"></div>
</div>
