@page
@model WebAppPet.Pages.Admin.ProfessionalApprovalsModel
@using WebAppPet.Services
@{
    ViewData["Title"] = "Aprobaciones profesionales";
    ViewData["LangCompact"] = true;
    ViewData["OnboardShowNotif"] = true;
    ViewData["OnboardNotifReturn"] = "/Admin/ProfessionalApprovals";
}
<div class="onboard onboard-app">
    <partial name="_OnboardTop" />
    <div class="home-body">
    <h1 class="app-page-heading">@CatalogLocalizer.Loc("Onboarding profesional", "Professional onboarding")</h1>
    <p class="muted small">@CatalogLocalizer.Loc("Solicitudes Local / Internacional / Conducta.", "Local / International / Behavior applications.")</p>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert alert-info">@Model.Message</div>
    }
    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert alert-warn">@Model.Error</div>
    }

    @if (!Model.Pending.Any())
    {
        <div class="empty">@CatalogLocalizer.Loc("No hay solicitudes pendientes.", "No pending requests.")</div>
    }

    @foreach (var a in Model.Pending)
    {
        <div class="card card-pad" style="margin-bottom:12px">
            <h3 style="margin:0 0 4px">@a.LegalName</h3>
            <p class="muted small" style="margin:0">@(a.User?.Email) · @a.Track · @a.Status</p>
            <p class="muted small">@a.ClinicOrPracticeName · @a.LicenseJurisdiction · @a.LicenseNumber</p>
            @if (!string.IsNullOrWhiteSpace(a.Languages))
            {
                <p class="muted small">Idiomas: @a.Languages</p>
            }
            @if (!string.IsNullOrWhiteSpace(a.BreedExpertiseCsv))
            {
                <p class="muted small">Razas: @a.BreedExpertiseCsv</p>
            }
            @if (!string.IsNullOrWhiteSpace(a.DocumentsNote))
            {
                <p class="muted small">Docs: @a.DocumentsNote</p>
            }
            @if (!string.IsNullOrWhiteSpace(a.UploadPath))
            {
                <p class="muted small"><a href="@a.UploadPath" target="_blank">Ver archivo</a></p>
            }
            @if (a.SubmittedUtc is DateTime sub)
            {
                <p class="muted small">Enviado: @AppTimeZones.FormatShort(sub)</p>
            }
            <div style="display:flex;gap:8px;flex-wrap:wrap">
                <form method="post" asp-page-handler="Approve" style="flex:1;min-width:120px">
                    <input type="hidden" name="id" value="@a.Id" />
                    <button class="btn btn-primary btn-block" type="submit">@CatalogLocalizer.Loc("Aprobar", "Approve")</button>
                </form>
                <form method="post" asp-page-handler="Reject" style="flex:1;min-width:160px">
                    <input type="hidden" name="id" value="@a.Id" />
                    <input class="form-control" name="RejectNotes" placeholder="@CatalogLocalizer.Loc("Notas de rechazo", "Rejection notes")" style="margin-bottom:6px" />
                    <button class="btn btn-outline btn-block" type="submit">@CatalogLocalizer.Loc("Rechazar", "Reject")</button>
                </form>
            </div>
        </div>
    }
    </div>
    <div class="bottom-nav-clearance" aria-hidden="true"></div>
</div>
