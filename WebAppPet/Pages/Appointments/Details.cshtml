@page "{id:int}"
@model WebAppPet.Pages.Appointments.DetailsModel
@{
    ViewData["Title"] = CatalogLocalizer.Loc("Detalle de cita", "Appointment details");
    ViewData["HideNav"] = true;
    ViewData["LangCompact"] = true;
    ViewData["OnboardBackHref"] = Model.BackHref;
    var HideNav = true;
}

<div class="onboard onboard-app">
    <partial name="_OnboardTop" />
    <div class="home-body @(HideNav ? "no-nav" : "")">
    <h1 class="app-page-heading">@CatalogLocalizer.Loc("Detalle de cita", "Appointment details")</h1>
@if (Model.Appointment == null)
{
    <div class="empty">@CatalogLocalizer.Loc("Cita no encontrada.", "Appointment not found.")</div>
}
else
{
    var a = Model.Appointment;
    <div class="card" style="margin-bottom:14px">
        @{
            var detailImg = !string.IsNullOrWhiteSpace(a.Groomer.ImageUrl)
                ? a.Groomer.ImageUrl!
                : !string.IsNullOrWhiteSpace(a.Groomer.Category?.Slug)
                    ? CatalogImages.Category(a.Groomer.Category!.Slug)
                    : "/images/pet-other.svg";
        }
        <img src="@detailImg" alt="" style="width:100%;height:160px;object-fit:cover"
             onerror="this.onerror=null;this.src='/images/pet-other.svg';" />
        <div class="card-pad">
            <h2 style="margin:0 0 6px">@a.Groomer.BusinessName</h2>
            <span class="badge @Model.StatusBadge(a.Status)">@Model.StatusLabel(a.Status)</span>
            <p class="muted small" style="margin-top:8px">📍 @a.Groomer.Address</p>
        </div>
    </div>

    <div class="card card-pad" style="margin-bottom:14px">
        <p><strong>@CatalogLocalizer.Loc("Servicio", "Service"):</strong> @CatalogLocalizer.Text(a.Service.Name)</p>
        @if (a.Nights > 0 && a.EndAt.HasValue)
        {
            <p><strong>@CatalogLocalizer.Loc("Check-in", "Check-in"):</strong> @a.ScheduledAt.ToString("dddd, d MMMM yyyy")</p>
            <p><strong>@CatalogLocalizer.Loc("Check-out", "Check-out"):</strong> @a.EndAt.Value.ToString("dddd, d MMMM yyyy")</p>
            <p><strong>@CatalogLocalizer.Loc("Noches", "Nights"):</strong> @a.Nights</p>
        }
        else
        {
            <p><strong>@CatalogLocalizer.Loc("Fecha", "Date"):</strong> @AppTimeZones.ToAppLocal(a.ScheduledAt).ToString("dddd, d MMMM yyyy")</p>
            <p><strong>@CatalogLocalizer.Loc("Hora", "Time"):</strong> @AppTimeZones.ToAppLocal(a.ScheduledAt).ToString("h:mm tt")</p>
        }
        <p><strong>@CatalogLocalizer.Loc("Mascota", "Pet"):</strong> @PetSpecies.Emoji(a.Pet.Species) @a.Pet.Name (@PetSpecies.Label(a.Pet.Species) · @a.Pet.Breed)</p>
        @if (a.Extras.Any())
        {
            <p><strong>@CatalogLocalizer.Loc("Extras", "Extras"):</strong> @string.Join(", ", a.Extras.Select(e => $"{CatalogLocalizer.Text(e.Name)} (+${e.Price:0})"))</p>
        }
        @if (a.DiscountAmount > 0 && !string.IsNullOrEmpty(a.PromoCode))
        {
            <p class="promo-line promo-discount">
                <strong>@string.Format(L["Promo_DiscountLine"].Value, a.PromoCode)</strong>
                <span class="price">−$@a.DiscountAmount.ToString("0.00")</span>
            </p>
        }
        <p><strong>@CatalogLocalizer.Loc("Total", "Total"):</strong> <span class="price">$@a.TotalPrice.ToString("0.00")</span></p>
        @if (!string.IsNullOrWhiteSpace(a.Notes))
        {
            <p><strong>@CatalogLocalizer.Loc("Notas", "Notes"):</strong> @CatalogLocalizer.Notes(a.Notes)</p>
        }
    </div>

    <a class="btn btn-outline btn-block" asp-page="/Chat/Index" asp-route-groomerId="@a.GroomerId" asp-route-appointmentId="@a.Id" asp-route-returnUrl="@(Model.ReturnUrl ?? Url.Page("/Appointments/Details", new { id = a.Id }))">@CatalogLocalizer.Loc("Mensaje al negocio", "Message the business")</a>
    @if (!string.IsNullOrEmpty(a.Groomer.Phone))
    {
        <a class="btn btn-outline btn-block" href="tel:@a.Groomer.Phone" style="margin-top:10px">@CatalogLocalizer.Loc("Contactar", "Contact")</a>
    }

    @if (Model.CanWriteReview)
    {
        <a class="btn btn-primary btn-block" style="margin-top:10px"
           asp-page="/Reviews/Write"
           asp-route-groomerId="@a.GroomerId"
           asp-route-appointmentId="@a.Id"
           asp-route-returnUrl="@(Url.Page("/Appointments/Details", new { id = a.Id }))">
            @CatalogLocalizer.Loc("Valorar visita", "Rate visit")
        </a>
    }

    @if (a.Status is AppointmentStatus.Pending or AppointmentStatus.Confirmed)
    {
        var cancelTitle = CatalogLocalizer.Loc("Cancelar reserva", "Cancel booking");
        var cancelMsg = CatalogLocalizer.Loc("¿Cancelar esta reserva?", "Cancel this booking?");
        var cancelKeep = CatalogLocalizer.Loc("No, mantener", "No, keep");
        var cancelOk = CatalogLocalizer.Loc("Sí, cancelar", "Yes, cancel");
        <form method="post" asp-page-handler="Cancel" style="margin-top:10px"
              data-confirm
              data-confirm-title="@cancelTitle"
              data-confirm-message="@cancelMsg"
              data-confirm-cancel="@cancelKeep"
              data-confirm-ok="@cancelOk">
            <input type="hidden" name="id" value="@a.Id" />
            <button class="btn btn-outline btn-block" type="submit" style="color:var(--danger);border-color:var(--danger)">@cancelTitle</button>
        </form>
    }
}
    </div>
    @if (!HideNav) { <div class="bottom-nav-clearance" aria-hidden="true"></div> }
</div>
