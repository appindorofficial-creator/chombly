@page
@model WebAppPet.Pages.Appointments.IndexModel
@{
    ViewData["Title"] = L["Appt_Title"].Value;
    ViewData["LangCompact"] = true;
    if (!Model.IsGuest)
    {
        ViewData["OnboardShowNotif"] = true;
        ViewData["OnboardNotifReturn"] = "/Appointments";
    }
}
<div class="onboard onboard-app">
    <partial name="_OnboardTop" />
    <div class="home-body">
        <h1 class="page-title">@L["Appt_Title"]</h1>

        @if (Model.IsGuest)
        {
            <div class="empty-chombly">
                <img src="~/images/chombly-empty-appointments-v3.png" asp-append-version="true" alt="" class="empty-illu" />
                <h2>@L["Appt_GuestTitle"]</h2>
                <p>@L["Appt_GuestSub"]</p>
                <a class="btn btn-primary btn-block" asp-page="/Account/Login" asp-route-returnUrl="/Appointments">@L["Login_Title"]</a>
                <a class="btn btn-outline btn-block" asp-page="/Account/Register" style="margin-top:10px">@L["Register_Title"]</a>
            </div>
        }
        else
        {
            <div class="tabs tabs-chombly">
                <a class="@(Model.Tab == "upcoming" ? "active" : "")" asp-page="./Index" asp-route-tab="upcoming">
                    <svg class="ui-ico" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M7 2h2v2h6V2h2v2h3v16H4V4h3V2zm11 8H6v8h12v-8z"/></svg>
                    @L["Appt_Upcoming"]
                </a>
                <a class="@(Model.Tab == "history" ? "active" : "")" asp-page="./Index" asp-route-tab="history">
                    <svg class="ui-ico" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm1 10.5V7h-2v7l5 3 1-1.7-4-2.8z"/></svg>
                    @L["Appt_History"]
                </a>
                <a class="tabs-cta" href="/Groomers">
                    <svg class="ui-ico" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M19 11h-6V5h-2v6H5v2h6v6h2v-6h6v-2z"/></svg>
                    @L["Appt_Book"]
                </a>
            </div>

            @if (Model.Items.Any())
            {
                @foreach (var a in Model.Items)
                {
                    var img = !string.IsNullOrWhiteSpace(a.Groomer.ImageUrl)
                        ? a.Groomer.ImageUrl!
                        : !string.IsNullOrWhiteSpace(a.Groomer.Category?.Slug)
                            ? CatalogImages.Category(a.Groomer.Category!.Slug)
                            : "/images/pet-other.svg";
                    <a class="appt-card" asp-page="./Details" asp-route-id="@a.Id">
                        <div class="row">
                            <img src="@img"
                                 alt="@a.Groomer.BusinessName"
                                 loading="lazy"
                                 onerror="this.onerror=null;this.src='/images/pet-other.svg';" />
                            <div style="flex:1">
                                <strong>@a.Groomer.BusinessName</strong>
                                <div class="muted small">@CatalogLocalizer.Text(a.Service.Name) · @PetSpecies.Emoji(a.Pet.Species) @a.Pet.Name (@PetSpecies.Label(a.Pet.Species))</div>
                                <div class="muted small">@a.ScheduledAt.ToString("ddd d MMM · h:mm tt")</div>
                                <span class="badge @Model.StatusBadge(a.Status)">@Model.StatusLabel(a.Status)</span>
                            </div>
                            <span class="price">$@a.TotalPrice.ToString("0")</span>
                        </div>
                    </a>
                }
            }
            else
            {
                <div class="empty-chombly">
                    <img src="~/images/chombly-empty-appointments-v3.png" asp-append-version="true" alt="" class="empty-illu" />
                    <h2>@L["Appt_EmptyTitle"]</h2>
                    <p>@L["Appt_EmptySub"]</p>
                    <a class="btn btn-primary btn-block" href="/Groomers">
                        📅 @L["Appt_BookNew"]
                    </a>
                </div>

                <section class="how-card" aria-labelledby="appt-how-title">
                    <h3 id="appt-how-title">@L["Appt_HowTitle"]</h3>
                    <ol class="how-steps">
                        <li class="how-step">
                            <span class="how-num" aria-hidden="true">1</span>
                            <div class="how-copy">
                                <strong>@L["Appt_HowSearch"]</strong>
                                <p>@L["Appt_HowSearchDesc"]</p>
                            </div>
                        </li>
                        <li class="how-step">
                            <span class="how-num" aria-hidden="true">2</span>
                            <div class="how-copy">
                                <strong>@L["Appt_HowBook"]</strong>
                                <p>@L["Appt_HowBookDesc"]</p>
                            </div>
                        </li>
                        <li class="how-step">
                            <span class="how-num" aria-hidden="true">3</span>
                            <div class="how-copy">
                                <strong>@L["Appt_HowEnjoy"]</strong>
                                <p>@L["Appt_HowEnjoyDesc"]</p>
                            </div>
                        </li>
                    </ol>
                </section>
            }
        }
    </div>
    <div class="bottom-nav-clearance" aria-hidden="true"></div>
</div>
