@page
@model WebAppPet.Pages.Behavior.IntakeModel
@using WebAppPet.Models
@{
    ViewData["Title"] = CatalogLocalizer.Loc("Comportamiento canino", "Dog behavior");
    ViewData["LangCompact"] = true;
    ViewData["OnboardBackHref"] = Url.Page("/Care/Services");
}
<div class="onboard onboard-app">
    <partial name="_OnboardTop" />
    <div class="home-body hotel-flow">
        <h1 class="app-page-heading">@CatalogLocalizer.Loc("Comportamiento canino", "Dog behavior")</h1>
        <p class="muted small">@CatalogLocalizer.Loc("Cuéntanos el problema en un solo paso.", "Tell us the problem in one step.")</p>
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }

        @if (Model.Pets.Count == 0)
        {
            <p class="muted">@CatalogLocalizer.Loc("Agrega un perro para continuar.", "Add a dog to continue.")</p>
            <a class="btn btn-primary" asp-page="/Pets/Create" asp-route-returnUrl="@($"/Behavior/Intake?caseId={Model.CaseId}")">@CatalogLocalizer.Loc("Agregar perro", "Add dog")</a>
        }
        else
        {
            <form method="post" enctype="multipart/form-data" class="stack" style="gap:14px" id="behavior-intake-form"
                  data-pet-required="1"
                  data-msg-pet-required="@CatalogLocalizer.Loc("Activa al menos un perro.", "Turn on at least one dog.")"
                  data-msg-problem-required="@CatalogLocalizer.Loc("Indica el problema principal.", "Choose the main problem.")"
                  data-msg-frequency-required="@CatalogLocalizer.Loc("Indica la frecuencia.", "Choose the frequency.")">
                <input type="hidden" asp-for="CaseId" />

                <section class="behavior-pet-section" aria-label="@CatalogLocalizer.Loc("Perros", "Dogs")">
                    <h2 class="section-title">@CatalogLocalizer.Loc("¿Para qué perros?", "Which dogs?")</h2>
                    <p class="muted small" style="margin:-4px 0 10px">@CatalogLocalizer.Loc("Activa uno o varios. Este servicio es solo para perros.", "Turn on one or more. This service is for dogs only.")</p>
                    <div class="behavior-pet-list" role="group" aria-describedby="behavior-pet-error">
                        @foreach (var p in Model.Pets)
                        {
                            var on = Model.SelectedPetIds.Contains(p.Id);
                            <label class="behavior-pet-row @(on ? "is-on" : null)">
                                <span class="care-pet-emoji" aria-hidden="true">@PetSpecies.Emoji(p.Species)</span>
                                <span class="care-pet-copy">
                                    <strong>@p.Name</strong>
                                    <small class="muted">@PetSpecies.Label(p.Species) · @p.Breed</small>
                                </span>
                                <span class="biz-switch">
                                    <input type="checkbox" name="SelectedPetIds" value="@p.Id" @(on ? "checked" : null)
                                           class="behavior-pet-switch" aria-label="@p.Name" />
                                    <span class="biz-switch-track" aria-hidden="true"></span>
                                </span>
                            </label>
                        }
                    </div>
                    <p id="behavior-pet-error" class="field-error" role="alert"
                       @(string.IsNullOrEmpty(Model.ErrorMessage) || Model.SelectedPetIds.Count > 0 ? "hidden" : null)>
                        @(Model.SelectedPetIds.Count == 0 && !string.IsNullOrEmpty(Model.ErrorMessage)
                            ? Model.ErrorMessage
                            : CatalogLocalizer.Loc("Activa al menos un perro.", "Turn on at least one dog."))
                    </p>
                    <p class="muted small" style="margin:10px 0 0">
                        <a asp-page="/Pets/Create" asp-route-returnUrl="@($"/Behavior/Intake?caseId={Model.CaseId}")">+ @CatalogLocalizer.Loc("Agregar otro perro", "Add another dog")</a>
                    </p>
                </section>

                <section>
                    <h2 class="section-title">@CatalogLocalizer.Loc("Problema principal", "Main problem")</h2>
                    <div class="filter-bar filter-bar-wrap">
                        @foreach (var p in IntakeModel.Problems)
                        {
                            <label class="chip @(Model.ProblemType == p ? "active" : null)">
                                <input type="radio" name="ProblemType" value="@p" @(Model.ProblemType == p ? "checked" : null) />
                                @CatalogLocalizer.Text(p)
                            </label>
                        }
                    </div>
                </section>

                <section>
                    <h2 class="section-title">@CatalogLocalizer.Loc("Frecuencia", "Frequency")</h2>
                    <div class="filter-bar filter-bar-wrap">
                        @foreach (var f in IntakeModel.Frequencies)
                        {
                            <label class="chip @(Model.Frequency == f ? "active" : null)">
                                <input type="radio" name="Frequency" value="@f" @(Model.Frequency == f ? "checked" : null) />
                                @CatalogLocalizer.Text(f)
                            </label>
                        }
                    </div>
                </section>

                <section class="behavior-details">
                    <h2 class="section-title">@CatalogLocalizer.Loc("Detalle (opcional)", "Details (optional)")</h2>
                    <textarea class="behavior-notes" asp-for="ContextNotes" rows="4"
                              placeholder="@CatalogLocalizer.Loc("Cuándo pasa, qué lo dispara…", "When it happens, what triggers it…")"></textarea>
                </section>

                <section class="card card-pad" style="padding:12px 14px">
                    <label class="check-row" style="margin:0">
                        <input type="checkbox" asp-for="HasClinicalConcern" />
                        <span>@CatalogLocalizer.Loc("Sospecho causa médica (dolor, convulsiones, agresión súbita).", "I suspect a medical cause (pain, seizures, sudden aggression).")</span>
                    </label>
                    <p class="muted small mb-0" style="margin-top:6px">@CatalogLocalizer.Loc("Si marcas esto, te llevamos a Veterinaria primero.", "If checked, we route you to Veterinary first.")</p>
                </section>

                <button type="submit" class="btn btn-primary btn-block" id="behavior-intake-continue" disabled aria-disabled="true">@L["Common_Continue"]</button>
            </form>
            <script>
            (() => {
              const form = document.getElementById('behavior-intake-form');
              if (!form) return;
              const err = document.getElementById('behavior-pet-error');
              const btn = document.getElementById('behavior-intake-continue');
              const msgPet = form.getAttribute('data-msg-pet-required') || 'Activa al menos un perro.';
              const msgProblem = form.getAttribute('data-msg-problem-required') || 'Indica el problema principal.';
              const msgFrequency = form.getAttribute('data-msg-frequency-required') || 'Indica la frecuencia.';
              const switches = () => [...form.querySelectorAll('.behavior-pet-switch')];
              const anyOn = () => switches().some(s => s.checked);
              const hasProblem = () => !!form.querySelector('input[name="ProblemType"]:checked');
              const hasFrequency = () => !!form.querySelector('input[name="Frequency"]:checked');

              const syncChips = () => {
                form.querySelectorAll('label.chip').forEach(label => {
                  const input = label.querySelector('input[type="radio"]');
                  label.classList.toggle('active', !!(input && input.checked));
                });
              };

              const sync = (showError) => {
                form.querySelectorAll('.behavior-pet-row').forEach(row => {
                  const input = row.querySelector('.behavior-pet-switch');
                  row.classList.toggle('is-on', !!(input && input.checked));
                });
                syncChips();
                const petsOk = anyOn();
                const problemOk = hasProblem();
                const frequencyOk = hasFrequency();
                const ok = petsOk && problemOk && frequencyOk;
                if (btn) {
                  btn.disabled = !ok;
                  btn.setAttribute('aria-disabled', ok ? 'false' : 'true');
                }
                form.classList.toggle('is-pet-missing', !petsOk);
                if (err) {
                  if (petsOk) {
                    err.hidden = true;
                  } else if (showError) {
                    err.textContent = msgPet;
                    err.hidden = false;
                  }
                }
                return { ok, petsOk, problemOk, frequencyOk };
              };

              const toast = (msg) => {
                if (window.ChomblyToast && typeof window.ChomblyToast.show === 'function') {
                  window.ChomblyToast.show(msg, { kind: 'error' });
                }
              };

              switches().forEach(sw => sw.addEventListener('change', () => sync(false)));
              form.addEventListener('change', e => {
                const t = e.target;
                if (t && (t.name === 'ProblemType' || t.name === 'Frequency')) sync(false);
              });

              form.addEventListener('submit', e => {
                const state = sync(true);
                if (!state.ok) {
                  e.preventDefault();
                  e.stopPropagation();
                  if (!state.petsOk) {
                    toast(msgPet);
                    err?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                  } else if (!state.problemOk) {
                    toast(msgProblem);
                    form.querySelector('input[name="ProblemType"]')?.closest('section')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                  } else if (!state.frequencyOk) {
                    toast(msgFrequency);
                    form.querySelector('input[name="Frequency"]')?.closest('section')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                  }
                }
              }, true);

              sync(false);
            })();
            </script>
        }
    </div>
    <div class="bottom-nav-clearance" aria-hidden="true"></div>
</div>
