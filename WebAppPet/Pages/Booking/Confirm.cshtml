@page
@model WebAppPet.Pages.Booking.ConfirmModel
@{
    ViewData["Title"] = CatalogLocalizer.Loc("Confirmación", "Confirmation");
    ViewData["HideNav"] = true;
    ViewData["LangCompact"] = true;
    ViewData["OnboardBackHref"] = Url.Page("/Appointments/Index");
    var a = Model.Appointment;
}

<div class="onboard onboard-app">
    <partial name="_OnboardTop" />
    <div class="home-body no-nav">
        <div class="success-wrap" data-success-celebrate>
            <img src="~/images/booking-success-v2.png" asp-append-version="true" alt="" class="success-illu" />
            <div class="success-check" aria-hidden="true">
                <span class="success-check-mark">✓</span>
            </div>
            <h2 class="success-title">@CatalogLocalizer.Loc("¡Reserva enviada!", "Booking submitted!")</h2>
            <p class="muted success-sub">@CatalogLocalizer.Loc("El negocio confirmará tu solicitud. Te avisaremos por notificación.", "The business will confirm your request. We'll notify you.")</p>
        </div>

        @if (a != null)
        {
            var bizThumb = CatalogImages.Business(a.Groomer.ImageUrl, a.Groomer.Category?.Slug);
            <div class="card card-pad" style="margin-bottom:16px">
                <div class="row" style="display:flex;gap:12px;align-items:center;margin-bottom:12px">
                    <img src="@bizThumb" alt="" class="confirm-biz-thumb" width="64" height="64" />
                    <div>
                        <strong>@a.Groomer.BusinessName</strong>
                        <div class="muted small">@(a.Groomer.Category != null ? a.Groomer.Category.DisplayName() : "") · @a.Groomer.Address</div>
                    </div>
                </div>
                <p><strong>@CatalogLocalizer.Loc("Servicio", "Service"):</strong> @CatalogLocalizer.Text(a.Service.Name)</p>
                @if (a.Nights > 0 && a.EndAt.HasValue)
                {
                    <p><strong>@CatalogLocalizer.Loc("Check-in", "Check-in"):</strong> @a.ScheduledAt.ToString("ddd d MMM yyyy")</p>
                    <p><strong>@CatalogLocalizer.Loc("Check-out", "Check-out"):</strong> @a.EndAt.Value.ToString("ddd d MMM yyyy")</p>
                    <p><strong>@CatalogLocalizer.Loc("Noches", "Nights"):</strong> @a.Nights</p>
                }
                else
                {
                    <p><strong>@CatalogLocalizer.Loc("Fecha", "Date"):</strong> @AppTimeZones.ToAppLocal(a.ScheduledAt).ToString("dddd, MMM d, yyyy · h:mm tt")</p>
                }
                @{
                    var petsLine = CatalogLocalizer.PetsLine(a.Pet, a.Notes);
                }
                <p><strong>@petsLine.Label:</strong> @petsLine.Value</p>
                @if (a.Extras.Any())
                {
                    <p><strong>@CatalogLocalizer.Loc("Extras", "Extras"):</strong> @string.Join(", ", a.Extras.Select(e => CatalogLocalizer.Text(e.Name)))</p>
                }
                @if (a.DiscountAmount > 0 && !string.IsNullOrEmpty(a.PromoCode))
                {
                    <p class="promo-line promo-discount">
                        <strong>@string.Format(L["Promo_DiscountLine"].Value, a.PromoCode)</strong>
                        <span class="price">−@AppMoney.Format(a.DiscountAmount)</span>
                    </p>
                }
                <p><strong>@CatalogLocalizer.Loc("Total del servicio", "Service total"):</strong> <span class="price">@AppMoney.Format(a.TotalPrice)</span></p>
                @if (Model.Payment is { } pay)
                {
                    var balance = Math.Max(0m, pay.ServiceTotal - pay.Amount);
                    <p>
                        <strong>@CatalogLocalizer.Loc("Anticipo pagado", "Deposit paid"):</strong>
                        <span class="price">@AppMoney.FormatCurrency(pay.Amount, pay.Currency)</span>
                        @if (pay.CardLast4 is not null)
                        {
                            <span class="muted small">· @pay.CardBrand •••• @pay.CardLast4</span>
                        }
                    </p>
                    @if (balance > 0)
                    {
                        <p>
                            <strong>@CatalogLocalizer.Loc("Saldo a pagar en el negocio", "Balance due at the business"):</strong>
                            <span class="price">@AppMoney.FormatCurrency(balance, pay.Currency)</span>
                        </p>
                    }
                    <p class="muted small">
                        @CatalogLocalizer.Loc(
                            balance > 0
                                ? $"El saldo lo pagas directamente en {a.Groomer.BusinessName} el día del servicio. Si cancelas o el negocio no acepta, te reembolsamos el anticipo."
                                : "Si cancelas o el negocio no acepta, te reembolsamos el pago completo.",
                            balance > 0
                                ? $"You pay the balance directly at {a.Groomer.BusinessName} on the day of the service. If you cancel or the business declines, your deposit is refunded."
                                : "If you cancel or the business declines, the full payment is refunded.")
                        · @CatalogLocalizer.Loc("Ref:", "Ref:") @pay.ExternalReference
                    </p>
                }
                @if (CatalogLocalizer.HasCustomerNotes(a.Notes))
                {
                    <p><strong>@CatalogLocalizer.Loc("Notas", "Notes"):</strong> @CatalogLocalizer.Notes(a.Notes)</p>
                }
            </div>

            var confirmReturn = Url.Page("/Booking/Confirm", new { id = a.Id });
            <a class="btn btn-outline btn-block" asp-page="/Appointments/Details" asp-route-id="@a.Id" asp-route-returnUrl="@confirmReturn">@CatalogLocalizer.Loc("Ver detalles de la reserva", "View booking details")</a>
            <a class="btn btn-outline btn-block" asp-page="/Chat/Index" asp-route-groomerId="@a.GroomerId" asp-route-appointmentId="@a.Id" asp-route-returnUrl="@confirmReturn" style="margin-top:10px">@CatalogLocalizer.Loc("Enviar mensaje al negocio", "Message the business")</a>
            @if (!string.IsNullOrEmpty(a.Groomer.Address))
            {
                <a class="btn btn-outline btn-block" href="https://maps.google.com/?q=@Uri.EscapeDataString(a.Groomer.Address)" target="_blank" rel="noopener" style="margin-top:10px">@CatalogLocalizer.Loc("Cómo llegar", "Get directions")</a>
            }
            <a class="btn btn-primary btn-block" asp-page="/Appointments/Index" style="margin-top:10px">@CatalogLocalizer.Loc("Ver mis citas", "View my appointments")</a>
        }
    </div>
</div>
