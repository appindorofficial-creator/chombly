@page
@model WebAppPet.Pages.Booking.IndexModel
@using WebAppPet.Pages.Shared
@{
    ViewData["Title"] = Model.Pay
        ? CatalogLocalizer.Loc("Pago", "Checkout")
        : CatalogLocalizer.Loc("Reservar", "Reserve");
    ViewData["HideNav"] = true;
    ViewData["LangCompact"] = true;
    ViewData["BodyClass"] = "page-booking";
    var configureHref = BookingCheckoutUrls.ForPage(ViewContext, pay: false);
    var checkoutHref = BookingCheckoutUrls.ForPage(ViewContext, pay: true);
    ViewData["OnboardBackHref"] = Model.Pay
        ? configureHref
        : Url.Page("/Groomers/Details", new { id = Model.GroomerId, service = Model.Service });
    var HideNav = true;
    var minDate = AppTimeZones.TodayLocalDate().ToString("yyyy-MM-dd");
    var minEndDate = AppTimeZones.TodayLocalDate().AddDays(1).ToString("yyyy-MM-dd");
    var showCheckout = Model.Pay && Model.CanShowSummary;
    var showSticky = !Model.Pay && Model.CanShowSummary;
}
<div class="onboard onboard-app">
    <partial name="_OnboardTop" />
    <div class="home-body hotel-flow booking-flow @(showSticky ? "has-checkout-sticky" : "") @(showCheckout ? "is-checkout" : "") @(HideNav ? "no-nav" : "")">

        @if (showCheckout && Model.Groomer != null && Model.SelectedServices.Count > 0 && Model.SelectedPet != null)
        {
            <h1 class="app-page-heading">@CatalogLocalizer.Loc("Confirmar y pagar", "Confirm and pay")</h1>
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger">@Model.ErrorMessage</div>
            }

            ViewData["PromoCode"] = Model.PromoCode;
            ViewData["PromoSubtotal"] = Model.Subtotal;
            ViewData["PromoDiscount"] = Model.DiscountAmount;
            ViewData["PromoError"] = Model.PromoError;
            var multi = new List<BookingSummaryMultiHidden>
            {
                new() { Name = "PetIds", Values = Model.PetIds.Select(id => id.ToString()) },
                new() { Name = "ServiceIds", Values = Model.ServiceIds.Select(id => id.ToString()) }
            };
            if (Model.SelectedExtraIds.Count > 0)
                multi.Add(new BookingSummaryMultiHidden { Name = "SelectedExtraIds", Values = Model.SelectedExtraIds.Select(id => id.ToString()) });

            var scheduleLine = Model.IsOvernight
                ? $"{Model.Date} → {Model.EndDate}"
                : $"{Model.Date} · {Model.Time}";
            var extrasLabel = Model.SelectedExtras.Count == 0
                ? CatalogLocalizer.Loc("Ninguno", "None")
                : string.Join(", ", Model.SelectedExtras.Select(e => CatalogLocalizer.Text(e.Name)));
            var petSummary = string.Join(", ", Model.SelectedPets.Select(p => $"{PetSpecies.Emoji(p.Species)} {p.Name}"));
            var servicesLabel = Model.SelectedServicesLabel;

            <partial name="_BookingSummarySheet" model="@(new BookingSummarySheetModel
            {
                BodyId = "booking-checkout-body",
                Presentation = BookingCheckoutPresentation.FullPage,
                ExtraClass = "booking-checkout",
                TitleEs = "Pago",
                TitleEn = "Checkout",
                EditHintEs = "Volver a editar la reserva",
                EditHintEn = "Back to edit booking",
                EditHref = configureHref,
                ContinueHref = checkoutHref,
                BusinessName = Model.Groomer.BusinessName,
                ImageUrl = Model.Groomer.ImageUrl,
                FallbackImage = "/images/pet-other.svg",
                Subtitle = servicesLabel,
                Lines =
                [
                    new BookingSummaryLine
                    {
                        LabelEs = Model.SelectedServices.Count == 1 ? "Servicio" : "Servicios",
                        LabelEn = Model.SelectedServices.Count == 1 ? "Service" : "Services",
                        Value = string.IsNullOrEmpty(servicesLabel) ? "—" : servicesLabel
                    },
                    new BookingSummaryLine
                    {
                        LabelEs = Model.IsOvernight ? "Fechas" : "Fecha",
                        LabelEn = Model.IsOvernight ? "Dates" : "Date",
                        Value = scheduleLine
                    },
                    new BookingSummaryLine
                    {
                        LabelEs = Model.SelectedPets.Count == 1 ? "Mascota" : "Mascotas",
                        LabelEn = Model.SelectedPets.Count == 1 ? "Pet" : "Pets",
                        Value = string.IsNullOrEmpty(petSummary) ? "—" : petSummary
                    },
                    new BookingSummaryLine { LabelEs = "Extras", LabelEn = "Extras", Value = extrasLabel }
                ],
                CustomerNotes = Model.Notes,
                TotalLabelEs = "Total estimado",
                TotalLabelEn = "Estimated total",
                Estimate = Model.EstimatedTotal,
                DefaultPayment = Model.DefaultPayment,
                AcceptTerms = Model.AcceptTerms,
                SubmitLabelEs = "Confirmar y pagar anticipo",
                SubmitLabelEn = "Confirm and pay deposit",
                ShowSecureLockOnSubmit = true,
                ShowSecureFooter = true,
                HiddenFields =
                [
                    new BookingSummaryHidden { Name = "GroomerId", Value = Model.GroomerId.ToString() },
                    new BookingSummaryHidden { Name = "ServiceId", Value = Model.ServiceId.ToString() },
                    new BookingSummaryHidden { Name = "Service", Value = Model.Service },
                    new BookingSummaryHidden { Name = "PetId", Value = Model.PetId.ToString() },
                    new BookingSummaryHidden { Name = "Date", Value = Model.Date },
                    new BookingSummaryHidden { Name = "EndDate", Value = Model.EndDate },
                    new BookingSummaryHidden { Name = "Time", Value = Model.Time },
                    new BookingSummaryHidden { Name = "Notes", Value = Model.Notes },
                    new BookingSummaryHidden { Name = "PaymentMethodId", Value = Model.PaymentMethodId?.ToString() }
                ],
                MultiHiddenFields = multi
            })" />
        }
        else
        {
        <h1 class="app-page-heading">@CatalogLocalizer.Loc("Reserva", "Booking")</h1>
        @if (Model.Groomer != null)
        {
            <div class="card card-pad" style="margin-bottom:14px;display:flex;gap:12px;align-items:center">
                <img src="@(Model.Groomer.ImageUrl ?? "/images/pet-other.svg")" alt="" style="width:56px;height:56px;border-radius:12px;object-fit:cover" />
                <div>
                    <strong>@Model.Groomer.BusinessName</strong>
                    <div class="muted small">
                        @(Model.Groomer.Category?.Emoji) @CatalogLocalizer.Text(Model.Groomer.Category?.Name ?? "Servicio")
                    </div>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }

        <form method="get" id="booking-filter-form">
            <input type="hidden" name="groomerId" value="@Model.GroomerId" />
            @if (!string.IsNullOrWhiteSpace(Model.Service))
            {
                <input type="hidden" name="service" value="@Model.Service" />
            }

            @if (Model.ServiceLocked && Model.SelectedService != null)
            {
                <input type="hidden" name="ServiceIds" value="@Model.ServiceId" />
                <input type="hidden" name="serviceId" value="@Model.ServiceId" />
                <h3 class="section-title" style="margin-top:0">@CatalogLocalizer.Loc("1. Servicio", "1. Service")</h3>
                <div class="card card-pad" style="margin-bottom:12px;display:flex;justify-content:space-between;align-items:center;gap:10px">
                    <div>
                        <strong>@CatalogLocalizer.Text(Model.SelectedService.Name)</strong>
                        @if (!string.IsNullOrWhiteSpace(Model.SelectedService.Description))
                        {
                            <div class="muted small">@CatalogLocalizer.Text(Model.SelectedService.Description)</div>
                        }
                    </div>
                    <span class="price">@L["Home_FromPrice"] @AppMoney.Format(Model.SelectedService.PriceSmall)</span>
                </div>
            }
            else
            {
                <h3 class="section-title" style="margin-top:0">@CatalogLocalizer.Loc("1. Elige los servicios", "1. Choose services")</h3>
                @if (!Model.Services.Any())
                {
                    <div class="empty">@CatalogLocalizer.Loc("Este negocio aún no tiene servicios en la base de datos.", "This business has no services in the database yet.")</div>
                }
                else
                {
                    <p class="muted small" style="margin-top:-6px;margin-bottom:10px">
                        @CatalogLocalizer.Loc("Activa uno o varios.", "Turn on one or more.")
                        @if (Model.SelectedServices.Count > 0)
                        {
                            <span>· @Model.SelectedServices.Count @(Model.SelectedServices.Count == 1
                                ? CatalogLocalizer.Loc("seleccionado", "selected")
                                : CatalogLocalizer.Loc("seleccionados", "selected"))</span>
                        }
                    </p>
                }
                @foreach (var s in Model.Services)
                {
                    var on = Model.ServiceIds.Contains(s.Id);
                    <label class="radio-card">
                        <input type="checkbox" name="ServiceIds" value="@s.Id" @(on ? "checked" : null) />
                        <div class="inner">
                            <div>
                                <strong>@CatalogLocalizer.Text(s.Name)</strong>
                                <div class="muted small">@CatalogLocalizer.Text(s.Description)</div>
                            </div>
                            <span class="price">@L["Home_FromPrice"] @AppMoney.Format(s.PriceSmall)</span>
                        </div>
                    </label>
                }
            }

            @if (Model.IsOvernight)
            {
                <h3 class="section-title">@CatalogLocalizer.Loc("2. Check-in y check-out", "2. Check-in and check-out")</h3>
                <div class="form-group">
                    <label>@L["Book_CheckIn"]</label>
                    <input class="form-control" type="date" name="date" value="@Model.Date" min="@minDate" required data-booking-start />
                </div>
                <div class="form-group">
                    <label>@L["Book_CheckOut"]</label>
                    <input class="form-control" type="date" name="endDate" value="@Model.EndDate" min="@minEndDate" required data-booking-end />
                </div>
            }
            else
            {
                <h3 class="section-title">@CatalogLocalizer.Loc("2. Fecha y hora", "2. Date and time")</h3>
                <div class="form-group">
                    <label>@CatalogLocalizer.Loc("Fecha", "Date")</label>
                    <input class="form-control" type="date" name="date" value="@Model.Date" min="@minDate" required />
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.HoursLabel))
                {
                    <p class="muted small" style="margin:-4px 0 10px">
                        @CatalogLocalizer.Loc("Horario del día:", "Hours that day:") @Model.HoursLabel
                    </p>
                }
                <div class="form-group">
                    <label>@CatalogLocalizer.Loc("Hora", "Time")</label>
                    @if (!Model.DayIsOpen)
                    {
                        <p class="field-error" role="alert">@CatalogLocalizer.Loc("Cerrado ese día. Elige otra fecha.", "Closed that day. Choose another date.")</p>
                    }
                    else if (Model.BookableTimeSlots.Count == 0)
                    {
                        <p class="field-error" role="alert">@CatalogLocalizer.Loc("No quedan horarios disponibles para ese día. Elige otra fecha.", "No times left for that day. Choose another date.")</p>
                    }
                    else
                    {
                        var slotModel = new BookingTimeSlotsModel
                        {
                            Slots = Model.TimeSlots,
                            Selected = Model.Time,
                            PastSlots = Model.PastSlots,
                            OccupiedSlots = Model.OccupiedSlots,
                            OutsideHoursSlots = Model.OutsideHoursSlots,
                            InputName = "time"
                        };
                        <partial name="_BookingTimeSlots" model="slotModel" />
                    }
                </div>
            }

            @if (Model.Extras.Any())
            {
                <h3 class="section-title">@CatalogLocalizer.Loc("3. Extras", "3. Extras") <span class="muted small">@CatalogLocalizer.Loc("(opcional)", "(optional)")</span></h3>
                @foreach (var e in Model.Extras)
                {
                    <label class="toggle-row" style="cursor:pointer">
                        <span>@CatalogLocalizer.Text(e.Name) <span class="price">+@AppMoney.Format(e.Price)</span></span>
                        <input type="checkbox" name="SelectedExtraIds" value="@e.Id"
                               @(Model.SelectedExtraIds.Contains(e.Id) ? "checked" : "") />
                    </label>
                }
            }

            @{
                var petStep = Model.Extras.Any() ? 4 : 3;
                var notesStep = petStep + 1;
            }
            <h3 class="section-title">@CatalogLocalizer.Loc($"{petStep}. ¿Para qué mascotas?", $"{petStep}. Which pets?")</h3>
            @if (Model.Groomer != null)
            {
                <p class="muted small" style="margin-top:-6px">@CatalogLocalizer.Loc("Atiende:", "Serves:")
                    @string.Join(" · ", Model.Groomer.AcceptedSpeciesList.Select(s => $"{PetSpecies.Emoji(s)} {PetSpecies.Label(s)}"))
                </p>
            }
            @if (!Model.Pets.Any())
            {
                <div class="alert alert-info">@CatalogLocalizer.Loc("Primero agrega una mascota.", "Add a pet first.")
                    <a asp-page="/Pets/Create" asp-route-returnUrl="@Model.BookingReturnPath" style="color:var(--brand);font-weight:700">@CatalogLocalizer.Loc("Agregar mascota", "Add pet")</a>
                </div>
            }
            else
            {
                <p class="muted small" style="margin:-2px 0 10px">
                    @CatalogLocalizer.Loc("Activa una o varias (máx. 6).", "Turn on one or more (max 6).")
                    @if (Model.SelectedPets.Count > 0)
                    {
                        <span>· @Model.SelectedPets.Count @(Model.SelectedPets.Count == 1
                            ? CatalogLocalizer.Loc("seleccionada", "selected")
                            : CatalogLocalizer.Loc("seleccionadas", "selected"))</span>
                    }
                </p>
                <div class="behavior-pet-list hotel-pet-list" role="group" aria-label="@CatalogLocalizer.Loc("Mascotas", "Pets")">
                    @foreach (var p in Model.Pets)
                    {
                        var accepted = Model.Groomer == null || Model.Groomer.AcceptsSpecies(p.Species);
                        var on = Model.PetIds.Contains(p.Id);
                        <label class="behavior-pet-row @(on ? "is-on" : null) @(!accepted ? "is-disabled" : null)">
                            <span class="care-pet-emoji" aria-hidden="true">@PetSpecies.Emoji(p.Species)</span>
                            <span class="care-pet-copy">
                                <strong>@p.Name</strong>
                                <small class="muted">
                                    @PetSpecies.Label(p.Species)@(!string.IsNullOrWhiteSpace(p.Breed) ? $" · {p.Breed}" : "")
                                    @if (!accepted)
                                    {
                                        <span> · @CatalogLocalizer.Loc("no atendida aquí", "not served here")</span>
                                    }
                                </small>
                            </span>
                            <span class="biz-switch">
                                <input type="checkbox" name="PetIds" value="@p.Id"
                                       @(on ? "checked" : null)
                                       @(!accepted || (Model.SelectedPets.Count >= 6 && !on) ? "disabled" : null)
                                       aria-label="@p.Name" />
                                <span class="biz-switch-track" aria-hidden="true"></span>
                            </span>
                        </label>
                    }
                </div>
                <a class="apple-text-link" asp-page="/Pets/Create" asp-route-returnUrl="@Model.BookingReturnPath" style="display:inline-block;margin:8px 0 4px">
                    @CatalogLocalizer.Loc("+ Agregar otra mascota", "+ Add another pet")
                </a>
                @if (Model.PetId > 0)
                {
                    <input type="hidden" name="PetId" value="@Model.PetId" />
                }
            }

            <h3 class="section-title">@CatalogLocalizer.Loc($"{notesStep}. Notas", $"{notesStep}. Notes") <span class="muted small">@CatalogLocalizer.Loc("(opcional)", "(optional)")</span></h3>
            <div class="form-group">
                <textarea class="form-control" name="Notes" rows="3" maxlength="200"
                          placeholder="@CatalogLocalizer.Loc("¿Hay algo que debamos saber?", "Is there anything we should know?")">@Model.Notes</textarea>
            </div>
            @* Soft-nav: swap only summary/sticky after this marker; keep the configure fields mounted. *@
            <div id="booking-results" hidden aria-hidden="true"></div>
        </form>

        @if (!Model.CanShowSummary)
        {
            <p class="muted small center" style="margin:16px 0 8px">
                @CatalogLocalizer.Loc(
                    "Completa servicio, agenda y mascota(s) para ver el resumen.",
                    "Complete service, schedule, and pet(s) to see the summary.")
            </p>
        }

        <partial name="_TrustBanner" />

            @if (showSticky && Model.Groomer != null && Model.SelectedServices.Count > 0 && Model.SelectedPet != null)
            {
                <partial name="_BookingSummarySheet" model="@(new BookingSummarySheetModel
                {
                    BodyId = "booking-sticky",
                    Presentation = BookingCheckoutPresentation.StickyContinue,
                    ExtraClass = "booking-checkout-sticky",
                    TitleEs = "Resumen",
                    TitleEn = "Summary",
                    EditHintEs = "",
                    EditHintEn = "",
                    ContinueHref = checkoutHref,
                    BusinessName = Model.Groomer.BusinessName,
                    ImageUrl = Model.Groomer.ImageUrl,
                    FallbackImage = "/images/pet-other.svg",
                    Subtitle = Model.SelectedServicesLabel,
                    Estimate = Model.EstimatedTotal,
                    DefaultPayment = Model.DefaultPayment,
                    AcceptTerms = Model.AcceptTerms,
                    SubmitLabelEs = "Confirmar",
                    SubmitLabelEn = "Confirm"
                })" />
            }
        }
    </div>
    @if (!HideNav) { <div class="bottom-nav-clearance" aria-hidden="true"></div> }
</div>

@if (Model.IsOvernight)
{
    <script>
        (function () {
            var start = document.querySelector('[data-booking-start]');
            var end = document.querySelector('[data-booking-end]');
            if (!start || !end) return;
            function syncEndMin() {
                if (!start.value) return;
                var d = new Date(start.value + 'T00:00:00');
                d.setDate(d.getDate() + 1);
                var yyyy = d.getFullYear();
                var mm = String(d.getMonth() + 1).padStart(2, '0');
                var dd = String(d.getDate()).padStart(2, '0');
                var min = yyyy + '-' + mm + '-' + dd;
                var floor = end.getAttribute('data-floor-min') || end.min;
                if (floor && min < floor) min = floor;
                end.min = min;
                if (end.value && end.value < min) end.value = min;
            }
            end.setAttribute('data-floor-min', end.min || '');
            start.addEventListener('change', syncEndMin);
            syncEndMin();
        })();
    </script>
}
