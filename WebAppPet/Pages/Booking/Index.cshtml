@page
@model WebAppPet.Pages.Booking.IndexModel
@{
    ViewData["Title"] = CatalogLocalizer.Loc("Reservar", "Book");
    ViewData["HideNav"] = true;
    ViewData["LangCompact"] = true;
    ViewData["OnboardBackHref"] = Url.Page("/Groomers/Details", new { id = Model.GroomerId, service = Model.Service });
    var HideNav = true;
    var minDate = AppTimeZones.TodayLocalDate().ToString("yyyy-MM-dd");
    var minEndDate = AppTimeZones.TodayLocalDate().AddDays(1).ToString("yyyy-MM-dd");
}
<div class="onboard onboard-app">
    <partial name="_OnboardTop" />
    <div class="home-body @(HideNav ? "no-nav" : "")">
    <h1 class="app-page-heading">@CatalogLocalizer.Loc("Reserva", "Booking")</h1>
    @if (Model.Groomer != null)
    {
        <div class="card card-pad" style="margin-bottom:14px;display:flex;gap:12px;align-items:center">
            <img src="@(Model.Groomer.ImageUrl ?? "/images/pet-other.svg")" alt="" style="width:56px;height:56px;border-radius:12px;object-fit:cover" />
            <div>
                <strong>@Model.Groomer.BusinessName</strong>
                <div class="muted small">
                    @(Model.Groomer.Category?.Emoji) @CatalogLocalizer.Text(Model.Groomer.Category?.Name ?? "Servicio")
                </div>
            </div>
        </div>
    }

    <div class="booking-steps">
        <span class="@(Model.Step >= 1 ? "on" : "")">1</span>
        <span class="@(Model.Step >= 2 ? "on" : "")">2</span>
        <span class="@(Model.Step >= 3 ? "on" : "")">3</span>
        <span class="@(Model.Step >= 4 ? "on" : "")">4</span>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    <form method="post">
        <input type="hidden" asp-for="GroomerId" />
        <input type="hidden" asp-for="Step" />
        <input type="hidden" asp-for="Service" />
        @* Persist wizard state only when the current step is not editing that field.
           Hidden + radio/checkbox with the same name posts both values; model binding
           takes the first (hidden), so ServiceId/PetId stayed 0 and blocked Continuar. *@
        @if (Model.Step != 1)
        {
            <input type="hidden" asp-for="ServiceId" />
        }
        @if (Model.Step != 3)
        {
            <input type="hidden" asp-for="PetId" />
            <input type="hidden" asp-for="Notes" />
        }
        @if (Model.Step != 2)
        {
            <input type="hidden" asp-for="Date" />
            <input type="hidden" asp-for="EndDate" />
            <input type="hidden" asp-for="Time" />
            @foreach (var id in Model.SelectedExtraIds)
            {
                <input type="hidden" name="SelectedExtraIds" value="@id" />
            }
        }
        else
        {
            @* Step 2 only edits a subset of schedule fields depending on overnight vs day service. *@
            @if (Model.IsOvernight)
            {
                <input type="hidden" asp-for="Time" />
            }
            else
            {
                <input type="hidden" asp-for="EndDate" />
            }
        }
        @if (Model.Step != 4)
        {
            <input type="hidden" asp-for="PromoCode" />
        }

        @if (Model.Step == 1)
        {
            <h3 class="section-title" style="margin-top:0">@L["Book_SelectService"]</h3>
            @if (!Model.Services.Any())
            {
                <div class="empty">@CatalogLocalizer.Loc("Este negocio aún no tiene servicios en la base de datos.", "This business has no services in the database yet.")</div>
            }
            @foreach (var s in Model.Services)
            {
                <label class="radio-card">
                    <input type="radio" name="ServiceId" value="@s.Id" required @(Model.ServiceId == s.Id ? "checked" : "") />
                    <div class="inner">
                        <div>
                            <strong>@CatalogLocalizer.Text(s.Name)</strong>
                            <div class="muted small">@CatalogLocalizer.Text(s.Description)</div>
                        </div>
                        <span class="price">@L["Home_FromPrice"] $@s.PriceSmall.ToString("0")</span>
                    </div>
                </label>
            }
            <button class="btn btn-primary btn-block" type="submit" name="handler" value="Next" @(Model.Services.Any() ? null : "disabled")>@CatalogLocalizer.Loc("Continuar", "Continue")</button>
        }
        else if (Model.Step == 2)
        {
            @if (Model.IsOvernight)
            {
                <h3 class="section-title" style="margin-top:0">@CatalogLocalizer.Loc("Check-in y check-out", "Check-in and check-out")</h3>
                <div class="form-group">
                    <label>@L["Book_CheckIn"]</label>
                    <input class="form-control" type="date" name="Date" value="@Model.Date" min="@minDate" required data-booking-start />
                </div>
                <div class="form-group">
                    <label>@L["Book_CheckOut"]</label>
                    <input class="form-control" type="date" name="EndDate" value="@Model.EndDate" min="@minEndDate" required data-booking-end />
                </div>
            }
            else
            {
                <h3 class="section-title" style="margin-top:0">@CatalogLocalizer.Loc("Fecha y hora", "Date and time")</h3>
                <div class="form-group">
                    <label>@CatalogLocalizer.Loc("Fecha", "Date")</label>
                    <input class="form-control" type="date" name="Date" value="@Model.Date" min="@minDate" required
                           data-booking-day
                           onchange="var b=document.getElementById('booking-refresh-schedule'); if(b) b.click();" />
                </div>
                <div class="form-group">
                    <label>@CatalogLocalizer.Loc("Hora", "Time")</label>
                    @{
                        var slots = Model.AvailableTimeSlots;
                        var selectedTime = slots.Contains(Model.Time, StringComparer.OrdinalIgnoreCase) ? Model.Time : (slots.FirstOrDefault() ?? "");
                    }
                    @if (slots.Count == 0)
                    {
                        <p class="field-error" role="alert">@CatalogLocalizer.Loc("No quedan horarios disponibles para ese día. Elige otra fecha.", "No times left for that day. Choose another date.")</p>
                    }
                    else
                    {
                        <div class="slot-grid" data-booking-slots>
                            @foreach (var t in slots)
                            {
                                <label data-slot-label="@t">
                                    <input type="radio" name="Time" value="@t" required
                                           @(string.Equals(selectedTime, t, StringComparison.OrdinalIgnoreCase) ? "checked" : "") />
                                    <div class="slot">@t</div>
                                </label>
                            }
                        </div>
                    }
                </div>
                <button type="submit" name="handler" value="RefreshSchedule" id="booking-refresh-schedule" formnovalidate hidden tabindex="-1" aria-hidden="true"></button>
            }

            @if (Model.Extras.Any())
            {
                <h3 class="section-title">@CatalogLocalizer.Loc("Extras", "Extras")</h3>
                @foreach (var e in Model.Extras)
                {
                    <label class="toggle-row" style="cursor:pointer">
                        <span>@CatalogLocalizer.Text(e.Name) <span class="price">+$@e.Price.ToString("0")</span></span>
                        <input type="checkbox" name="SelectedExtraIds" value="@e.Id"
                               @(Model.SelectedExtraIds.Contains(e.Id) ? "checked" : "") />
                    </label>
                }
            }

            <div style="display:flex;gap:10px;margin-top:14px">
                <button class="btn btn-outline btn-block" type="submit" name="handler" value="Back">@CatalogLocalizer.Loc("Atrás", "Back")</button>
                <button class="btn btn-primary btn-block" type="submit" name="handler" value="Next">@CatalogLocalizer.Loc("Continuar", "Continue")</button>
            </div>
        }
        else if (Model.Step == 3)
        {
            <h3 class="section-title" style="margin-top:0">@CatalogLocalizer.Loc("¿Para qué mascota?", "Which pet?")</h3>
            @if (Model.Groomer != null)
            {
                <p class="muted small" style="margin-top:-6px">@CatalogLocalizer.Loc("Atiende:", "Serves:")
                    @string.Join(" · ", Model.Groomer.AcceptedSpeciesList.Select(s => $"{PetSpecies.Emoji(s)} {PetSpecies.Label(s)}"))
                </p>
            }
            @if (!Model.Pets.Any())
            {
                <div class="alert alert-info">@CatalogLocalizer.Loc("Primero agrega una mascota.", "Add a pet first.")
                    <a asp-page="/Pets/Create" style="color:var(--brand);font-weight:700">@CatalogLocalizer.Loc("Agregar mascota", "Add pet")</a>
                </div>
            }
            @foreach (var p in Model.Pets)
            {
                var ok = Model.Groomer?.AcceptsSpecies(p.Species) != false;
                <label class="radio-card @(ok ? "" : "disabled")">
                    <input type="radio" name="PetId" value="@p.Id" @(ok ? "required" : "disabled") @(Model.PetId == p.Id && ok ? "checked" : "") />
                    <div class="inner">
                        <div class="pet-select" style="border:none;padding:0;flex:1">
                            <img src="@PetSpecies.PhotoOrDefault(p.PhotoUrl, p.Species)" alt="@p.Name" />
                            <div>
                                <strong>@PetSpecies.Emoji(p.Species) @p.Name</strong>
                                <div class="muted small">@PetSpecies.Label(p.Species) · @p.Breed · @p.AgeYears @CatalogLocalizer.Loc("años", "years")</div>
                                @if (!ok)
                                {
                                    <div class="field-error">@CatalogLocalizer.Loc($"No atienden {PetSpecies.Label(p.Species)}", $"They don't serve {PetSpecies.Label(p.Species)}")</div>
                                }
                            </div>
                        </div>
                    </div>
                </label>
            }
            <div class="form-group">
                <label>@CatalogLocalizer.Loc("Notas", "Notes")</label>
                <textarea class="form-control" name="Notes" rows="3">@Model.Notes</textarea>
            </div>
            <div style="display:flex;gap:10px">
                <button class="btn btn-outline btn-block" type="submit" name="handler" value="Back">@CatalogLocalizer.Loc("Atrás", "Back")</button>
                <button class="btn btn-primary btn-block" type="submit" name="handler" value="Next" @(Model.Pets.Any() ? null : "disabled")>@CatalogLocalizer.Loc("Continuar", "Continue")</button>
            </div>
        }
        else if (Model.Step == 4)
        {
            ViewData["PromoCode"] = Model.PromoCode;
            ViewData["PromoSubtotal"] = Model.Subtotal;
            ViewData["PromoDiscount"] = Model.DiscountAmount;
            ViewData["PromoError"] = Model.PromoError;
            ViewData["PromoApplyHandler"] = "ApplyPromo";
            <h3 class="section-title" style="margin-top:0">@L["Book_ConfirmTitle"]</h3>
            <div class="card card-pad">
                <p><strong>@CatalogLocalizer.Loc("Servicio:", "Service:")</strong> @CatalogLocalizer.Text(Model.SelectedService?.Name)</p>
                @if (Model.IsOvernight)
                {
                    <p><strong>@L["Book_CheckIn"]:</strong> @Model.Date</p>
                    <p><strong>@L["Book_CheckOut"]:</strong> @Model.EndDate</p>
                    <p><strong>@CatalogLocalizer.Loc("Noches:", "Nights:")</strong> @Model.Nights</p>
                }
                else
                {
                    <p><strong>@CatalogLocalizer.Loc("Fecha:", "Date:")</strong> @Model.Date · @Model.Time</p>
                }
                <p><strong>@CatalogLocalizer.Loc("Mascota:", "Pet:")</strong> @PetSpecies.Emoji(Model.SelectedPet?.Species) @Model.SelectedPet?.Name</p>
                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <p><strong>@CatalogLocalizer.Loc("Notas:", "Notes:")</strong> @Model.Notes</p>
                }
                @if (Model.SelectedExtras.Any())
                {
                    <p><strong>@CatalogLocalizer.Loc("Extras:", "Extras:")</strong></p>
                    <ul style="margin:0 0 8px;padding-left:18px">
                        @foreach (var e in Model.SelectedExtras)
                        {
                            <li>@CatalogLocalizer.Text(e.Name) (+$@e.Price.ToString("0.00"))</li>
                        }
                    </ul>
                }
            </div>

            <partial name="_PromoCode" />

            <div class="card card-pad" style="margin-top:12px">
                @if (Model.DiscountAmount > 0)
                {
                    <p class="muted small" style="margin:0 0 4px">
                        <span style="text-decoration:line-through">$@Model.Subtotal.ToString("0.00")</span>
                    </p>
                }
                <p style="margin:0"><strong>@CatalogLocalizer.Loc("Total:", "Total:")</strong> <span class="price">$@Model.EstimatedTotal.ToString("0.00")</span></p>
                <p class="muted small">@CatalogLocalizer.Loc("Anticipo estimado:", "Estimated deposit:") $@Model.Deposit.ToString("0.00")</p>
            </div>
            <div style="display:flex;gap:10px;margin-top:14px">
                <button class="btn btn-outline btn-block" type="submit" name="handler" value="Back">@CatalogLocalizer.Loc("Atrás", "Back")</button>
                <button class="btn btn-primary btn-block" type="submit" name="handler" value="Confirm">@CatalogLocalizer.Loc("Enviar reserva", "Submit booking")</button>
            </div>
        }
    </form>
    </div>
    @if (!HideNav) { <div class="bottom-nav-clearance" aria-hidden="true"></div> }
</div>
@if (Model.Step == 2 && Model.IsOvernight)
{
    <script>
        (function () {
            var start = document.querySelector('[data-booking-start]');
            var end = document.querySelector('[data-booking-end]');
            if (!start || !end) return;
            function syncEndMin() {
                if (!start.value) return;
                var d = new Date(start.value + 'T00:00:00');
                d.setDate(d.getDate() + 1);
                var yyyy = d.getFullYear();
                var mm = String(d.getMonth() + 1).padStart(2, '0');
                var dd = String(d.getDate()).padStart(2, '0');
                var min = yyyy + '-' + mm + '-' + dd;
                var floor = end.getAttribute('data-floor-min') || end.min;
                if (floor && min < floor) min = floor;
                end.min = min;
                if (end.value && end.value < min) end.value = min;
            }
            end.setAttribute('data-floor-min', end.min || '');
            start.addEventListener('change', syncEndMin);
            syncEndMin();
        })();
    </script>
}
