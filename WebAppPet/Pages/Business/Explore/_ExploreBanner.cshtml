<div class="biz-explore-banner" role="status">
    <p class="biz-explore-banner-title">@L["BizExplore_BannerTitle"]</p>
    <p class="biz-explore-banner-sub">@L["BizExplore_BannerSub"]</p>
    <div class="biz-explore-banner-actions">
        <a class="btn btn-enter btn-block btn-sm" asp-page="/Account/RegisterBusiness">@L["Onboard_EnterBiz"]</a>
        <a class="onboard-secondary" asp-page="./Exit">@L["Home_ExitWelcome"]</a>
    </div>
</div>
