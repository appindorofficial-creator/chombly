@page
@model WebAppPet.Pages.Care.ServicesModel
@{
    ViewData["Title"] = CatalogLocalizer.Loc("¿Qué ayuda necesitas?", "What help do you need?");
    ViewData["LangCompact"] = true;
    ViewData["OnboardBackHref"] = Url.Page("/Index");
}
<div class="onboard onboard-app">
    <partial name="_OnboardTop" />
    <div class="home-body hotel-flow">
        <h1 class="app-page-heading">@CatalogLocalizer.Loc("¿Qué ayuda necesitas?", "What help do you need?")</h1>
        <p class="muted small">@CatalogLocalizer.Loc("Veterinaria y comportamiento son servicios distintos", "Veterinary and behavior are separate services")</p>
    <div class="card card-pad care-hero" style="margin-bottom:16px">
        <strong>@CatalogLocalizer.Loc("El cuidado de tu mascota, organizado", "Your pet's care, organized")</strong>
        <p class="muted small mb-0">@CatalogLocalizer.Loc("Elige el servicio correcto. Comportamiento y Care no sustituyen una emergencia.", "Pick the right service. Behavior and Care do not replace an emergency.")</p>
    </div>

    <div class="vet-modality-grid">
        <a class="vet-modality-card vet-modality-btn" asp-page="/Vet/Index">
            <span class="vet-modality-icon" aria-hidden="true">🩺</span>
            <strong>@CatalogLocalizer.Loc("Consulta veterinaria", "Veterinary care")</strong>
            <span class="muted small">@CatalogLocalizer.Loc("Virtual, clínica o emergencia", "Virtual, clinic, or emergency")</span>
        </a>

        <a class="vet-modality-card vet-modality-btn" asp-page="/Vet/International/Home">
            <span class="vet-modality-icon" aria-hidden="true">🌍</span>
            <strong>@CatalogLocalizer.Loc("Veterinario como en casa", "Vet like at home")</strong>
            <span class="muted small">@CatalogLocalizer.Loc("País, raza e idioma · $30 o Care", "Country, breed & language · $30 or Care")</span>
        </a>

        <a class="vet-modality-card vet-modality-btn" asp-page="/Plans/ChomblyCare">
            <span class="vet-modality-icon" aria-hidden="true">💚</span>
            <strong>Chombly Care</strong>
            <span class="muted small">@CatalogLocalizer.Loc("Plan de orientación y bienestar $14.99/mes — no es seguro", "Guidance & wellness $14.99/mo — not insurance")</span>
        </a>

        <form method="post" asp-page-handler="StartBehavior" class="vet-modality-card">
            <button type="submit" class="vet-modality-btn">
                <span class="vet-modality-icon" aria-hidden="true">🧠</span>
                <strong>@CatalogLocalizer.Loc("Comportamiento canino", "Dog behavior")</strong>
                <span class="muted small">@CatalogLocalizer.Loc("Adicional · evaluación y plan educativo · $55", "Extra · evaluation & educational plan · $55")</span>
            </button>
        </form>
    </div>
    <p class="muted small" style="margin-top:16px">
        @CatalogLocalizer.Loc(
            "El plan de conducta no sustituye atención veterinaria ni diagnostica enfermedades.",
            "A behavior plan does not replace veterinary care or diagnose medical conditions.")
    </p>
    </div>
    <div class="bottom-nav-clearance" aria-hidden="true"></div>
</div>
