@page
@model WebAppPet.Pages.Daycare.IndexModel
@{
    ViewData["Title"] = L["Daycare_Title"].Value;
    ViewData["LangCompact"] = true;
    ViewData["OnboardBackHref"] = Url.Page("/Index");
    var minDate = AppTimeZones.TodayLocalDate().ToString("yyyy-MM-dd");
}
<div class="onboard onboard-app">
    <partial name="_OnboardTop" />
    <div class="home-body hotel-flow @(Model.GroomerId.HasValue ? "has-summary" : "")@(!string.IsNullOrEmpty(Model.ErrorMessage) && Model.GroomerId.HasValue ? " is-summary-collapsed" : "")">
        <h1 class="app-page-heading">@L["Daycare_Title"]</h1>
        <p class="muted small">@L["Book_AllInOne"]</p>
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    <form method="get" id="daycare-filter-form">
        <input type="hidden" name="groomerId" value="@(Model.CanSelectDaycare ? Model.GroomerId : null)" />
        <input type="hidden" name="More" value="@(Model.More ? "true" : "false")" />

        <h3 class="section-title" style="margin-top:0">@CatalogLocalizer.Loc("1. ¿Qué fecha necesitas?", "1. What date do you need?")</h3>
        <partial name="_BookingDateField" model="new BookingDateFieldModel { Date = Model.Date, MinDate = minDate }" />

        <h3 class="section-title">@CatalogLocalizer.Loc("2. Horario", "2. Schedule")</h3>
        <div class="filter-bar" style="flex-direction:column;align-items:stretch">
            @foreach (var s in WebAppPet.Pages.Daycare.IndexModel.ScheduleOptions)
            {
                var on = Model.Schedule == s.Key;
                <label class="radio-card" style="margin-bottom:8px">
                    <input type="radio" name="Schedule" value="@s.Key" @(on ? "checked" : "") />
                    <div class="inner">
                        <strong>@CatalogLocalizer.Text(s.Label)</strong>
                        <div class="muted small">@CatalogLocalizer.Text(s.Hint)</div>
                    </div>
                </label>
            }
        </div>
        <p class="muted small" style="margin-top:-4px">@CatalogLocalizer.Loc("Horario típico del negocio: 7:00 AM – 7:00 PM", "Typical business hours: 7:00 AM – 7:00 PM")</p>
        @if (Model.Schedule == "personalizado")
        {
            <div class="form-row" style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px">
                <div class="form-group" style="margin:0">
                    <label class="small muted">@CatalogLocalizer.Loc("Entrada", "Drop-off")</label>
                    <input class="form-control" type="time" name="CustomStart" value="@Model.CustomStart" />
                </div>
                <div class="form-group" style="margin:0">
                    <label class="small muted">@CatalogLocalizer.Loc("Salida", "Pick-up")</label>
                    <input class="form-control" type="time" name="CustomEnd" value="@Model.CustomEnd" />
                </div>
            </div>
        }
        else
        {
            <input type="hidden" name="CustomStart" value="@Model.CustomStart" />
            <input type="hidden" name="CustomEnd" value="@Model.CustomEnd" />
        }

        <h3 class="section-title">@CatalogLocalizer.Loc("3. Selecciona tu mascota", "3. Select your pet")</h3>
        <partial name="_BookingPetPicker" model="new BookingPetPickerModel { Pets = Model.Pets, PetId = Model.PetId }" />

        <h3 class="section-title">@CatalogLocalizer.Loc("4. Preferencias", "4. Preferences") <span class="muted small">@CatalogLocalizer.Loc("(opcional)", "(optional)")</span></h3>
        <div class="filter-bar">
            @foreach (var pref in WebAppPet.Pages.Daycare.IndexModel.PrefOptions)
            {
                var on = Model.Prefs.Contains(pref.Key);
                <label class="chip filter-check @(on ? "active" : "")">
                    <input type="checkbox" name="Prefs" value="@pref.Key" @(on ? "checked" : "") />
                    @(on ? "✓ " : "")@CatalogLocalizer.Text(pref.Label)
                </label>
            }
        </div>

        <h3 class="section-title" id="daycare-results">@CatalogLocalizer.Loc("5. Guarderías disponibles cerca de ti", "5. Daycares available near you")</h3>
        @if (!Model.CanSelectDaycare)
        {
            var daycareGate = new BookingGateNoteModel
            {
                Id = "daycare-need-basics",
                TextEs = "Completa fecha, horario y mascota (pasos 1–3) para poder elegir una guardería.",
                TextEn = "Complete date, schedule, and pet (steps 1–3) before choosing a daycare."
            };
            <partial name="_BookingGateNote" model="daycareGate" />
        }
        @if (!Model.Results.Any())
        {
            <div class="empty">@CatalogLocalizer.Loc("No hay guarderías con esos filtros en la base de datos.", "No daycares match these filters.")</div>
        }
        @foreach (var item in Model.Results)
        {
            var d = item.Daycare;
            var selected = Model.CanSelectDaycare && Model.GroomerId == d.Id;
            <div class="hotel-card @(selected ? "selected" : "") @(Model.CanSelectDaycare ? "" : "is-locked")">
                @if (item.AvailableToday)
                {
                    <span class="badge badge-green hotel-reco">@L["Search_AvailableToday"]</span>
                }
                <div class="hotel-card-main">
                    <img src="@(d.ImageUrl ?? "/images/categories/cat-daycare-v2.png")" alt="@d.BusinessName" />
                    <div class="info">
                        <h3>@d.BusinessName</h3>
                        <div class="meta-row">
                            @if (d.ReviewCount > 0)
                            {
                                <span class="stars">★ @d.Rating.ToString("0.0")</span>
                                <span class="muted small">(@d.ReviewCount)</span>
                            }
                            @if (!string.IsNullOrEmpty(item.DistanceLabel))
                            {
                                <span class="muted small">@item.DistanceLabel</span>
                            }
                        </div>
                        @if (item.Features.Any())
                        {
                            <div class="hotel-feats">
                                @foreach (var f in item.Features)
                                {
                                    <span>@CatalogLocalizer.Text(f)</span>
                                }
                            </div>
                        }
                        <div class="price">$@item.StartingPrice.ToString("0") <span class="muted small">@item.PriceUnitLabel</span></div>
                    </div>
                </div>
                @{
                    var daycareChoose = new BookingChooseActionModel
                    {
                        CanSelect = Model.CanSelectDaycare,
                        Selected = selected,
                        ChooseUrl = Url.Page("./Index", new
                        {
                            When = Model.When,
                            Date = Model.Date,
                            Schedule = Model.Schedule,
                            CustomStart = Model.CustomStart,
                            CustomEnd = Model.CustomEnd,
                            PetId = Model.PetId,
                            groomerId = d.Id,
                            Notes = Model.Notes,
                            More = Model.More
                        }),
                        GateAnchorId = "daycare-need-basics",
                        ChooseLabelEs = "Elegir guardería",
                        ChooseLabelEn = "Choose daycare"
                    };
                }
                <partial name="_BookingChooseAction" model="daycareChoose" />
            </div>
        }
        @if (Model.HasMore)
        {
            <a class="link-btn" style="display:block;text-align:center;margin:8px 0 16px"
               asp-page="./Index"
               asp-route-When="@Model.When"
               asp-route-Date="@Model.Date"
               asp-route-Schedule="@Model.Schedule"
               asp-route-PetId="@Model.PetId"
               asp-route-groomerId="@Model.GroomerId"
               asp-route-More="true">@CatalogLocalizer.Loc("Ver más guarderías", "See more daycares")</a>
        }
    </form>

    @if (Model.SelectedDaycare != null && Model.SelectedService != null)
    {
        <div class="card card-pad" style="margin-bottom:14px">
            <h3 class="section-title" style="margin-top:0">@CatalogLocalizer.Loc("6. Resumen", "6. Summary")</h3>
            <p><strong>@Model.SelectedDaycare.BusinessName</strong></p>
            <p>@Model.DateLabel</p>
            <p class="muted small">@Model.ScheduleLabel</p>
            @if (Model.SelectedPet != null)
            {
                <p class="muted small">@CatalogLocalizer.Loc("Mascota:", "Pet:") @Model.SelectedPet.Name</p>
            }
            <div class="summary-total" style="margin-top:8px">
                <span>@CatalogLocalizer.Loc("Total estimado", "Estimated total")</span>
                <strong>$@Model.Estimate.ToString("0")</strong>
            </div>
        </div>

        <form method="get" style="margin-bottom:8px">
            <input type="hidden" name="When" value="@Model.When" />
            <input type="hidden" name="Date" value="@Model.Date" />
            <input type="hidden" name="Schedule" value="@Model.Schedule" />
            <input type="hidden" name="CustomStart" value="@Model.CustomStart" />
            <input type="hidden" name="CustomEnd" value="@Model.CustomEnd" />
            <input type="hidden" name="PetId" value="@Model.PetId" />
            <input type="hidden" name="groomerId" value="@Model.GroomerId" />
            <input type="hidden" name="More" value="@(Model.More ? "true" : "false")" />
            @foreach (var p in Model.Prefs)
            {
                <input type="hidden" name="Prefs" value="@p" />
            }

            @if (Model.Extras.Any())
            {
                <h3 class="section-title">@CatalogLocalizer.Loc("7. Extras", "7. Extras") <span class="muted small">@CatalogLocalizer.Loc("(opcional)", "(optional)")</span></h3>
                @foreach (var e in Model.Extras)
                {
                    var on = Model.ExtraIds.Contains(e.Id);
                    <label class="toggle-row" style="cursor:pointer">
                        <span>@CatalogLocalizer.Text(e.Name) <span class="price">+$@e.Price.ToString("0")</span></span>
                        <input type="checkbox" name="ExtraIds" value="@e.Id" @(on ? "checked" : "") />
                    </label>
                }
            }

            <h3 class="section-title">@CatalogLocalizer.Loc("8. Notas para la guardería", "8. Notes for the daycare") <span class="muted small">@CatalogLocalizer.Loc("(opcional)", "(optional)")</span></h3>
            <textarea class="form-control" name="Notes" rows="3" maxlength="200"
                      placeholder="@CatalogLocalizer.Loc("Alergias, comportamiento, medicación…", "Allergies, behavior, medication…")"
                     >@Model.Notes</textarea>
            <p class="muted small">@CatalogLocalizer.Loc("Máx. 200 caracteres", "Max. 200 characters")</p>
        </form>
    }

    <partial name="_TrustBanner" />
    </div>
    <div class="bottom-nav-clearance" aria-hidden="true"></div>
</div>

@if (Model.SelectedDaycare != null && Model.SelectedService != null)
{
    ViewData["PromoCode"] = Model.PromoCode;
    ViewData["PromoSubtotal"] = Model.PromoSubtotal > 0 ? Model.PromoSubtotal : Model.Estimate;
    ViewData["PromoDiscount"] = Model.DiscountAmount;
    ViewData["PromoError"] = Model.PromoError;
    var multi = new List<BookingSummaryMultiHidden>();
    if (Model.Prefs.Count > 0)
        multi.Add(new BookingSummaryMultiHidden { Name = "Prefs", Values = Model.Prefs });
    if (Model.ExtraIds.Count > 0)
        multi.Add(new BookingSummaryMultiHidden { Name = "ExtraIds", Values = Model.ExtraIds.Select(id => id.ToString()) });
    <partial name="_BookingSummarySheet" model="@(new BookingSummarySheetModel
    {
        BodyId = "daycare-summary-body",
        StartCollapsed = !string.IsNullOrEmpty(Model.ErrorMessage),
        TitleEs = "Confirmar reserva",
        TitleEn = "Confirm booking",
        EditHintEs = "Seguir editando la reserva",
        EditHintEn = "Keep editing the booking",
        BusinessName = Model.SelectedDaycare.BusinessName,
        ImageUrl = Model.SelectedDaycare.ImageUrl,
        FallbackImage = "/images/categories/cat-daycare-v2.png",
        Subtitle = $"{Model.DateLabel} · {Model.ScheduleLabel}",
        Estimate = Model.Estimate,
        CustomerNotes = Model.Notes,
        PaymentHeadingEs = "Método de pago",
        PaymentHeadingEn = "Payment method",
        DefaultPayment = Model.DefaultPayment,
        AcceptTerms = Model.AcceptTerms,
        TermsStep = "10. ",
        SubmitLabelEs = $"Confirmar reserva · ${Model.Estimate:0}",
        SubmitLabelEn = $"Confirm booking · ${Model.Estimate:0}",
        HiddenFields =
        [
            new BookingSummaryHidden { Name = "When", Value = Model.When },
            new BookingSummaryHidden { Name = "Date", Value = Model.Date },
            new BookingSummaryHidden { Name = "Schedule", Value = Model.Schedule },
            new BookingSummaryHidden { Name = "CustomStart", Value = Model.CustomStart },
            new BookingSummaryHidden { Name = "CustomEnd", Value = Model.CustomEnd },
            new BookingSummaryHidden { Name = "PetId", Value = Model.PetId.ToString() },
            new BookingSummaryHidden { Name = "GroomerId", Value = Model.GroomerId?.ToString() },
            new BookingSummaryHidden { Name = "Notes", Value = Model.Notes }
        ],
        MultiHiddenFields = multi
    })" />
}
