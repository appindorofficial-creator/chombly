@page
@model WebAppPet.Pages.Daycare.IndexModel
@{
    ViewData["Title"] = L["Daycare_Title"].Value;
    ViewData["LangCompact"] = true;
    ViewData["OnboardBackHref"] = Url.Page("/Index");
    var minDate = AppTimeZones.TodayLocalDate().ToString("yyyy-MM-dd");
}
<div class="onboard onboard-app">
    <partial name="_OnboardTop" />
    <div class="home-body hotel-flow @(Model.GroomerId.HasValue ? "has-summary" : "")">
        <h1 class="app-page-heading">@L["Daycare_Title"]</h1>
        <p class="muted small">@L["Book_AllInOne"]</p>
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    <form method="get" id="daycare-filter-form">
        <input type="hidden" name="groomerId" value="@(Model.CanSelectDaycare ? Model.GroomerId : null)" />
        <input type="hidden" name="More" value="@(Model.More ? "true" : "false")" />

        <h3 class="section-title" style="margin-top:0">1. ¿Qué fecha necesitas?</h3>
        <partial name="_BookingDateField" model="new BookingDateFieldModel { Date = Model.Date, MinDate = minDate }" />

        <h3 class="section-title">2. Horario</h3>
        <div class="filter-bar" style="flex-direction:column;align-items:stretch">
            @foreach (var s in WebAppPet.Pages.Daycare.IndexModel.ScheduleOptions)
            {
                var on = Model.Schedule == s.Key;
                <label class="radio-card" style="margin-bottom:8px">
                    <input type="radio" name="Schedule" value="@s.Key" @(on ? "checked" : "") onchange="this.form.submit()" />
                    <div class="inner">
                        <strong>@CatalogLocalizer.Text(s.Label)</strong>
                        <div class="muted small">@CatalogLocalizer.Text(s.Hint)</div>
                    </div>
                </label>
            }
        </div>
        <p class="muted small" style="margin-top:-4px">Horario típico del negocio: 7:00 AM – 7:00 PM</p>
        @if (Model.Schedule == "personalizado")
        {
            <div class="form-row" style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px">
                <div class="form-group" style="margin:0">
                    <label class="small muted">Entrada</label>
                    <input class="form-control" type="time" name="CustomStart" value="@Model.CustomStart" onchange="this.form.submit()" />
                </div>
                <div class="form-group" style="margin:0">
                    <label class="small muted">Salida</label>
                    <input class="form-control" type="time" name="CustomEnd" value="@Model.CustomEnd" onchange="this.form.submit()" />
                </div>
            </div>
        }
        else
        {
            <input type="hidden" name="CustomStart" value="@Model.CustomStart" />
            <input type="hidden" name="CustomEnd" value="@Model.CustomEnd" />
        }

        <h3 class="section-title">3. Selecciona tu mascota</h3>
        <partial name="_BookingPetPicker" model="new BookingPetPickerModel { Pets = Model.Pets, PetId = Model.PetId }" />

        <h3 class="section-title">4. Preferencias <span class="muted small">(opcional)</span></h3>
        <div class="filter-bar">
            @foreach (var pref in WebAppPet.Pages.Daycare.IndexModel.PrefOptions)
            {
                var on = Model.Prefs.Contains(pref.Key);
                <label class="chip filter-check @(on ? "active" : "")">
                    <input type="checkbox" name="Prefs" value="@pref.Key" @(on ? "checked" : "") onchange="this.form.submit()" />
                    @(on ? "✓ " : "")@CatalogLocalizer.Text(pref.Label)
                </label>
            }
        </div>

        <h3 class="section-title" id="daycare-results">5. Daycares disponibles cerca de ti</h3>
        @if (!Model.CanSelectDaycare)
        {
            var daycareGate = new BookingGateNoteModel
            {
                Id = "daycare-need-basics",
                TextEs = "Completa fecha, horario y mascota (pasos 1–3) para poder elegir un daycare.",
                TextEn = "Complete date, schedule, and pet (steps 1–3) before choosing a daycare."
            };
            <partial name="_BookingGateNote" model="daycareGate" />
        }
        @if (!Model.Results.Any())
        {
            <div class="empty">No hay daycares con esos filtros en la base de datos.</div>
        }
        @foreach (var item in Model.Results)
        {
            var d = item.Daycare;
            var selected = Model.CanSelectDaycare && Model.GroomerId == d.Id;
            <div class="hotel-card @(selected ? "selected" : "") @(Model.CanSelectDaycare ? "" : "is-locked")">
                @if (item.AvailableToday)
                {
                    <span class="badge badge-green hotel-reco">@L["Search_AvailableToday"]</span>
                }
                <div class="hotel-card-main">
                    <img src="@(d.ImageUrl ?? "/images/categories/cat-daycare-v2.png")" alt="@d.BusinessName" />
                    <div class="info">
                        <h3>@d.BusinessName</h3>
                        <div class="meta-row">
                            @if (d.ReviewCount > 0)
                            {
                                <span class="stars">★ @d.Rating.ToString("0.0")</span>
                                <span class="muted small">(@d.ReviewCount)</span>
                            }
                            @if (!string.IsNullOrEmpty(item.DistanceLabel))
                            {
                                <span class="muted small">@item.DistanceLabel</span>
                            }
                        </div>
                        @if (item.Features.Any())
                        {
                            <div class="hotel-feats">
                                @foreach (var f in item.Features)
                                {
                                    <span>@CatalogLocalizer.Text(f)</span>
                                }
                            </div>
                        }
                        <div class="price">$@item.StartingPrice.ToString("0") <span class="muted small">@item.PriceUnitLabel</span></div>
                    </div>
                </div>
                @{
                    var daycareChoose = new BookingChooseActionModel
                    {
                        CanSelect = Model.CanSelectDaycare,
                        Selected = selected,
                        ChooseUrl = Url.Page("./Index", new
                        {
                            When = Model.When,
                            Date = Model.Date,
                            Schedule = Model.Schedule,
                            CustomStart = Model.CustomStart,
                            CustomEnd = Model.CustomEnd,
                            PetId = Model.PetId,
                            groomerId = d.Id,
                            Notes = Model.Notes,
                            More = Model.More
                        }),
                        GateAnchorId = "daycare-need-basics",
                        ChooseLabelEs = "Elegir daycare",
                        ChooseLabelEn = "Choose daycare"
                    };
                }
                <partial name="_BookingChooseAction" model="daycareChoose" />
            </div>
        }
        @if (Model.HasMore)
        {
            <a class="link-btn" style="display:block;text-align:center;margin:8px 0 16px"
               asp-page="./Index"
               asp-route-When="@Model.When"
               asp-route-Date="@Model.Date"
               asp-route-Schedule="@Model.Schedule"
               asp-route-PetId="@Model.PetId"
               asp-route-groomerId="@Model.GroomerId"
               asp-route-More="true">Ver más daycares</a>
        }
    </form>

    @if (Model.SelectedDaycare != null && Model.SelectedService != null)
    {
        <div class="card card-pad" style="margin-bottom:14px">
            <h3 class="section-title" style="margin-top:0">6. Resumen</h3>
            <p><strong>@Model.SelectedDaycare.BusinessName</strong></p>
            <p>@Model.DateLabel</p>
            <p class="muted small">@Model.ScheduleLabel</p>
            @if (Model.SelectedPet != null)
            {
                <p class="muted small">Mascota: @Model.SelectedPet.Name</p>
            }
            <div class="summary-total" style="margin-top:8px">
                <span>Total estimado</span>
                <strong>$@Model.Estimate.ToString("0")</strong>
            </div>
        </div>

        <form method="get" style="margin-bottom:8px">
            <input type="hidden" name="When" value="@Model.When" />
            <input type="hidden" name="Date" value="@Model.Date" />
            <input type="hidden" name="Schedule" value="@Model.Schedule" />
            <input type="hidden" name="CustomStart" value="@Model.CustomStart" />
            <input type="hidden" name="CustomEnd" value="@Model.CustomEnd" />
            <input type="hidden" name="PetId" value="@Model.PetId" />
            <input type="hidden" name="groomerId" value="@Model.GroomerId" />
            <input type="hidden" name="More" value="@(Model.More ? "true" : "false")" />
            @foreach (var p in Model.Prefs)
            {
                <input type="hidden" name="Prefs" value="@p" />
            }

            @if (Model.Extras.Any())
            {
                <h3 class="section-title">7. Extras <span class="muted small">(opcional)</span></h3>
                @foreach (var e in Model.Extras)
                {
                    var on = Model.ExtraIds.Contains(e.Id);
                    <label class="toggle-row" style="cursor:pointer">
                        <span>@e.Name <span class="price">+$@e.Price.ToString("0")</span></span>
                        <input type="checkbox" name="ExtraIds" value="@e.Id" @(on ? "checked" : "") onchange="this.form.submit()" />
                    </label>
                }
            }

            <h3 class="section-title">8. Notas para el daycare <span class="muted small">(opcional)</span></h3>
            <textarea class="form-control" name="Notes" rows="3" maxlength="200"
                      placeholder="Alergias, comportamiento, medicación…"
                      onchange="this.form.submit()">@Model.Notes</textarea>
            <p class="muted small">Máx. 200 caracteres</p>
        </form>
    }

    <partial name="_TrustBanner" />
    </div>
    <div class="bottom-nav-clearance" aria-hidden="true"></div>
</div>

@if (Model.SelectedDaycare != null && Model.SelectedService != null)
{
    ViewData["PromoCode"] = Model.PromoCode;
    ViewData["PromoSubtotal"] = Model.PromoSubtotal > 0 ? Model.PromoSubtotal : Model.Estimate;
    ViewData["PromoDiscount"] = Model.DiscountAmount;
    ViewData["PromoError"] = Model.PromoError;
    ViewData["TermsStep"] = "10. ";
    ViewData["TermsChecked"] = Model.AcceptTerms;
    <aside class="hotel-summary">
        <div class="hotel-summary-inner">
            <h3>Confirmar reserva</h3>
            <div class="summary-hotel">
                <img src="@(Model.SelectedDaycare.ImageUrl ?? "/images/categories/cat-daycare-v2.png")" alt="" />
                <div>
                    <strong>@Model.SelectedDaycare.BusinessName</strong>
                    <div class="muted small">@Model.DateLabel · @Model.ScheduleLabel</div>
                </div>
            </div>
            <div class="summary-total">
                <span>Total</span>
                <strong>$@Model.Estimate.ToString("0")</strong>
            </div>

            <form method="post">
                <input type="hidden" name="When" value="@Model.When" />
                <input type="hidden" name="Date" value="@Model.Date" />
                <input type="hidden" name="Schedule" value="@Model.Schedule" />
                <input type="hidden" name="CustomStart" value="@Model.CustomStart" />
                <input type="hidden" name="CustomEnd" value="@Model.CustomEnd" />
                <input type="hidden" name="PetId" value="@Model.PetId" />
                <input type="hidden" name="GroomerId" value="@Model.GroomerId" />
                <input type="hidden" name="Notes" value="@Model.Notes" />
                @foreach (var p in Model.Prefs)
                {
                    <input type="hidden" name="Prefs" value="@p" />
                }
                @foreach (var id in Model.ExtraIds)
                {
                    <input type="hidden" name="ExtraIds" value="@id" />
                }

                <partial name="_PromoCode" />

                <h4 class="summary-sub">9. Método de pago</h4>
                @if (Model.DefaultPayment != null)
                {
                    <div class="pay-row">
                        <span>💳 @Model.DefaultPayment.Brand •••• @Model.DefaultPayment.Last4</span>
                        <a asp-page="/Account/PaymentMethods">Cambiar</a>
                    </div>
                    <input type="hidden" name="PaymentMethodId" value="@Model.DefaultPayment.Id" />
                }
                else
                {
                    <a class="btn btn-outline btn-block btn-sm" asp-page="/Account/PaymentMethods" style="margin-bottom:10px">+ Agregar método de pago</a>
                }

                <partial name="_AcceptTerms" />

                <button class="btn btn-primary btn-block" type="submit" asp-page-handler="Book" style="margin-top:10px"
                        aria-describedby="AcceptTerms-error">
                    Confirmar reserva · $@Model.Estimate.ToString("0")
                </button>
                <p class="muted small" style="text-align:center;margin-top:8px">Pago seguro y encriptado</p>
            </form>
        </div>
    </aside>
}
