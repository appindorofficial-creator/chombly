@page
@model WebAppPet.Pages.Groomer.AnalyticsModel
@{
    ViewData["Title"] = CatalogLocalizer.Loc("Analíticas", "Analytics");
    ViewData["GroomerTab"] = "analytics";
    ViewData["LangCompact"] = true;
    ViewData["OnboardShowNotif"] = true;
    ViewData["OnboardNotifReturn"] = "/Groomer/Analytics";
}
<div class="onboard onboard-app">
    <partial name="_OnboardTop" />
    <div class="home-body">
    <partial name="_GroomerNav" />

    <h2 style="margin:0 0 16px">@CatalogLocalizer.Loc("Analíticas", "Analytics") · @DateTime.Today.ToString("MMMM yyyy")</h2>

    <div class="promo-banner" style="margin-top:0">
        <div style="flex:1">
            <span class="small" style="opacity:.85">@CatalogLocalizer.Loc("Ingresos del mes", "This month's earnings") · @AppMoney.CodeLabel()</span>
            <strong style="font-size:1.6rem">@AppMoney.Format(Model.MonthIncome)</strong>
        </div>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
        <div class="card card-pad" style="text-align:center">
            <div style="font-size:1.5rem;font-weight:900;color:var(--purple)">@Model.Completed</div>
            <div class="muted small">@CatalogLocalizer.Loc("Citas completadas", "Completed bookings")</div>
        </div>
        <div class="card card-pad" style="text-align:center">
            <div style="font-size:1.5rem;font-weight:900;color:var(--purple)">@Model.NewRequests</div>
            <div class="muted small">@CatalogLocalizer.Loc("Nuevas solicitudes", "New requests")</div>
        </div>
        <div class="card card-pad" style="text-align:center">
            <div style="font-size:1.5rem;font-weight:900;color:var(--purple)">@Model.UniqueClients</div>
            <div class="muted small">@CatalogLocalizer.Loc("Clientes atendidos", "Clients served")</div>
        </div>
        <div class="card card-pad" style="text-align:center">
            <div style="font-size:1.5rem;font-weight:900;color:@(Model.Cancelled > 0 ? "#dc2626" : "var(--purple)")">@Model.Cancelled</div>
            <div class="muted small">@CatalogLocalizer.Loc("Cancelaciones", "Cancellations")</div>
        </div>
    </div>

    <h3 class="section-title">@CatalogLocalizer.Loc("Servicios más solicitados", "Top requested services")</h3>
    @foreach (var s in Model.TopServices)
    {
        <div style="margin-bottom:10px">
            <div style="display:flex;justify-content:space-between;font-weight:700;font-size:.88rem;margin-bottom:4px">
                <span>@CatalogLocalizer.Text(s.Name)</span><span class="muted">@s.Count</span>
            </div>
            <div style="height:10px;background:var(--border);border-radius:5px;overflow:hidden">
                <div style="width:@(s.Percent)%;height:100%;background:var(--purple)"></div>
            </div>
        </div>
    }
    @if (!Model.TopServices.Any())
    {
        <div class="empty">@CatalogLocalizer.Loc("Aún no hay datos suficientes.", "Not enough data yet.")</div>
    }
    </div>
    <div class="bottom-nav-clearance" aria-hidden="true"></div>
</div>
