@page
@model WebAppPet.Pages.Groomer.AppointmentsModel
@{
    ViewData["Title"] = L["Nav_Appointments"].Value;
    ViewData["GroomerTab"] = "appointments";
    ViewData["LangCompact"] = true;
    ViewData["OnboardShowNotif"] = true;
    ViewData["OnboardNotifReturn"] = "/Groomer/Appointments";
}
<div class="onboard onboard-app">
    <partial name="_OnboardTop" />
    <div class="home-body">
    <partial name="_GroomerNav" />

    <div class="tabs">
        <a class="@(Model.Tab == "requests" ? "active" : "")" asp-page="./Appointments" asp-route-tab="requests">@CatalogLocalizer.Loc("Solicitudes", "Requests")</a>
        <a class="@(Model.Tab == "upcoming" ? "active" : "")" asp-page="./Appointments" asp-route-tab="upcoming">@L["Appt_Upcoming"]</a>
        <a class="@(Model.Tab == "history" ? "active" : "")" asp-page="./Appointments" asp-route-tab="history">@L["Appt_History"]</a>
    </div>

    @if (!Model.Items.Any())
    {
        <div class="empty">@CatalogLocalizer.Loc("No hay citas en esta sección.", "No bookings in this section.")</div>
    }

    @foreach (var a in Model.Items)
    {
        <div class="appt-card">
            <div class="row" style="margin-bottom:10px">
                <img src="@PetSpecies.PhotoOrDefault(a.Pet.PhotoUrl, a.Pet.Species)" alt="@a.Pet.Name" style="border-radius:50%" />
                <div style="flex:1">
                    <strong>@a.Pet.Name · @CatalogLocalizer.Text(a.Service.Name)</strong>
                    <div class="muted small">@a.ScheduledAt.ToString("ddd d MMM yyyy · h:mm tt")</div>
                    <span class="price">$@a.TotalPrice.ToString("0.00")</span>
                </div>
                <span class="badge @Model.StatusBadge(a.Status)">@Model.StatusLabel(a.Status)</span>
            </div>

            <div class="card-pad" style="background:var(--purple-soft);border-radius:12px;padding:10px 12px;margin-bottom:10px">
                <strong class="small">@CatalogLocalizer.Loc("Cliente y mascota", "Client & pet")</strong>
                <div class="muted small">👤 @a.Client.FullName · 📞 @(a.Client.Phone ?? CatalogLocalizer.Loc("sin teléfono", "no phone"))</div>
                <div class="muted small">@PetSpecies.Emoji(a.Pet.Species) @PetSpecies.Label(a.Pet.Species) · @PetCatalog.DisplayBreed(a.Pet.Species, a.Pet.Breed) · @a.Pet.AgeYears @L["Pets_Years"] · @PetCatalog.DisplayTemperament(a.Pet.Temperament)</div>
                @if (a.Pet.IsAnxious || a.Pet.IsSenior || a.Pet.HasSpecialNeeds)
                {
                    <div class="muted small">
                        ⚠️ @(a.Pet.IsSenior ? CatalogLocalizer.Loc("Senior. ", "Senior. ") : "")@(a.Pet.IsAnxious ? CatalogLocalizer.Loc("Ansioso. ", "Anxious. ") : "")@(a.Pet.HasSpecialNeeds ? CatalogLocalizer.Loc("Necesidades especiales.", "Special needs.") : "")
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(a.Notes))
                {
                    <div class="muted small">📝 @CatalogLocalizer.Notes(a.Notes)</div>
                }
            </div>

            @if (a.Status == AppointmentStatus.Pending)
            {
                <div style="display:flex;gap:8px">
                    <form method="post" asp-page-handler="Reject" style="flex:1">
                        <input type="hidden" name="id" value="@a.Id" />
                        <input type="hidden" name="tab" value="@Model.Tab" />
                        <button class="btn btn-block btn-sm" type="submit" style="background:#fee2e2;color:#991b1b">@L["Admin_Reject"]</button>
                    </form>
                    <form method="post" asp-page-handler="Accept" style="flex:1">
                        <input type="hidden" name="id" value="@a.Id" />
                        <input type="hidden" name="tab" value="@Model.Tab" />
                        <button class="btn btn-primary btn-block btn-sm" type="submit">@CatalogLocalizer.Loc("Aceptar", "Accept")</button>
                    </form>
                </div>
            }
            else if (a.Status == AppointmentStatus.Confirmed)
            {
                <form method="post" asp-page-handler="Complete" class="vet-provider-note-form">
                    <input type="hidden" name="id" value="@a.Id" />
                    <input type="hidden" name="tab" value="@Model.Tab" />
                    <label class="muted small" style="display:block;margin-bottom:6px">
                        @CatalogLocalizer.Loc("Nota clínica (historial de la mascota)", "Clinical note (pet history)")
                    </label>
                    <textarea name="clinicalNotes" class="vet-summary-notes-input" rows="3"
                              placeholder="@CatalogLocalizer.Loc("Hallazgos, orientación, seguimiento…", "Findings, guidance, follow-up…")"></textarea>
                    <button class="btn btn-primary btn-block btn-sm" type="submit">
                        @CatalogLocalizer.Loc("Completar y guardar nota", "Complete and save note")
                    </button>
                </form>
            }
            else if (a.Status == AppointmentStatus.Completed)
            {
                <form method="post" asp-page-handler="SaveNote" class="vet-provider-note-form" style="margin-top:8px">
                    <input type="hidden" name="id" value="@a.Id" />
                    <input type="hidden" name="tab" value="@Model.Tab" />
                    <label class="muted small" style="display:block;margin-bottom:6px">
                        @CatalogLocalizer.Loc("Actualizar nota clínica", "Update clinical note")
                    </label>
                    <textarea name="clinicalNotes" class="vet-summary-notes-input" rows="2"
                              placeholder="@CatalogLocalizer.Loc("Añadir o corregir nota para el historial…", "Add or correct note for history…")"></textarea>
                    <button class="btn btn-outline btn-block btn-sm" type="submit">
                        @CatalogLocalizer.Loc("Guardar en historial", "Save to history")
                    </button>
                </form>
            }
        </div>
    }
    </div>
    <div class="bottom-nav-clearance" aria-hidden="true"></div>
</div>
