@page
@model WebAppPet.Pages.Groomer.AvailabilityModel
@{
    ViewData["Title"] = CatalogLocalizer.Loc("Disponibilidad", "Availability");
    ViewData["GroomerTab"] = "availability";
    ViewData["LangCompact"] = true;
    var openWeek = Model.WeekEdit.Count(d => d.IsOpen);
    var openDays = Model.Days.Count(d => d.IsAvailable);
    var closedDays = Model.Days.Count(d => !d.IsAvailable);
    var openLabel = L["Biz_Open"].Value;
    var closedLabel = CatalogLocalizer.Loc("Cerrado", "Closed");
}
<div class="onboard onboard-app agenda-page">
    <partial name="_OnboardTop" />
    <div class="home-body hotel-flow">
        <partial name="_GroomerNav" />

        <header class="agenda-head">
            <h1 class="app-page-heading">@L["Groomer_Agenda"]</h1>
            <p class="muted small agenda-lead">@CatalogLocalizer.Loc("Define tu horario semanal. La agenda de citas se genera a partir de él.", "Set your weekly hours. Bookings are generated from this schedule.")</p>
        </header>

        <div class="agenda-tip" aria-hidden="false">
            <span class="agenda-tip-cal" aria-hidden="true">
                @* Hollow frame: tip green shows through the center *@
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" fill="none">
                    <ellipse cx="60" cy="110" rx="28" ry="5" fill="#073D2E" opacity=".12"/>
                    <path fill="#073D2E" fill-rule="evenodd" d="M22 28c0-8.837 7.163-16 16-16h44c8.837 0 16 7.163 16 16v56c0 8.837-7.163 16-16 16H38c-8.837 0-16-7.163-16-16V28Zm14 20c0-4.418 3.582-8 8-8h32c4.418 0 8 3.582 8 8v36c0 4.418-3.582 8-8 8H44c-4.418 0-8-3.582-8-8V48Z"/>
                    <rect x="22" y="20" width="76" height="24" rx="12" fill="#073D2E"/>
                    <rect x="26" y="24" width="68" height="16" rx="8" fill="#B6E740"/>
                    <circle cx="42" cy="32" r="4.2" fill="none" stroke="#073D2E" stroke-width="2.4"/>
                    <circle cx="60" cy="32" r="4.2" fill="none" stroke="#073D2E" stroke-width="2.4"/>
                    <circle cx="78" cy="32" r="4.2" fill="none" stroke="#073D2E" stroke-width="2.4"/>
                    <g fill="#073D2E" opacity=".4">
                        <rect x="40" y="54" width="9" height="9" rx="2"/>
                        <rect x="55" y="54" width="9" height="9" rx="2"/>
                        <rect x="70" y="54" width="9" height="9" rx="2"/>
                        <rect x="40" y="68" width="9" height="9" rx="2"/>
                        <rect x="55" y="68" width="9" height="9" rx="2"/>
                        <rect x="40" y="82" width="9" height="9" rx="2"/>
                        <rect x="55" y="82" width="9" height="9" rx="2"/>
                    </g>
                    <rect x="70" y="68" width="9" height="9" rx="2" fill="#B6E740"/>
                    <rect x="70" y="82" width="9" height="9" rx="2" fill="#9ED42A"/>
                </svg>
            </span>
            <p class="agenda-tip-kicker">@CatalogLocalizer.Loc("Tu ritmo", "Your rhythm")</p>
            <p class="agenda-tip-copy">@CatalogLocalizer.Loc($"{openWeek} días abiertos esta semana · {openDays} disponibles en los próximos 30", $"{openWeek} open days this week · {openDays} available in the next 30")</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <div class="alert alert-info agenda-flash">@Model.Message</div>
        }

        <div class="agenda-stats">
            <div class="agenda-stat">
                <strong>@openWeek</strong>
                <span>@CatalogLocalizer.Loc("Abiertos / sem", "Open / wk")</span>
            </div>
            <div class="agenda-stat">
                <strong>@openDays</strong>
                <span>@CatalogLocalizer.Loc("Disponibles", "Available")</span>
            </div>
            <div class="agenda-stat">
                <strong>@closedDays</strong>
                <span>@CatalogLocalizer.Loc("Cerrados", "Closed")</span>
            </div>
        </div>

        <h3 class="section-title agenda-section-title">@CatalogLocalizer.Loc("Horario semanal", "Weekly hours")</h3>
        <form method="post" asp-page-handler="SaveWeek" class="agenda-week-form">
            <div class="agenda-week-list">
                @for (var i = 0; i < Model.WeekEdit.Count; i++)
                {
                    var day = Model.WeekEdit[i];
                    <article class="agenda-day-card @(day.IsOpen ? "is-open" : "is-closed")" style="--i:@i">
                        <input type="hidden" name="WeekEdit[@i].DayOfWeek" value="@day.DayOfWeek" />
                        <input type="hidden" name="WeekEdit[@i].Label" value="@day.Label" />
                        <label class="agenda-day-toggle">
                            <span class="agenda-day-meta">
                                <strong>@day.Label</strong>
                                <span class="agenda-day-status">@(day.IsOpen ? openLabel : closedLabel)</span>
                            </span>
                            <span class="agenda-switch">
                                <input type="checkbox" name="WeekEdit[@i].IsOpen" value="true"
                                       @(day.IsOpen ? "checked" : null)
                                       data-agenda-switch
                                       aria-label="@CatalogLocalizer.Loc($"{day.Label} abierto", $"{day.Label} open")" />
                                <span class="agenda-switch-track" aria-hidden="true"></span>
                            </span>
                            @* The unchecked fallback must follow the checkbox: model binding keeps the first posted value. *@
                            <input type="hidden" name="WeekEdit[@i].IsOpen" value="false" />
                        </label>
                        <div class="agenda-day-times">
                            <div class="form-group">
                                <label class="small muted">@L["Biz_Opens"]</label>
                                <input class="form-control" type="time" name="WeekEdit[@i].OpenTime" value="@day.OpenTime" />
                            </div>
                            <div class="form-group">
                                <label class="small muted">@L["Biz_Closes"]</label>
                                <input class="form-control" type="time" name="WeekEdit[@i].CloseTime" value="@day.CloseTime" />
                            </div>
                        </div>
                    </article>
                }
            </div>
            <button class="btn btn-primary btn-block agenda-primary-btn" type="submit">
                @CatalogLocalizer.Loc("Guardar horario y regenerar 60 días", "Save hours and regenerate 60 days")
            </button>
        </form>

        <form method="post" asp-page-handler="Regenerate" class="agenda-regen-form">
            <button class="btn btn-outline btn-block agenda-secondary-btn" type="submit">
                @CatalogLocalizer.Loc("Solo regenerar agenda (sin cambiar horario)", "Only regenerate agenda (keep hours)")
            </button>
        </form>

        <h3 class="section-title agenda-section-title">@CatalogLocalizer.Loc("Próximos 30 días", "Next 30 days")</h3>
        <p class="muted small agenda-cal-lead">@CatalogLocalizer.Loc("Toca un día para abrirlo o cerrarlo (vacaciones, lleno, etc.).", "Tap a day to open or close it (vacation, full, etc.).")</p>

        @if (!Model.Days.Any())
        {
            <div class="empty agenda-empty">@CatalogLocalizer.Loc("Aún no hay días. Guarda el horario semanal primero.", "No days yet. Save the weekly hours first.")</div>
        }
        else
        {
            <div class="agenda-cal-grid">
                @for (var i = 0; i < Model.Days.Count; i++)
                {
                    var d = Model.Days[i];
                    <form method="post" asp-page-handler="Toggle" class="agenda-cal-cell @(d.IsAvailable ? "is-open" : "is-closed")" style="--i:@Math.Min(i, 11)">
                        <input type="hidden" name="id" value="@d.Id" />
                        <button type="submit" class="agenda-cal-btn" title="@(string.IsNullOrWhiteSpace(d.Note) ? (d.IsAvailable ? CatalogLocalizer.Loc("Disponible", "Available") : closedLabel) : CatalogLocalizer.Text(d.Note))">
                            <span class="agenda-cal-dow">@d.Day.ToString("ddd")</span>
                            <span class="agenda-cal-num">@d.Day.Day</span>
                            <span class="agenda-cal-state">@(d.IsAvailable ? openLabel : closedLabel)</span>
                        </button>
                    </form>
                }
            </div>
        }
    </div>
    <div class="bottom-nav-clearance" aria-hidden="true"></div>
</div>

@section Scripts {
<script>
(function () {
    var openLabel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(openLabel));
    var closedLabel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(closedLabel));
    document.querySelectorAll('[data-agenda-switch]').forEach(function (input) {
        input.addEventListener('change', function () {
            var card = input.closest('.agenda-day-card');
            if (!card) return;
            card.classList.toggle('is-open', input.checked);
            card.classList.toggle('is-closed', !input.checked);
            var status = card.querySelector('.agenda-day-status');
            if (status) status.textContent = input.checked ? openLabel : closedLabel;
        });
    });
})();
</script>
}
