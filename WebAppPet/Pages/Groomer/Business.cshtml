@page
@model WebAppPet.Pages.Groomer.BusinessModel
@{
    ViewData["Title"] = L["Groomer_Business"].Value;
    ViewData["GroomerTab"] = "business";
    ViewData["LangCompact"] = true;
    var catCount = Model.CategoryIds.Count;
    var svcCount = Model.Services.Count;
    var amenityCount = Model.Amenities.Count;
    var extraCount = Model.Extras.Count;
    var bizName = string.IsNullOrWhiteSpace(Model.BusinessName)
        ? CatalogLocalizer.Loc("Tu negocio", "Your business")
        : Model.BusinessName;
}
<div class="onboard onboard-app biz-page">
    <partial name="_OnboardTop" />
    <div class="home-body">
        <partial name="_GroomerNav" />

        <header class="biz-head">
            <h1 class="app-page-heading">@L["Groomer_Business"]</h1>
            <p class="muted small biz-lead">@CatalogLocalizer.Loc("Hotel, vet, grooming, daycare… todo se configura aquí y se lee desde la BD.", "Hotel, vet, grooming, daycare… everything is configured here and read from the DB.")</p>
        </header>

        <div class="biz-tip">
            <span class="biz-tip-store" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" fill="none">
                    <ellipse cx="60" cy="110" rx="30" ry="5" fill="#073D2E" opacity=".12"/>
                    <!-- awning / roof -->
                    <path fill="#073D2E" d="M18 48 28 22h64l10 26H18Z"/>
                    <path fill="#B6E740" d="M22 46 30 28h60l8 18H22Z"/>
                    <g fill="#073D2E" opacity=".35">
                        <path d="M28 28h10l-3 18H25l3-18Z"/>
                        <path d="M44 28h10l-3 18H41l3-18Z"/>
                        <path d="M60 28h10l-3 18H57l3-18Z"/>
                        <path d="M76 28h10l-3 18H73l3-18Z"/>
                    </g>
                    <!-- store body (hollow so tip green shows through) -->
                    <path fill="#073D2E" fill-rule="evenodd" d="M24 48h72v44c0 6.627-5.373 12-12 12H36c-6.627 0-12-5.373-12-12V48Zm14 18c0-3.314 2.686-6 6-6h16c3.314 0 6 2.686 6 6v28H38V66Zm40-6h12v12H78V60Zm0 18h12v12H78V78Z"/>
                    <rect x="52" y="78" width="8" height="6" rx="1.5" fill="#B6E740"/>
                </svg>
            </span>
            <p class="biz-tip-kicker">@CatalogLocalizer.Loc("Perfil público", "Public profile")</p>
            <p class="biz-tip-copy">@bizName · @catCount @CatalogLocalizer.Loc("categorías", "categories") · @svcCount @CatalogLocalizer.Loc("servicios", "services")</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <div class="alert alert-info biz-flash">@Model.Message</div>
        }

        <div class="biz-stats">
            <div class="biz-stat">
                <strong>@catCount</strong>
                <span>@CatalogLocalizer.Loc("Categorías", "Categories")</span>
            </div>
            <div class="biz-stat">
                <strong>@svcCount</strong>
                <span>@L["Groomer_Services"]</span>
            </div>
            <div class="biz-stat">
                <strong>@(amenityCount + extraCount)</strong>
                <span>@CatalogLocalizer.Loc("Extras", "Extras")</span>
            </div>
        </div>

        <form method="post" asp-page-handler="Save" class="biz-save-form">
            <section class="biz-panel" style="--i:0">
                <h3 class="biz-panel-title">@CatalogLocalizer.Loc("Datos básicos", "Basic details")</h3>
                <div class="form-group">
                    <label>@L["Biz_BusinessName"]</label>
                    <input class="form-control" asp-for="BusinessName" required />
                </div>
                <div class="form-group">
                    <label>@CatalogLocalizer.Loc("Categorías", "Categories")</label>
                    <p class="muted small biz-hint">@CatalogLocalizer.Loc("Marca todos los servicios que ofreces. Puedes agregar o quitar cuando quieras.", "Check every service you offer. You can add or remove anytime.")</p>
                    <input type="hidden" asp-for="CategoryId" />
                    <div class="biz-cat-grid">
                        @{ var ci = 0; }
                        @foreach (var c in Model.Categories)
                        {
                            var on = Model.CategoryIds.Contains(c.Id);
                            <label class="biz-cat-card @(on ? "active" : "")" style="--i:@ci">
                                <input type="checkbox" name="CategoryIds" value="@c.Id" @(on ? "checked" : null) />
                                <img src="/images/categories/cat-@(c.Slug)-v2.png" alt="" />
                                <strong>@c.DisplayName()</strong>
                            </label>
                            ci++;
                        }
                    </div>
                </div>
            </section>

            <section class="biz-panel" style="--i:1">
                <h3 class="biz-panel-title">@CatalogLocalizer.Loc("Ubicación y contacto", "Location & contact")</h3>
                <div class="form-group">
                    <label>@L["Common_Address"]</label>
                    <input class="form-control" asp-for="Address" id="Address" data-places="address" data-places-fill="address"
                           data-places-city="#City" data-places-lat="#Latitude" data-places-lng="#Longitude"
                           placeholder="@L["Biz_SearchAddress"]" />
                </div>
                <div class="form-group">
                    <label>@L["Common_City"]</label>
                    <input class="form-control" asp-for="City" id="City" data-places="city" data-places-fill="city"
                           data-places-lat="#Latitude" data-places-lng="#Longitude"
                           placeholder="@L["Biz_SearchCity"]" />
                </div>
                <div class="biz-coord-row">
                    <div class="form-group">
                        <label>@CatalogLocalizer.Loc("Latitud", "Latitude")</label>
                        <input class="form-control" asp-for="Latitude" id="Latitude" data-places-fill="lat" step="any" readonly />
                    </div>
                    <div class="form-group">
                        <label>@CatalogLocalizer.Loc("Longitud", "Longitude")</label>
                        <input class="form-control" asp-for="Longitude" id="Longitude" data-places-fill="lng" step="any" readonly />
                    </div>
                </div>
                <p class="muted small biz-hint">@L["Biz_MapsTip"]</p>
                <div class="form-group">
                    <label>@L["Common_Phone"]</label>
                    <input class="form-control" asp-for="Phone" type="tel" inputmode="numeric" data-phone="1"
                           maxlength="10" pattern="[0-9]{7,10}" autocomplete="tel" placeholder="7045551234" />
                </div>
            </section>

            <section class="biz-panel" style="--i:2">
                <h3 class="biz-panel-title">@CatalogLocalizer.Loc("Presentación y precios", "Presentation & prices")</h3>
                <div class="form-group">
                    <label>@CatalogLocalizer.Loc("Imagen (URL)", "Image (URL)")</label>
                    <input class="form-control" asp-for="ImageUrl" placeholder="/images/..." />
                </div>
                <div class="form-group">
                    <label>@CatalogLocalizer.Loc("Sobre el negocio", "About the business")</label>
                    <textarea class="form-control" asp-for="About" rows="3"></textarea>
                </div>
                <div class="biz-coord-row">
                    <div class="form-group">
                        <label>@CatalogLocalizer.Loc("Precio desde", "Starting price")</label>
                        <input class="form-control" asp-for="StartingPrice" step="0.01" />
                    </div>
                    <div class="form-group">
                        <label>@CatalogLocalizer.Loc("Unidad", "Unit")</label>
                        <input class="form-control" asp-for="PriceUnit" placeholder="@CatalogLocalizer.Loc("/ noche", "/ night")" />
                    </div>
                </div>
                <div class="form-group">
                    <label>@CatalogLocalizer.Loc("Especies (CSV)", "Species (CSV)")</label>
                    <input class="form-control" asp-for="AcceptedSpecies" />
                </div>
            </section>

            <section class="biz-panel" style="--i:3">
                <h3 class="biz-panel-title">@CatalogLocalizer.Loc("Preferencias", "Preferences")</h3>
                <label class="biz-pref-row">
                    <span>@CatalogLocalizer.Loc("Mascotas senior", "Senior pets")</span>
                    <span class="biz-switch">
                        <input asp-for="AcceptsSeniorPets" type="checkbox" />
                        <span class="biz-switch-track" aria-hidden="true"></span>
                    </span>
                </label>
                <label class="biz-pref-row">
                    <span>@CatalogLocalizer.Loc("Mascotas ansiosas", "Anxious pets")</span>
                    <span class="biz-switch">
                        <input asp-for="AcceptsAnxiousPets" type="checkbox" />
                        <span class="biz-switch-track" aria-hidden="true"></span>
                    </span>
                </label>
                <label class="biz-pref-row">
                    <span>@CatalogLocalizer.Loc("Destacado", "Featured")</span>
                    <span class="biz-switch">
                        <input asp-for="IsFeatured" type="checkbox" />
                        <span class="biz-switch-track" aria-hidden="true"></span>
                    </span>
                </label>
                <label class="biz-pref-row">
                    <span>@CatalogLocalizer.Loc("Activo / visible", "Active / visible")</span>
                    <span class="biz-switch">
                        <input asp-for="IsActive" type="checkbox" />
                        <span class="biz-switch-track" aria-hidden="true"></span>
                    </span>
                </label>
            </section>

            <button class="btn btn-primary btn-block biz-primary-btn" type="submit">@CatalogLocalizer.Loc("Guardar negocio", "Save business")</button>
        </form>

        <h3 id="biz-services" class="section-title biz-section-title">@L["Groomer_Services"]</h3>
        <div class="biz-list">
            @foreach (var s in Model.Services)
            {
                <article class="biz-item-card">
                    <strong>@s.Name</strong>
                    <div class="muted small">@L["Common_From"] $@s.PriceSmall · @s.BillingUnit</div>
                </article>
            }
        </div>
        <form method="post" asp-page-handler="AddService" class="biz-add-card">
            <div class="form-group"><label>@CatalogLocalizer.Loc("Nuevo servicio", "New service")</label><input class="form-control" asp-for="NewServiceName" /></div>
            <div class="biz-coord-row">
                <div class="form-group"><label>@CatalogLocalizer.Loc("Precio base", "Base price")</label><input class="form-control" asp-for="NewServicePrice" step="0.01" /></div>
                <div class="form-group">
                    <label>@CatalogLocalizer.Loc("Unidad", "Unit")</label>
                    <select class="form-control" asp-for="NewServiceUnit">
                        <option value="sesion">@CatalogLocalizer.Loc("sesión", "session")</option>
                        <option value="noche">@CatalogLocalizer.Loc("noche", "night")</option>
                        <option value="dia">@CatalogLocalizer.Loc("día", "day")</option>
                        <option value="visita">@CatalogLocalizer.Loc("visita", "visit")</option>
                    </select>
                </div>
            </div>
            <button class="btn btn-outline btn-block biz-secondary-btn" type="submit">@CatalogLocalizer.Loc("Agregar servicio", "Add service")</button>
        </form>

        <h3 id="biz-amenities" class="section-title biz-section-title">@CatalogLocalizer.Loc("Amenities", "Amenities")</h3>
        <div class="amenity-grid biz-amenity-grid">
            @foreach (var a in Model.Amenities)
            {
                <div class="amenity-item"><span>@a.Icon</span><span>@a.Label</span></div>
            }
        </div>
        <form method="post" asp-page-handler="AddAmenity" class="biz-inline-add">
            <input class="form-control" asp-for="NewAmenityIcon" style="width:70px" placeholder="🎥" />
            <input class="form-control" asp-for="NewAmenityLabel" placeholder="@CatalogLocalizer.Loc("Cámaras 24/7", "24/7 cameras")" />
            <button class="btn btn-outline biz-icon-btn" type="submit">+</button>
        </form>

        <h3 id="biz-extras" class="section-title biz-section-title">@CatalogLocalizer.Loc("Extras", "Extras")</h3>
        <div class="biz-list">
            @foreach (var e in Model.Extras)
            {
                <article class="biz-item-card biz-item-card--row">
                    <strong>@e.Name</strong>
                    <span class="price">+$@e.Price.ToString("0")</span>
                </article>
            }
        </div>
        <form method="post" asp-page-handler="AddExtra" class="biz-inline-add">
            <input class="form-control" asp-for="NewExtraName" placeholder="@CatalogLocalizer.Loc("Baño adicional", "Extra bath")" />
            <input class="form-control" asp-for="NewExtraPrice" style="width:100px" step="0.01" />
            <button class="btn btn-outline biz-icon-btn" type="submit">+</button>
        </form>
    </div>
    <div class="bottom-nav-clearance" aria-hidden="true"></div>
</div>

@section Scripts {
    <partial name="_GooglePlaces" />
    <script>
        document.querySelectorAll('.biz-cat-card').forEach(function (card) {
            card.addEventListener('click', function () {
                setTimeout(function () {
                    var input = card.querySelector('input[type=checkbox]');
                    if (!input) return;
                    card.classList.toggle('active', !!input.checked);
                }, 0);
            });
        });
    </script>
}
