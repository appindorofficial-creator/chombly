@page
@model WebAppPet.Pages.Groomer.DashboardModel
@{
    ViewData["Title"] = CatalogLocalizer.Loc("Panel del negocio", "Business panel");
    ViewData["GroomerTab"] = "dashboard";
    ViewData["LangCompact"] = true;
    ViewData["OnboardShowNotif"] = true;
    ViewData["OnboardNotifReturn"] = "/Groomer/Dashboard";
}
<div class="onboard onboard-app">
    <partial name="_OnboardTop" />
    <div class="home-body">
    <partial name="_GroomerNav" />

    @if (Model.JustRegistered || Model.Profile?.PublishStatus == BusinessPublishStatus.PendingReview)
    {
        <div class="card card-pad" style="margin-bottom:14px;background:var(--brand-soft)">
            <strong>@L["Biz_CompleteVerification"]</strong>
            <p class="muted small" style="margin:6px 0 10px">@CatalogLocalizer.Loc("Licencias, seguro y banco ayudan a publicar más rápido.", "Licenses, insurance, and banking help you publish faster.")</p>
            <a class="btn btn-primary btn-block" asp-page="./Verification">@CatalogLocalizer.Loc("Ver checklist", "See checklist")</a>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.Flash))
    {
        <div class="alert alert-info">@Model.Flash</div>
    }

    @if (Model.Profile != null)
    {
        <div class="card card-pad" style="margin-bottom:14px">
            <h3 style="margin:0 0 6px">@CatalogLocalizer.Loc("Estado de publicación", "Publish status")</h3>
            @switch (Model.Profile.PublishStatus)
            {
                case BusinessPublishStatus.Approved:
                    <p class="muted small" style="margin:0">@CatalogLocalizer.Loc("✓ Publicado — los clientes ya pueden encontrarte.", "✓ Published — customers can find you now.")</p>
                    break;
                case BusinessPublishStatus.PendingReview:
                    <p class="muted small" style="margin:0">@CatalogLocalizer.Loc("⏳ En revisión — completa agenda y perfil mientras esperas.", "⏳ Under review — finish your agenda and profile while you wait.")</p>
                    break;
                case BusinessPublishStatus.Rejected:
                    <p class="muted small" style="margin:0">@CatalogLocalizer.Loc("No aprobado. Mejora tu perfil y vuelve a enviar.", "Not approved. Improve your profile and resubmit.")</p>
                    <form method="post" asp-page-handler="Resubmit" style="margin-top:8px">
                        <button class="btn btn-primary btn-block" type="submit">@CatalogLocalizer.Loc("Reenviar a revisión", "Resubmit for review")</button>
                    </form>
                    break;
                default:
                    <p class="muted small" style="margin:0">@CatalogLocalizer.Loc("Borrador — termina tu configuración.", "Draft — finish your setup.")</p>
                    break;
            }
            <div class="muted small" style="margin-top:8px">
                @CatalogLocalizer.Loc("Agenda", "Agenda"): @Model.OpenWeekDays @CatalogLocalizer.Loc("días abiertos/semana", "open days/week") · @L["Groomer_Services"]: @Model.ServiceCount
                · <a asp-page="./Availability">@CatalogLocalizer.Loc("Editar agenda", "Edit agenda")</a>
                · <a asp-page="./Business">@CatalogLocalizer.Loc("Editar negocio", "Edit business")</a>
            </div>
        </div>
    }

    <h2 style="margin:0 0 4px">@string.Format(L["Home_HeroHello"].Value, Model.Profile?.User.FullName)</h2>
    <p class="muted small" style="margin:0 0 16px">
        @Model.Profile?.BusinessName
        @if (Model.OfferedCategories.Count > 0)
        {
            <span>· @string.Join(" · ", Model.OfferedCategories.Select(c => $"{c.Emoji} {c.DisplayName()}"))</span>
        }
    </p>

    <div class="promo-banner" style="margin-top:0">
        <div style="flex:1">
            <span class="small" style="opacity:.85">@CatalogLocalizer.Loc("Ingresos de hoy", "Today's earnings")</span>
            <strong style="font-size:1.6rem">$@Model.TodayIncome.ToString("0.00")</strong>
            <span class="small">@Model.TodayCompleted @CatalogLocalizer.Loc("citas completadas", "completed bookings")</span>
        </div>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:16px">
        <div class="card card-pad" style="text-align:center">
            <div style="font-size:1.6rem;font-weight:900;color:var(--purple)">@Model.UpcomingCount</div>
            <div class="muted small">@L["Appt_Upcoming"]</div>
        </div>
        <a class="card card-pad" style="text-align:center" asp-page="./Appointments" asp-route-tab="requests">
            <div style="font-size:1.6rem;font-weight:900;color:var(--purple)">@Model.PendingCount</div>
            <div class="muted small">@CatalogLocalizer.Loc("Nuevas solicitudes", "New requests")</div>
        </a>
    </div>

    <h3 class="section-title">@CatalogLocalizer.Loc("Agenda próxima", "Upcoming agenda")</h3>
    @if (!Model.Upcoming.Any())
    {
        <div class="empty">@CatalogLocalizer.Loc("No hay citas próximas.", "No upcoming bookings.")</div>
    }
    @foreach (var a in Model.Upcoming)
    {
        <div class="appt-card">
            <div class="row">
                <img src="@PetSpecies.PhotoOrDefault(a.Pet.PhotoUrl, a.Pet.Species)" alt="@a.Pet.Name" style="border-radius:50%" />
                <div style="flex:1">
                    <strong>@a.Pet.Name · @CatalogLocalizer.Text(a.Service.Name)</strong>
                    <div class="muted small">@a.Client.FullName</div>
                    <div class="muted small">@a.ScheduledAt.ToString("ddd d MMM · h:mm tt")</div>
                </div>
                <span class="badge @(a.Status == AppointmentStatus.Confirmed ? "badge-green" : "badge-orange")">
                    @(a.Status == AppointmentStatus.Confirmed ? L["Appt_Status_Confirmed"].Value : L["Appt_Status_Pending"].Value)
                </span>
            </div>
        </div>
    }
    </div>
    <div class="bottom-nav-clearance" aria-hidden="true"></div>
</div>
