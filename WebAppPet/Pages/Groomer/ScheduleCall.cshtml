@page
@model WebAppPet.Pages.Groomer.ScheduleCallModel
@{
    ViewData["Title"] = CatalogLocalizer.Loc("Agendar llamada", "Schedule call");
    ViewData["GroomerTab"] = "dashboard";
    ViewData["LangCompact"] = true;
}
<div class="onboard onboard-app">
    <partial name="_OnboardTop" />
    <div class="home-body">
    <partial name="_GroomerNav" />
    <a class="back-btn" asp-page="./Verification" style="margin-bottom:8px;display:inline-block">←</a>
    <h2 style="margin:0 0 6px">@CatalogLocalizer.Loc("Agendar llamada", "Schedule call")</h2>
    <p class="muted small">@CatalogLocalizer.Loc("Un especialista te ayuda con verificación, seguro y cobros.", "A specialist helps with verification, insurance, and payouts.")</p>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert alert-info">@Model.Message</div>
        <a class="btn btn-primary btn-block" asp-page="./Dashboard">@L["Biz_GoDashboard"]</a>
    }
    else
    {
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }
        <form method="post">
            <h3 class="section-title">@CatalogLocalizer.Loc("Día", "Day")</h3>
            <div class="when-row" style="flex-wrap:wrap">
                @foreach (var d in Model.Days)
                {
                    var key = d.ToString("yyyy-MM-dd");
                    <label class="when-chip @(Model.Day == key ? "active" : "")">
                        <input type="radio" name="Day" value="@key" @(Model.Day == key ? "checked" : "") />
                        @d.ToString("ddd d")
                    </label>
                }
            </div>
            <h3 class="section-title">@L["Biz_Hours"]</h3>
            <div class="slot-grid" style="margin-bottom:14px">
                @foreach (var t in Model.Slots)
                {
                    <label>
                        <input type="radio" name="Slot" value="@t" @(Model.Slot == t ? "checked" : "") />
                        <div class="slot">@t</div>
                    </label>
                }
            </div>
            <button class="btn btn-primary btn-block" type="submit">@CatalogLocalizer.Loc("Confirmar llamada", "Confirm call")</button>
        </form>
    }
    </div>
    <div class="bottom-nav-clearance" aria-hidden="true"></div>
</div>
