@page
@model WebAppPet.Pages.Groomer.VerificationModel
@{
    ViewData["Title"] = L["Groomer_Verification"].Value;
    ViewData["GroomerTab"] = "dashboard";
    ViewData["LangCompact"] = true;
    var g = Model.Profile!;
}
<div class="onboard onboard-app">
    <partial name="_OnboardTop" />
    <div class="home-body">
    <partial name="_GroomerNav" />
    <h2 style="margin:0 0 6px">@CatalogLocalizer.Loc("Verificación del negocio", "Business verification")</h2>
    <p class="muted small">@Model.DoneCount @CatalogLocalizer.Loc("de", "of") @Model.TotalCount @CatalogLocalizer.Loc("pasos · acelera la publicación", "steps · speeds up publishing")</p>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert alert-info">@Model.Message</div>
    }

    <div class="card card-pad" style="margin-bottom:14px">
        <div class="verify-row">
            <div>
                <strong>@CatalogLocalizer.Loc("Información del negocio", "Business info")</strong>
                <div class="muted small">@CatalogLocalizer.Loc("Nombre, ciudad y categoría", "Name, city, and category")</div>
            </div>
            <span class="badge badge-green">@CatalogLocalizer.Loc("Listo", "Done")</span>
        </div>
        <div class="verify-row">
            <div>
                <strong>@CatalogLocalizer.Loc("Identidad", "Identity")</strong>
                <div class="muted small">@CatalogLocalizer.Loc("Cuenta y datos de contacto", "Account and contact details")</div>
            </div>
            @if (g.VerifiedIdentity)
            {
                <span class="badge badge-green">@CatalogLocalizer.Loc("Listo", "Done")</span>
            }
            else
            {
                <form method="post" asp-page-handler="Mark"><input type="hidden" name="item" value="identity" /><button class="btn btn-outline btn-sm" type="submit">@CatalogLocalizer.Loc("Marcar", "Mark")</button></form>
            }
        </div>
        <div class="verify-row">
            <div>
                <strong>@CatalogLocalizer.Loc("Licencias", "Licenses")</strong>
                <div class="muted small">@CatalogLocalizer.Loc("Permisos locales / profesionales", "Local / professional permits")</div>
            </div>
            @if (g.VerifiedLicense)
            {
                <span class="badge badge-green">@CatalogLocalizer.Loc("Listo", "Done")</span>
            }
            else
            {
                <form method="post" asp-page-handler="Mark"><input type="hidden" name="item" value="license" /><button class="btn btn-outline btn-sm" type="submit">@CatalogLocalizer.Loc("Marcar", "Mark")</button></form>
            }
        </div>
        <div class="verify-row">
            <div>
                <strong>@CatalogLocalizer.Loc("Seguro", "Insurance")</strong>
                <div class="muted small">@CatalogLocalizer.Loc("Cobertura de responsabilidad", "Liability coverage")</div>
            </div>
            @if (g.VerifiedInsurance)
            {
                <span class="badge badge-green">@CatalogLocalizer.Loc("Listo", "Done")</span>
            }
            else
            {
                <form method="post" asp-page-handler="Mark"><input type="hidden" name="item" value="insurance" /><button class="btn btn-outline btn-sm" type="submit">@CatalogLocalizer.Loc("Marcar", "Mark")</button></form>
            }
        </div>
        <div class="verify-row">
            <div>
                <strong>@CatalogLocalizer.Loc("Cuenta bancaria", "Bank account")</strong>
                <div class="muted small">@CatalogLocalizer.Loc("Para recibir pagos", "To receive payouts")</div>
            </div>
            @if (g.VerifiedBank)
            {
                <span class="badge badge-green">@CatalogLocalizer.Loc("Listo", "Done")</span>
            }
            else
            {
                <form method="post" asp-page-handler="Mark"><input type="hidden" name="item" value="bank" /><button class="btn btn-outline btn-sm" type="submit">@CatalogLocalizer.Loc("Marcar", "Mark")</button></form>
            }
        </div>
    </div>

    <a class="btn btn-primary btn-block" asp-page="./ScheduleCall">@CatalogLocalizer.Loc("Agendar llamada con Chombly", "Schedule a call with Chombly")</a>
    <a class="btn btn-outline btn-block" asp-page="./Dashboard" style="margin-top:10px">@CatalogLocalizer.Loc("Volver al panel", "Back to dashboard")</a>
    </div>
    <div class="bottom-nav-clearance" aria-hidden="true"></div>
</div>
