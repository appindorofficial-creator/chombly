@{
    var current = (string?)ViewData["GroomerTab"] ?? "";
    var cats = ViewData["ProviderCategories"] as IList<string>
        ?? (ViewData["ProviderCategory"] is string one && !string.IsNullOrEmpty(one)
            ? one.Split(" · ", StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList()
            : null);
}
<div class="provider-banner">
    <strong>@L["Profile_BusinessPanel"]</strong>
    @if (cats is { Count: > 0 })
    {
        <span class="provider-cat-badges">
            @foreach (var cat in cats)
            {
                <span class="badge badge-purple">@cat</span>
            }
        </span>
    }
</div>
<div class="tabs tabs-wrap" style="margin-bottom:16px">
    <a class="@(current == "dashboard" ? "active" : "")" asp-page="/Groomer/Dashboard">@L["Nav_Home"]</a>
    <a class="@(current == "appointments" ? "active" : "")" asp-page="/Groomer/Appointments">@L["Groomer_Bookings"]</a>
    <a class="@(current == "availability" ? "active" : "")" asp-page="/Groomer/Availability">@L["Groomer_Agenda"]</a>
    <a class="@(current == "business" ? "active" : "")" asp-page="/Groomer/Business">@L["Biz_Business"]</a>
    <a class="@(current == "analytics" ? "active" : "")" asp-page="/Groomer/Analytics">@L["Groomer_Analytics"]</a>
    <a class="@(current == "onboarding" ? "active" : "")" asp-page="/Professional/Onboarding">@L["Groomer_Onboarding"]</a>
    <a class="@(current == "payouts" ? "active" : "")" asp-page="/Professional/Payouts">@L["Groomer_Payouts"]</a>
</div>
