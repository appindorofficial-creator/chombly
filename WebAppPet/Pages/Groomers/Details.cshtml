@page "{id:int}"
@model WebAppPet.Pages.Groomers.DetailsModel
@using WebAppPet.Services
@{
    ViewData["Title"] = Model.Groomer?.BusinessName ?? L["Detail_Business"].Value;
    ViewData["LangCompact"] = true;
}
@if (Model.Groomer == null)
{
    <div class="empty">@L["Detail_NotFound"]</div>
}
else
{
    var g = Model.Groomer;
    var thumb = CatalogImages.Business(g.ImageUrl, g.Category?.Slug);
    var fallback = CatalogImages.Category(g.Category?.Slug);
    <div class="hero-photo">
        <img src="~@thumb" asp-append-version="true" alt="@g.BusinessName"
             onerror="this.onerror=null;this.src='@fallback';" />
        <div class="actions">
            <a class="icon-btn"
               asp-page="./Index"
               asp-route-category="@g.Category?.Slug"
               asp-route-service="@Model.Service"
               aria-label="@CatalogLocalizer.Loc("Volver", "Back")"
               title="@CatalogLocalizer.Loc("Volver al listado", "Back to list")">
                <svg class="ui-ico" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M15.41 7.41 14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
            </a>
            <partial name="_FavoriteHeart" model="(g.Id, Model.IsFavorite, (string?)null)" />
        </div>
    </div>
    <div class="detail-body">
        <div class="detail-sheet">
            <h2 style="margin:0 0 6px">
                @g.BusinessName
                @if (g.IsVerified) { <span style="color:var(--brand)">✓</span> }
            </h2>
            <div class="meta-row">
                @if (g.ReviewCount > 0)
                {
                    <span class="stars">★ @g.Rating.ToString("0.0")</span>
                    <span>(@g.ReviewCount @L["Detail_Reviews"])</span>
                }
                @if (g.Category != null)
                {
                    <span class="badge badge-purple">@g.Category.Emoji @g.Category.DisplayName()</span>
                }
            </div>
            <p class="muted small">📍 @(string.IsNullOrEmpty(g.Address) ? g.City : g.Address)</p>

            <div class="chip-row">
                @foreach (var s in g.AcceptedSpeciesList)
                {
                    <span class="badge badge-purple">@PetSpecies.Emoji(s) @PetSpecies.Label(s)</span>
                }
                @if (g.AcceptsSeniorPets) { <span class="badge badge-green">@L["Detail_SeniorPets"]</span> }
                @if (g.AcceptsAnxiousPets) { <span class="badge badge-green">@L["Detail_AnxiousPets"]</span> }
            </div>

            @if (Model.Amenities.Any())
            {
                <div class="amenity-grid">
                    @foreach (var a in Model.Amenities)
                    {
                        <div class="amenity-item">
                            <span class="amenity-ico">@Model.AmenityIcon(a.Icon)</span>
                            <span>@CatalogLocalizer.Text(a.Label)</span>
                        </div>
                    }
                </div>
            }

            <div class="quick-actions">
                @if (!string.IsNullOrEmpty(g.Phone))
                {
                    <a href="tel:@g.Phone"><div class="circle">📞</div>@L["Detail_Call"]</a>
                }
                <a asp-page="/Chat/Index" asp-route-groomerId="@g.Id" asp-route-returnUrl="@Url.Page("/Groomers/Details", new { id = g.Id })"><div class="circle">💬</div>@L["Detail_Message"]</a>
                @if (!string.IsNullOrEmpty(g.Address))
                {
                    <a href="https://maps.google.com/?q=@Uri.EscapeDataString(g.Address)" target="_blank" rel="noopener"><div class="circle">🗺️</div>@L["Detail_Map"]</a>
                }
                @if (!string.IsNullOrEmpty(g.Website))
                {
                    <a href="@g.Website" target="_blank" rel="noopener"><div class="circle">🌐</div>@L["Detail_Web"]</a>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(g.About))
            {
                <h3 class="section-title" style="margin-top:8px">@L["Detail_About"]</h3>
                <p class="muted" style="line-height:1.5">@CatalogLocalizer.Text(g.About)</p>
            }

            <h3 class="section-title">@L["Detail_ServicesPrices"]</h3>
            @if (Model.Services.Any())
            {
                <div class="detail-services">
                @foreach (var s in Model.Services)
                {
                    var highlighted = Model.PrefillServiceId == s.Id
                        || (!string.IsNullOrWhiteSpace(Model.Service)
                            && s.Name.Contains(Model.Service, StringComparison.OrdinalIgnoreCase));
                    <a class="detail-service-btn @(highlighted ? "is-highlighted" : "")"
                       asp-page="/Booking/Index" asp-route-groomerId="@g.Id" asp-route-serviceId="@s.Id" asp-route-service="@Model.Service">
                        <span class="detail-service-copy">
                            <strong>@CatalogLocalizer.Text(s.Name)</strong>
                            @if (!string.IsNullOrWhiteSpace(s.Description))
                            {
                                <span class="muted small">@CatalogLocalizer.Text(s.Description)</span>
                            }
                        </span>
                        <span class="detail-service-meta">
                            <span class="price">@L["Home_FromPrice"] $@s.PriceSmall.ToString("0")@CatalogLocalizer.Text(Model.UnitLabel(s.BillingUnit))</span>
                            <span class="detail-service-cta" aria-hidden="true">@L["Common_Book"] ›</span>
                        </span>
                    </a>
                }
                </div>
            }
            else
            {
                <div class="empty">@L["Detail_NoServices"]</div>
            }

            @if (Model.Extras.Any())
            {
                <h3 class="section-title">@L["Detail_Extras"]</h3>
                @foreach (var e in Model.Extras)
                {
                    <div class="card card-pad" style="margin-bottom:8px;display:flex;justify-content:space-between">
                        <div>
                            <strong>@CatalogLocalizer.Text(e.Name)</strong>
                            @if (!string.IsNullOrEmpty(e.Description))
                            {
                                <div class="muted small">@CatalogLocalizer.Text(e.Description)</div>
                            }
                        </div>
                        <span class="price">+$@e.Price.ToString("0")</span>
                    </div>
                }
            }

            @if (Model.Photos.Any())
            {
                <h3 class="section-title">@L["Detail_BeforeAfter"]</h3>
                @foreach (var ph in Model.Photos)
                {
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px">
                        <div>
                            <img src="@ph.BeforeUrl" alt="@L["Detail_Before"]" style="border-radius:14px;aspect-ratio:1;object-fit:cover;width:100%" />
                            <p class="muted small" style="text-align:center;margin:4px 0 0">@L["Detail_Before"]</p>
                        </div>
                        <div>
                            <img src="@ph.AfterUrl" alt="@L["Detail_After"]" style="border-radius:14px;aspect-ratio:1;object-fit:cover;width:100%" />
                            <p class="muted small" style="text-align:center;margin:4px 0 0">@L["Detail_After"]</p>
                        </div>
                    </div>
                }
            }

            @{
                var writeHref = Model.CanWriteReview
                    ? Url.Page("/Reviews/Write", new
                    {
                        groomerId = g.Id,
                        returnUrl = Url.Page("/Groomers/Details", new { id = g.Id, category = g.Category?.Slug, service = Model.Service })
                    })
                    : null;
            }
            <partial name="_ReviewsSection" model="new WebAppPet.Pages.Shared.ReviewsSectionModel {
                Reviews = Model.Reviews,
                Rating = (decimal)g.Rating,
                ReviewCount = g.ReviewCount,
                WriteHref = writeHref
            }" />
        </div>
    </div>
    <div class="sticky-cta">
        <a class="btn btn-primary btn-block"
           asp-page="/Booking/Index"
           asp-route-groomerId="@g.Id"
           asp-route-serviceId="@Model.PrefillServiceId"
           asp-route-service="@Model.Service">
            @L["Common_Book"]
        </a>
    </div>
}
