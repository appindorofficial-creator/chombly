@page
@model WebAppPet.Pages.Groomers.IndexModel
@using WebAppPet.Services
@{
    var catName = Model.ActiveCategory?.DisplayName();
    ViewData["Title"] = catName ?? L["Search_Title"].Value;
    var title = Model.ActiveCategory != null
        ? $"{Model.ActiveCategory.Emoji} {catName}"
        : L["Search_ServicesTitle"].Value;
    ViewData["LangCompact"] = true;
    ViewData["OnboardBackHref"] = Url.Page("/Index");
    ViewData["BodyClass"] = "page-groomers";
}
<div class="onboard onboard-app groomers-index">
    <partial name="_OnboardTop" />
    <div class="home-body hotel-flow">
        <header class="groomers-head">
            <h1 class="app-page-heading">@title</h1>
            <p class="muted small groomers-lead">
                @(Model.ActiveCategory != null
                    ? Model.ActiveCategory.DisplaySubtitle()
                    : CatalogLocalizer.Loc("Encuentra el cuidado ideal cerca de ti", "Find the right care near you"))
            </p>
        </header>

    <form method="get" class="search-box" data-soft-filter>
        <input class="form-control" name="q" value="@Model.Q" placeholder="@L["Search_Businesses"]" autocomplete="off" />
        <input class="form-control" name="city" value="@Model.City" data-places="city" data-places-fill="city"
               placeholder="@L["Search_CityMaps"]" autocomplete="off" />
        <input type="hidden" name="category" value="@Model.Category" />
        <input type="hidden" name="species" value="@Model.Species" />
        <input type="hidden" name="customType" value="@Model.CustomType" />
        <input type="hidden" name="service" value="@Model.Service" />
        <button class="btn btn-primary" type="submit">@L["Search_Go"]</button>
    </form>

    <div class="filter-bar groomers-filters">
        <a class="chip @(string.IsNullOrEmpty(Model.Category) ? "active" : "")"
           asp-page="./Index" asp-route-q="@Model.Q" asp-route-species="@Model.Species" asp-route-customType="@Model.CustomType" asp-route-city="@Model.City">@L["Search_AllCategories"]</a>
        @foreach (var c in Model.Categories)
        {
            var listPage = c.Slug switch
            {
                "hotel" => "/Hotel/Index",
                "vet" => "/Vet/Index",
                "daycare" => "/Daycare/Index",
                "walkers" => "/Walkers/Index",
                "trainers" => "/Trainers/Index",
                _ => "./Index"
            };
            <a class="chip @(Model.Category == c.Slug ? "active" : "")"
               asp-page="@listPage"
               asp-route-category="@(c.Slug is "hotel" or "vet" or "daycare" or "walkers" or "trainers" ? null : c.Slug)"
               asp-route-q="@Model.Q"
               asp-route-species="@Model.Species"
               asp-route-customType="@Model.CustomType"
               asp-route-city="@Model.City">@c.Emoji @c.DisplayName()</a>
        }
    </div>

    <div class="filter-bar groomers-filters">
        <span class="filter-label">@L["Search_Pet"]</span>
        <a class="chip @(string.IsNullOrEmpty(Model.Species) ? "active" : "")"
           asp-page="./Index" asp-route-category="@Model.Category" asp-route-q="@Model.Q" asp-route-city="@Model.City">@L["Search_AllPets"]</a>
        @foreach (var sp in PetSpecies.All.Take(5))
        {
            <a class="chip chip-species @(Model.Species == sp.Value ? "active" : "")"
               asp-page="./Index"
               asp-route-category="@Model.Category"
               asp-route-species="@sp.Value"
               asp-route-q="@Model.Q"
               asp-route-city="@Model.City">
                <img src="~@PetSpecies.IconPath(sp.Value)" asp-append-version="true" alt="" class="chip-species-img" />
                @(CultureCookie.IsEnglish() ? sp.LabelEn : sp.Label)
            </a>
        }
        @if (string.Equals(Model.Species, PetSpecies.Other, StringComparison.OrdinalIgnoreCase))
        {
            var otherLabel = string.IsNullOrWhiteSpace(Model.CustomType)
                ? PetSpecies.DisplayLabel(PetSpecies.Other)
                : Model.CustomType;
            <span class="chip active">🐾 @otherLabel</span>
        }
        <a class="chip @(Model.AvailableToday ? "active" : "")"
           asp-page="./Index"
           asp-route-category="@Model.Category"
           asp-route-species="@Model.Species"
           asp-route-customType="@Model.CustomType"
           asp-route-availableToday="true"
           asp-route-q="@Model.Q"
           asp-route-city="@Model.City">@L["Search_AvailableToday"]</a>
    </div>

    @if (!Model.HasUserLocation)
    {
        <p class="muted small groomers-loc" id="loc-hint">@L["Search_EnableLocation"] <button type="button" class="link-btn" id="btn-loc">@L["Search_UseMyLocation"]</button></p>
    }

    <h3 class="section-title groomers-results-title" id="groomers-results">@string.Format(L["Search_Results"].Value, Model.Results.Count)</h3>

    <div class="groomers-list">
    @foreach (var item in Model.Results)
    {
        var g = item.Business;
        var isFav = Model.FavoriteIds.Contains(g.Id);
        var thumb = CatalogImages.Business(g.ImageUrl, g.Category?.Slug);
        var fallback = CatalogImages.Category(g.Category?.Slug);
        <div class="groomer-card-wrap">
            <a class="groomer-card" asp-page="./Details" asp-route-id="@g.Id" asp-route-service="@Model.Service">
                <img src="~@thumb" asp-append-version="true" alt="@g.BusinessName"
                     onerror="this.onerror=null;this.src='@fallback';" />
                <div class="info">
                    <h3>@g.BusinessName</h3>
                    <div class="meta-row">
                        @if (g.Category != null)
                        {
                            <span class="badge badge-purple">@g.Category.DisplayName()</span>
                        }
                        @if (g.ReviewCount > 0)
                        {
                            <span class="stars">★ @g.Rating.ToString("0.0")</span>
                            <span>(@g.ReviewCount)</span>
                        }
                    </div>
                    <div class="meta-row species-row">
                        @foreach (var s in g.AcceptedSpeciesList.Take(4))
                        {
                            <span class="species-mini" title="@PetSpecies.Label(s)">@PetSpecies.Emoji(s)</span>
                        }
                    </div>
                    <div class="meta-row meta-price">
                        <span>@(item.DistanceLabel ?? (string.IsNullOrEmpty(g.City) ? g.Address : g.City))</span>
                        @if (g.StartingPrice > 0)
                        {
                            <span class="price">@L["Home_FromPrice"] $@g.StartingPrice.ToString("0")@(string.IsNullOrEmpty(g.PriceUnit) ? "" : $" {CatalogLocalizer.Text(g.PriceUnit)}")</span>
                        }
                    </div>
                    @if (item.AvailableToday)
                    {
                        <span class="badge badge-green">@L["Search_AvailableToday"]</span>
                    }
                    else
                    {
                        <span class="badge badge-gray">@L["Search_NotAvailableToday"]</span>
                    }
                </div>
            </a>
            <partial name="_FavoriteHeart" model="(g.Id, isFav, (string?)null)" />
        </div>
    }
    </div>

    @if (!Model.Results.Any())
    {
        <div class="empty empty-chombly groomers-empty">
            <h2>@L["Search_Empty"]</h2>
            <p class="muted small">@CatalogLocalizer.Loc("Prueba otra categoría, ciudad o mascota.", "Try another category, city, or pet.")</p>
        </div>
    }

    <aside class="trust-banner pets-trust" data-trust-banner aria-label="@CatalogLocalizer.Loc("Confianza Chombly", "Chombly trust")">
        <div class="pets-tip-orb" aria-hidden="true"></div>
        <div class="pets-tip-orb pets-tip-orb--2" aria-hidden="true"></div>
        <p class="pets-tip-kicker">@CatalogLocalizer.Loc("Tip Chombly", "Chombly tip")</p>
        <div class="trust-banner-viewport">
            <div class="trust-banner-item is-active" data-trust-item aria-hidden="false">
                <span class="trust-banner-ico" aria-hidden="true">✂️</span>
                <span class="trust-banner-copy">
                    <strong>@CatalogLocalizer.Loc("Peluqueros verificados", "Verified groomers")</strong>
                    <small>@CatalogLocalizer.Loc("Negocios revisados por Chombly", "Businesses reviewed by Chombly")</small>
                </span>
            </div>
            <div class="trust-banner-item" data-trust-item aria-hidden="true">
                <span class="trust-banner-ico" aria-hidden="true">🔒</span>
                <span class="trust-banner-copy">
                    <strong>@CatalogLocalizer.Loc("Reservas seguras", "Secure bookings")</strong>
                    <small>@CatalogLocalizer.Loc("Tu pago y datos están protegidos", "Your payment and data stay protected")</small>
                </span>
            </div>
            <div class="trust-banner-item" data-trust-item aria-hidden="true">
                <span class="trust-banner-ico" aria-hidden="true">📅</span>
                <span class="trust-banner-copy">
                    <strong>@CatalogLocalizer.Loc("Disponibilidad clara", "Clear availability")</strong>
                    <small>@CatalogLocalizer.Loc("Filtra por hoy y agenda más rápido", "Filter by today and book faster")</small>
                </span>
            </div>
            <div class="trust-banner-item" data-trust-item aria-hidden="true">
                <span class="trust-banner-ico" aria-hidden="true">💚</span>
                <span class="trust-banner-copy">
                    <strong>@CatalogLocalizer.Loc("Cuidado con cariño", "Care with heart")</strong>
                    <small>@CatalogLocalizer.Loc("Elige por especie, ciudad y reseñas", "Choose by species, city, and reviews")</small>
                </span>
            </div>
        </div>
        <div class="trust-banner-dots" data-trust-dots aria-hidden="true"></div>
    </aside>
    </div>
    <div class="bottom-nav-clearance" aria-hidden="true"></div>
</div>

@section Scripts {
<script>
(function () {
  const btn = document.getElementById('btn-loc');
  if (!btn || !navigator.geolocation) return;
  const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
  const failMsg = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Search_LocationFail"].Value));

  function reverseCity(lat, lng) {
    return new Promise(function (resolve) {
      if (!(window.google && google.maps && google.maps.Geocoder)) {
        resolve(null);
        return;
      }
      try {
        new google.maps.Geocoder().geocode({ location: { lat: lat, lng: lng } }, function (results, status) {
          if (status !== 'OK' || !results || !results[0]) {
            resolve(null);
            return;
          }
          var comps = results[0].address_components || [];
          var city = '', state = '';
          comps.forEach(function (c) {
            var t = c.types || [];
            if (t.indexOf('locality') >= 0) city = c.long_name;
            if (t.indexOf('sublocality') >= 0 && !city) city = c.long_name;
            if (t.indexOf('administrative_area_level_1') >= 0) state = c.short_name;
          });
          resolve([city, state].filter(Boolean).join(', ') || null);
        });
      } catch (_) {
        resolve(null);
      }
    });
  }

  btn.addEventListener('click', () => {
    navigator.geolocation.getCurrentPosition(async (pos) => {
      const lat = pos.coords.latitude;
      const lng = pos.coords.longitude;
      const city = await reverseCity(lat, lng);
      const body = new URLSearchParams();
      body.set('lat', String(lat));
      body.set('lng', String(lng));
      if (city) body.set('city', city);
      await fetch('/Account/Location', {
        method: 'POST',
        headers: { 'RequestVerificationToken': token || '', 'Content-Type': 'application/x-www-form-urlencoded' },
        body,
        credentials: 'same-origin'
      });
      location.reload();
    }, () => alert(failMsg));
  });
})();
</script>
<partial name="_GooglePlaces" />
}
