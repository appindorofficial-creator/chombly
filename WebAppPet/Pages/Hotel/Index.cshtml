@page
@using WebAppPet.Pages.Shared
@model WebAppPet.Pages.Hotel.IndexModel
@{
    var configureHref = BookingCheckoutUrls.ForPage(ViewContext, pay: false);
    var checkoutHref = BookingCheckoutUrls.ForPage(ViewContext, pay: true);
    var showCheckout = Model.Pay && (Model.SelectedHotel != null && Model.SelectedPet != null);
    var showSticky = !Model.Pay && (Model.SelectedHotel != null && Model.SelectedPet != null);

    ViewData["Title"] = L["Hotel_Title"].Value;
    ViewData["LangCompact"] = true;
    ViewData["OnboardBackHref"] = Model.Pay ? configureHref : Url.Page("/Index");
    var minDate = AppTimeZones.TodayLocalDate().ToString("yyyy-MM-dd");
    var minCheckout = AppTimeZones.TodayLocalDate().AddDays(1).ToString("yyyy-MM-dd");
}
<div class="onboard onboard-app">
    <partial name="_OnboardTop" />
    <div class="home-body hotel-flow @(showSticky ? "has-checkout-sticky" : null) @(showCheckout ? "is-checkout" : null)">
        @if (showCheckout)
        {
            <h1 class="app-page-heading">@CatalogLocalizer.Loc("Confirmar y pagar", "Confirm and pay")</h1>
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger">@Model.ErrorMessage</div>
            }
        }
        else
        {
        <h1 class="app-page-heading">@L["Hotel_Title"]</h1>
        <p class="muted small">@L["Book_AllInOne"]</p>
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    <form method="get" id="hotel-filter-form">
        <input type="hidden" name="groomerId" value="@(Model.CanSelectHotel ? Model.GroomerId : null)" />
        <input type="hidden" name="more" value="@(Model.More ? "true" : "false")" />

        <h3 class="section-title" style="margin-top:0">@L["Book_WhenNeeded"]</h3>
        <div class="when-row">
            <label class="when-chip @(Model.When == "hoy" ? "active" : "")">
                <input type="radio" name="When" value="hoy" @(Model.When == "hoy" ? "checked" : "") />
                @L["Book_Today"]
            </label>
            <label class="when-chip @(Model.When == "manana" ? "active" : "")">
                <input type="radio" name="When" value="manana" @(Model.When == "manana" ? "checked" : "") />
                @L["Book_Tomorrow"]
            </label>
            <label class="when-chip @(Model.When == "fechas" ? "active" : "")">
                <input type="radio" name="When" value="fechas" @(Model.When == "fechas" ? "checked" : "") />
                @L["Book_PickDates"]
            </label>
        </div>

        @if (Model.When == "fechas")
        {
            <div class="date-row">
                <div class="form-group" style="flex:1;margin:0">
                    <label class="muted small">@L["Book_CheckIn"]</label>
                    <input class="form-control" type="date" name="CheckIn" value="@Model.CheckIn" min="@minDate" />
                </div>
                <div class="form-group" style="flex:1;margin:0">
                    <label class="muted small">@L["Book_CheckOut"]</label>
                    <input class="form-control" type="date" name="CheckOut" value="@Model.CheckOut" min="@minCheckout" />
                </div>
            </div>
        }
        else
        {
            <input type="hidden" name="CheckIn" value="@Model.CheckIn" />
            <input type="hidden" name="CheckOut" value="@Model.CheckOut" />
            <p class="muted small">@Model.CheckIn → @Model.CheckOut · @Model.Nights @L["Book_Nights"]</p>
        }

        <h3 class="section-title" id="hotel-need-pet">@CatalogLocalizer.Loc("¿Qué mascotas viajan?", "Which pets are staying?")</h3>
        @if (Model.Pets.Any())
        {
            <p class="muted small" style="margin:-6px 0 10px">
                @CatalogLocalizer.Loc("Activa una o varias (máx. 6).", "Turn on one or more (max 6).")
                @if (Model.PetCount > 0)
                {
                    <span>· @Model.PetCount @(Model.PetCount == 1
                        ? CatalogLocalizer.Loc("seleccionada", "selected")
                        : CatalogLocalizer.Loc("seleccionadas", "selected"))</span>
                }
            </p>
            <div class="behavior-pet-list hotel-pet-list" role="group" aria-label="@CatalogLocalizer.Loc("Mascotas", "Pets")">
                @foreach (var p in Model.Pets)
                {
                    var on = Model.PetIds.Contains(p.Id);
                    <label class="behavior-pet-row @(on ? "is-on" : null)">
                        <span class="care-pet-emoji" aria-hidden="true">@PetSpecies.Emoji(p.Species)</span>
                        <span class="care-pet-copy">
                            <strong>@p.Name</strong>
                            <small class="muted">@PetSpecies.Label(p.Species)@(!string.IsNullOrWhiteSpace(p.Breed) ? $" · {p.Breed}" : "")</small>
                        </span>
                        <span class="biz-switch">
                            <input type="checkbox" name="PetIds" value="@p.Id" @(on ? "checked" : null)
                                   @(Model.PetCount >= 6 && !on ? "disabled" : null)
                                   aria-label="@p.Name" />
                            <span class="biz-switch-track" aria-hidden="true"></span>
                        </span>
                    </label>
                }
            </div>
            <a class="apple-text-link" asp-page="/Pets/Create" asp-route-returnUrl="@(ViewContext.HttpContext.Request.Path + ViewContext.HttpContext.Request.QueryString)" style="display:inline-block;margin:8px 0 14px">
                @CatalogLocalizer.Loc("+ Agregar otra mascota", "+ Add another pet")
            </a>
            <input type="hidden" name="PetCount" value="@Model.PetCount" />
            @if (Model.PetId > 0)
            {
                <input type="hidden" name="PetId" value="@Model.PetId" />
            }
        }
        else
        {
            <div class="pet-count-row">
                <a class="btn btn-outline btn-sm" asp-page="/Pets/Create" asp-route-returnUrl="@(ViewContext.HttpContext.Request.Path + ViewContext.HttpContext.Request.QueryString)">@CatalogLocalizer.Loc("+ Mascota", "+ Pet")</a>
                <p class="field-error" style="margin:8px 0 0" role="alert">@CatalogLocalizer.Loc("Necesitas una mascota para reservar.", "You need a pet to continue.")</p>
            </div>
        }

        @if (Model.CanSelectHotel && Model.AllFilterLabels.Any())
        {
            <h3 class="section-title">@CatalogLocalizer.Loc("Filtros", "Filters") <span class="muted small">@CatalogLocalizer.Loc("(opcional)", "(optional)")</span></h3>
            <div class="filter-bar">
                @foreach (var f in Model.AllFilterLabels.Take(6))
                {
                    var on = Model.Filters.Any(x => x.Equals(f, StringComparison.OrdinalIgnoreCase));
                    <label class="chip filter-check @(on ? "active" : "")">
                        <input type="checkbox" name="Filters" value="@f" @(on ? "checked" : "") />
                        @(on ? "✓ " : "")@CatalogLocalizer.Text(f)
                    </label>
                }
            </div>
        }

        <h3 class="section-title" id="hotel-results">@CatalogLocalizer.Loc("Resultados", "Results")</h3>
        @if (!Model.CanSelectHotel)
        {
            var hotelGate = new BookingGateNoteModel
            {
                Id = "hotel-need-pet-gate",
                TextEs = "Selecciona o agrega una mascota para ver hoteles que la atiendan (perro, ave, etc.).",
                TextEn = "Select or add a pet to see hotels that accept them (dog, bird, etc.)."
            };
            <partial name="_BookingGateNote" model="hotelGate" />
        }
        else if (!Model.Results.Any())
        {
            var speciesHint = string.Join(", ", Model.SelectedPets
                .Select(p => PetSpecies.Label(p.Species))
                .Distinct(StringComparer.OrdinalIgnoreCase));
            <div class="empty">@CatalogLocalizer.Loc(
                $"No hay hoteles para {speciesHint} con esos filtros.",
                $"No hotels for {speciesHint} match these filters.")</div>
        }
        else
        {
            @foreach (var item in Model.Results)
            {
                var h = item.Hotel;
                var selected = Model.GroomerId == h.Id;
                <div class="hotel-card @(selected ? "selected" : "")">
                    @if (item.Recommended)
                    {
                        <span class="badge badge-green hotel-reco">@CatalogLocalizer.Text("Recomendado")</span>
                    }
                    <div class="hotel-card-main">
                        <img src="@(h.ImageUrl ?? "/images/pet-other.svg")" alt="@h.BusinessName" />
                        <div class="info">
                            <h3>@h.BusinessName</h3>
                            <div class="meta-row">
                                @if (h.ReviewCount > 0)
                                {
                                    <span class="stars">★ @h.Rating.ToString("0.0")</span>
                                    <span class="muted small">(@h.ReviewCount)</span>
                                }
                                @if (!string.IsNullOrEmpty(item.DistanceLabel))
                                {
                                    <span class="muted small">@item.DistanceLabel</span>
                                }
                            </div>
                            <div class="price">@L["Home_FromPrice"] @AppMoney.Format(item.StartingNight) @CatalogLocalizer.Text("/ noche")</div>
                            <div class="hotel-feats">
                                @foreach (var feat in item.Features)
                                {
                                    <span>@CatalogLocalizer.Text(feat)</span>
                                }
                            </div>
                        </div>
                    </div>
                    <button type="submit"
                            class="btn @(selected ? "btn-primary" : "btn-outline") btn-block"
                            name="groomerId"
                            value="@h.Id"
                            onclick="var hid=this.form.querySelector('input[name=groomerId][type=hidden]'); if(hid){ hid.disabled=false; hid.value=this.value; }">
                        @(selected
                            ? CatalogLocalizer.Loc("Seleccionado ✓", "Selected ✓")
                            : CatalogLocalizer.Loc("Reservar", "Reserve"))
                    </button>
                </div>
            }

            @if (!Model.More && Model.Results.Count >= 3)
            {
                <button type="submit" class="link-btn" name="more" value="true" style="display:block;margin:8px auto 16px">@CatalogLocalizer.Loc("Ver más opciones ▾", "See more options ▾")</button>
            }
        }

        @if (Model.CanSelectHotel && Model.ExtraOptions.Any())
        {
            <h3 class="section-title">@CatalogLocalizer.Loc("Extras", "Extras") <span class="muted small">@CatalogLocalizer.Loc("(opcional)", "(optional)")</span></h3>
            <p class="muted small" style="margin-top:-6px">
                @(Model.SelectedHotel == null
                    ? CatalogLocalizer.Loc("Elige un hotel para ver qué extras ofrece.", "Pick a hotel to see which extras it offers.")
                    : CatalogLocalizer.Loc("Solo puedes elegir extras que ofrece este hotel.", "You can only pick extras this hotel offers."))
            </p>
            <div class="extras-grid">
                @foreach (var e in Model.ExtraOptions)
                {
                    var isMeds = HotelCoreExtras.MatchesMeds(e.Name);
                    var on = e.Available && e.ExtraId is int eid && Model.ExtraIds.Contains(eid);
                    var medsQty = isMeds && on
                        ? (Model.MedsPetIds.Count > 0 ? Model.MedsPetIds.Count : (Model.SelectedPets.Count == 1 ? 1 : 0))
                        : 0;
                    var displayPrice = isMeds && medsQty > 1 ? e.Price * medsQty : e.Price;
                    <div class="extra-block @(isMeds && on && Model.NeedsMedsPetPick ? "has-meds-pets" : null)">
                        <label class="extra-chip @(on ? "active" : "") @(!e.Available ? "is-disabled" : "")"
                               title="@(e.Available
                                   ? CatalogLocalizer.Text(e.Description ?? e.Name)
                                   : CatalogLocalizer.Loc("Este hotel no ofrece este extra", "This hotel doesn’t offer this extra"))">
                            @if (e.Available && e.ExtraId is int extraId)
                            {
                                <input type="checkbox" name="ExtraIds" value="@extraId" @(on ? "checked" : null) />
                            }
                            else
                            {
                                <input type="checkbox" disabled tabindex="-1" />
                            }
                            <span class="extra-chip-copy">
                                <strong>@CatalogLocalizer.Text(e.Name)</strong>
                                @if (!string.IsNullOrWhiteSpace(e.Description))
                                {
                                    <small class="muted">@CatalogLocalizer.Text(e.Description)</small>
                                }
                                else if (HotelCoreExtras.MatchesBath(e.Name))
                                {
                                    <small class="muted">@CatalogLocalizer.Loc("Baño extra durante la estadía", "Extra bath during the stay")</small>
                                }
                                @if (isMeds && e.Available)
                                {
                                    <small class="muted">@CatalogLocalizer.Loc("Precio por mascota", "Priced per pet")</small>
                                }
                            </span>
                            <span class="muted small">
                                +@AppMoney.Format(displayPrice)
                                @if (isMeds && medsQty > 1)
                                {
                                    <text> · @medsQty</text>
                                }
                            </span>
                            @if (!e.Available)
                            {
                                <span class="extra-chip-na">@CatalogLocalizer.Loc("No disponible", "Unavailable")</span>
                            }
                        </label>
                        @if (isMeds && on && Model.NeedsMedsPetPick)
                        {
                            <div class="extra-meds-pets" role="group" aria-label="@CatalogLocalizer.Loc("Mascotas con medicamentos", "Pets needing medication")">
                                <p class="muted small mb-0">@CatalogLocalizer.Loc("¿Para qué mascota(s)?", "Which pet(s)?")</p>
                                <div class="filter-bar filter-bar-wrap" style="margin-top:6px">
                                    @foreach (var p in Model.SelectedPets)
                                    {
                                        var petOn = Model.MedsPetIds.Contains(p.Id);
                                        <label class="chip @(petOn ? "active" : "")">
                                            <input type="checkbox" name="MedsPetIds" value="@p.Id" @(petOn ? "checked" : null) />
                                            @PetSpecies.Emoji(p.Species) @p.Name
                                        </label>
                                    }
                                </div>
                            </div>
                        }
                        else if (isMeds && on && Model.SelectedPets.Count == 1)
                        {
                            <input type="hidden" name="MedsPetIds" value="@Model.SelectedPets[0].Id" />
                        }
                    </div>
                }
            </div>
        }

        <h3 class="section-title">@CatalogLocalizer.Loc("Notas", "Notes")</h3>
        <div class="form-group">
            <textarea class="form-control" name="Notes" rows="3" maxlength="200"
                      placeholder="@CatalogLocalizer.Loc("¿Hay algo que debamos saber?", "Is there anything we should know?")"
                     >@Model.Notes</textarea>
            <div class="muted small" style="text-align:right">@(Model.Notes?.Length ?? 0)/200</div>
        </div>
    </form>

    <partial name="_TrustBanner" />
        }

@if (Model.SelectedHotel != null && Model.SelectedPet != null)
{
    ViewData["PromoCode"] = Model.PromoCode;
    ViewData["PromoSubtotal"] = Model.PromoSubtotal > 0 ? Model.PromoSubtotal : Model.Estimate;
    ViewData["PromoDiscount"] = Model.DiscountAmount;
    ViewData["PromoError"] = Model.PromoError;
    var multi = new List<BookingSummaryMultiHidden>
    {
        new() { Name = "PetIds", Values = Model.PetIds.Select(id => id.ToString()) }
    };
    if (Model.Filters.Count > 0)
        multi.Add(new BookingSummaryMultiHidden { Name = "Filters", Values = Model.Filters });
    if (Model.ExtraIds.Count > 0)
        multi.Add(new BookingSummaryMultiHidden { Name = "ExtraIds", Values = Model.ExtraIds.Select(id => id.ToString()) });
    if (Model.MedsPetIds.Count > 0)
        multi.Add(new BookingSummaryMultiHidden { Name = "MedsPetIds", Values = Model.MedsPetIds.Select(id => id.ToString()) });
    var petSummary = string.Join(", ", Model.SelectedPets.Select(p => $"{PetSpecies.Emoji(p.Species)} {p.Name}"));
    var medsSummary = Model.NeedsMedsPetPick || Model.MedsExtraSelected
        ? string.Join(", ", Model.SelectedPets.Where(p => Model.MedsPetIds.Contains(p.Id)).Select(p => p.Name))
        : null;
    var summaryLines = new List<BookingSummaryLine>
    {
        new() { LabelEs = "Fechas", LabelEn = "Dates", Value = $"{Model.CheckIn} → {Model.CheckOut}" },
        new() { LabelEs = "Noches", LabelEn = "Nights", Value = Model.Nights.ToString() },
        new()
        {
            LabelEs = Model.SelectedPets.Count == 1 ? "Mascota" : "Mascotas",
            LabelEn = Model.SelectedPets.Count == 1 ? "Pet" : "Pets",
            Value = string.IsNullOrEmpty(petSummary) ? "—" : petSummary
        },
        new()
        {
            LabelEs = "Extras",
            LabelEn = "Extras",
            Value = $"{Model.ExtraIds.Count} {CatalogLocalizer.Loc("seleccionados", "selected")}"
        }
    };
    if (!string.IsNullOrEmpty(medsSummary))
    {
        summaryLines.Add(new BookingSummaryLine
        {
            LabelEs = "Medicamentos",
            LabelEn = "Medication",
            Value = medsSummary
        });
    }
    <partial name="_BookingSummarySheet" model="@(new BookingSummarySheetModel
    {
        BodyId = "hotel-summary-body",
        Presentation = showCheckout ? BookingCheckoutPresentation.FullPage : BookingCheckoutPresentation.StickyContinue,
        ContinueHref = checkoutHref,
        EditHref = configureHref,
        TitleEs = "Resumen",
        TitleEn = "Summary",
        EditHintEs = "Seguir editando la reserva",
        EditHintEn = "Keep editing the booking",
        BusinessName = Model.SelectedHotel.BusinessName,
        ImageUrl = Model.SelectedHotel.ImageUrl,
        FallbackImage = "/images/pet-other.svg",
        Subtitle = Model.SelectedHotel.City ?? "",
        Lines = summaryLines,
        CustomerNotes = Model.Notes,
        TotalLabelEs = "Total estimado",
        TotalLabelEn = "Estimated total",
        Estimate = Model.Estimate,
        NoteEs = "Precio final puede variar según impuestos y extras seleccionados.",
        NoteEn = "Final price may vary with taxes and selected extras.",
        DefaultPayment = Model.DefaultPayment,
        AcceptTerms = Model.AcceptTerms,
        SubmitLabelEs = "Reservar ahora — Pago seguro",
        SubmitLabelEn = "Reserve now — Secure payment",
        ShowSecureLockOnSubmit = true,
        ShowSecureFooter = false,
        HiddenFields =
        [
            new BookingSummaryHidden { Name = "When", Value = Model.When },
            new BookingSummaryHidden { Name = "CheckIn", Value = Model.CheckIn },
            new BookingSummaryHidden { Name = "CheckOut", Value = Model.CheckOut },
            new BookingSummaryHidden { Name = "PetCount", Value = Model.PetCount.ToString() },
            new BookingSummaryHidden { Name = "PetId", Value = Model.PetId.ToString() },
            new BookingSummaryHidden { Name = "GroomerId", Value = Model.GroomerId?.ToString() },
            new BookingSummaryHidden { Name = "Notes", Value = Model.Notes }
        ],
        MultiHiddenFields = multi
    })" />
}
    </div>
    <div class="bottom-nav-clearance" aria-hidden="true"></div>
</div>
