@page "/Index"
@model WebAppPet.Pages.IndexModel
@using WebAppPet.Services
@{
    ViewData["Title"] = L["Nav_Home"].Value;
    ViewData["LangCompact"] = true;
    ViewData["BodyClass"] = "page-onboard-home";
}
<div class="onboard onboard-home">
    <header class="onboard-top">
        <div class="onboard-brand">
            <img src="~/brand/v2/chombly-mark-lime.png" alt="Chombly" class="onboard-mark" asp-append-version="true" />
            <strong class="onboard-word">Chombly</strong>
        </div>
        <div class="home-top-actions">
            <partial name="_LanguageSwitch" />
            <a class="home-notif-btn" asp-page="/Account/Notifications" asp-route-returnUrl="/Index"
               title="@L["Profile_Notifications"]" aria-label="@L["Profile_Notifications"]">
                <svg class="ui-ico" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 22a2.5 2.5 0 0 0 2.45-2h-4.9A2.5 2.5 0 0 0 12 22zm7-6V11a7 7 0 1 0-14 0v5l-2 2v1h18v-1l-2-2z"/></svg>
            </a>
        </div>
    </header>

    <div class="home-body">
        <section class="home-hero">
            <p class="home-hello">
                @(string.IsNullOrWhiteSpace(Model.GreetingName)
                    ? L["Home_HeroHelloGuest"].Value
                    : string.Format(L["Home_HeroHello"].Value, Model.GreetingName))
            </p>
            <h1>@L["Home_HeroTitle"]</h1>
            <p>@L["Home_HeroSubtitle"]</p>
            <form method="get" asp-page="/Groomers/Index" class="home-search">
                <input class="form-control" name="city" value="@Model.City" data-places="city" data-places-fill="city"
                       placeholder="@L["Home_LocationPlaceholder"]" autocomplete="off" />
                <button class="btn btn-enter" type="submit">@L["Common_Search"]</button>
            </form>
        </section>

        <h2 class="home-section-title">@L["Home_Categories"]</h2>
        @if (Model.Categories.Any())
        {
            <div class="hscroll" data-hscroll>
                <div class="category-scroll hscroll-rail" data-hscroll-rail>
                    @foreach (var c in Model.Categories)
                    {
                        var catPage = c.Slug switch
                        {
                            "hotel" => "/Hotel/Index",
                            "vet" => "/Vet/Index",
                            "daycare" => "/Daycare/Index",
                            "walkers" => "/Walkers/Index",
                            "trainers" => "/Trainers/Index",
                            _ => "/Groomers/Index"
                        };
                        var catRoute = c.Slug is "hotel" or "vet" or "daycare" or "walkers" or "trainers" ? null : c.Slug;
                        <a class="category-chip category-chip-illus" asp-page="@catPage" asp-route-category="@catRoute">
                            <span class="category-img-wrap">
                                <img src="~/images/categories/cat-@(c.Slug)-live.png" asp-append-version="true" alt="@c.DisplayName()" class="category-img" />
                            </span>
                            <strong>@c.DisplayName()</strong>
                        </a>
                    }
                </div>
                <div class="hscroll-dots" data-hscroll-dots aria-hidden="true"></div>
            </div>
        }
        else
        {
            <div class="empty">@L["Home_EmptyCategories"]</div>
        }

        <h2 class="home-section-title">@L["Home_WhatPet"]</h2>
        <div class="hscroll" data-hscroll>
            <div class="species-scroll hscroll-rail" id="home-species-scroll" data-hscroll-rail>
                @foreach (var sp in PetSpecies.All)
                {
                    if (sp.Value == PetSpecies.Other)
                    {
                        <button type="button" class="species-chip" id="species-other-chip"
                                data-species="@PetSpecies.Other"
                                aria-expanded="false" aria-controls="other-species-panel">
                            <span class="species-img-wrap">
                                <img src="~@PetSpecies.IconPath(PetSpecies.Other)" asp-append-version="true" alt="" class="species-img" />
                            </span>
                            <span>@(CultureCookie.IsEnglish() ? sp.LabelEn : sp.Label)</span>
                        </button>
                    }
                    else
                    {
                        <a class="species-chip" asp-page="/Groomers/Index" asp-route-species="@sp.Value">
                            <span class="species-img-wrap">
                                <img src="~@PetSpecies.IconPath(sp.Value)" asp-append-version="true" alt="" class="species-img" />
                            </span>
                            <span>@(CultureCookie.IsEnglish() ? sp.LabelEn : sp.Label)</span>
                        </a>
                    }
                }
            </div>
            <div class="hscroll-dots" data-hscroll-dots aria-hidden="true"></div>
        </div>
        <div id="other-species-panel" class="other-species-panel" hidden>
            <form method="get" asp-page="/Groomers/Index" id="other-species-form" class="other-species-form">
                <input type="hidden" name="species" value="@PetSpecies.Other" />
                <label class="small" for="customType">@L["Home_OtherPet"]</label>
                <div class="other-species-row">
                    <input class="form-control" id="customType" name="customType" maxlength="80"
                           placeholder="@L["Home_OtherPetPlaceholder"]" autocomplete="off" />
                    <button class="btn btn-enter" type="submit">@L["Common_Search"]</button>
                </div>
                <p class="field-error" id="other-species-error" hidden>@L["Home_OtherPetRequired"]</p>
            </form>
        </div>

        <a class="home-care-spotlight" asp-page="/Care/Services">
            <span class="home-care-glow" aria-hidden="true"></span>
            <span class="home-care-shine" aria-hidden="true"></span>
            <span class="home-care-mark" aria-hidden="true">
                <img src="~/brand/v2/chombly-mark-lime.png" alt="" asp-append-version="true" width="44" height="44" />
            </span>
            <span class="home-care-copy">
                <strong>@L["Home_CareTitle"]</strong>
                <span>@L["Home_CareSub"]</span>
            </span>
            <span class="home-care-go" aria-hidden="true">›</span>
        </a>

        <h2 class="home-section-title">@L["Home_Popular"]</h2>
        <div class="hscroll" data-hscroll>
            <div class="services-scroll hscroll-rail" data-hscroll-rail>
                @foreach (var name in Model.PopularServices)
                {
                    var icon = CatalogImages.PopularService(name);
                    <a class="service-pill service-pill-rich" asp-page="/Groomers/Index" asp-route-service="@name">
                        <span class="service-img-wrap">
                            <img src="~@icon" asp-append-version="true" alt="" />
                        </span>
                        <span>@CatalogLocalizer.Text(name)</span>
                    </a>
                }
            </div>
            <div class="hscroll-dots" data-hscroll-dots aria-hidden="true"></div>
        </div>

        <div class="home-promo">
            <img src="~/images/onboarding/dev-grooming.webp" alt="" asp-append-version="true" />
            <div>
                <strong>@L["Home_PromoTitle"]</strong>
                <span>@L["Home_PromoCode"] <code>CHOMBLY10</code></span>
            </div>
        </div>

        <h2 class="home-section-title">@L["Home_Featured"]</h2>
        @if (Model.Featured.Any())
        {
            @foreach (var g in Model.Featured)
            {
                var isFav = Model.FavoriteIds.Contains(g.Id);
                var thumb = CatalogImages.Business(g.ImageUrl, g.Category?.Slug);
                <div class="groomer-card-wrap">
                    <a class="groomer-card" asp-page="/Groomers/Details" asp-route-id="@g.Id">
                        <img src="~@thumb" asp-append-version="true" alt="@g.BusinessName" />
                        <div class="info">
                            <h3>@g.BusinessName</h3>
                            <div class="meta-row">
                                @if (g.Category != null)
                                {
                                    <span class="badge badge-purple">@g.Category.DisplayName()</span>
                                }
                                else
                                {
                                    <span class="badge badge-purple">@Model.TypeLabel(g.Type)</span>
                                }
                                @if (g.ReviewCount > 0)
                                {
                                    <span class="stars">&#9733; @g.Rating.ToString("0.0")</span>
                                    <span>(@g.ReviewCount)</span>
                                }
                            </div>
                            <div class="meta-row">
                                <span>@g.City</span>
                                @if (g.StartingPrice > 0)
                                {
                                    <span class="price">@L["Home_FromPrice"] $@g.StartingPrice.ToString("0")@(string.IsNullOrEmpty(g.PriceUnit) ? "" : $" {CatalogLocalizer.Text(g.PriceUnit)}")</span>
                                }
                            </div>
                        </div>
                    </a>
                    <partial name="_FavoriteHeart" model="(g.Id, isFav, (string?)null)" />
                </div>
            }
        }
        else
        {
            <div class="empty">@L["Home_EmptyFeatured"]</div>
        }

        <div class="home-biz-cta">
            <strong>@L["Home_BizCta"]</strong>
            <p>@L["Home_BizCtaSub"]</p>
            <a class="btn btn-enter btn-block" asp-page="/Account/RegisterBusiness">@L["Login_ImBusiness"]</a>
            <a class="onboard-secondary" asp-page="/Welcome">@L["Home_SeeWelcome"]</a>
        </div>

        <div class="bottom-nav-clearance" aria-hidden="true"
             style="height:calc(68px + env(safe-area-inset-bottom, 0px));pointer-events:none"></div>
    </div>
</div>

@section Scripts {
<script>
(function () {
  function bindHScroll(root) {
    var rail = root.querySelector('[data-hscroll-rail]');
    var dots = root.querySelector('[data-hscroll-dots]');
    if (!rail || !dots) return;

    function pageCount() {
      var max = rail.scrollWidth - rail.clientWidth;
      if (max <= 8) return 1;
      return Math.max(2, Math.min(6, Math.ceil(rail.scrollWidth / Math.max(rail.clientWidth, 1))));
    }

    function render() {
      var n = pageCount();
      root.classList.toggle('has-overflow', n > 1);
      if (n <= 1) {
        dots.innerHTML = '';
        return;
      }
      var html = '';
      for (var i = 0; i < n; i++) html += '<button type="button" data-page="' + i + '" aria-label="' + (i + 1) + '"></button>';
      dots.innerHTML = html;
      sync();
    }

    function sync() {
      var n = dots.children.length;
      if (!n) return;
      var max = Math.max(rail.scrollWidth - rail.clientWidth, 1);
      var idx = Math.round((rail.scrollLeft / max) * (n - 1));
      idx = Math.max(0, Math.min(n - 1, idx));
      Array.prototype.forEach.call(dots.children, function (btn, i) {
        btn.classList.toggle('is-active', i === idx);
      });
    }

    dots.addEventListener('click', function (e) {
      var btn = e.target.closest('button[data-page]');
      if (!btn) return;
      var n = dots.children.length;
      var i = +btn.getAttribute('data-page') || 0;
      var max = Math.max(rail.scrollWidth - rail.clientWidth, 0);
      var left = n <= 1 ? 0 : (i / (n - 1)) * max;
      rail.scrollTo({ left: left, behavior: 'smooth' });
    });

    rail.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', render);
    if (window.ResizeObserver) {
      try { new ResizeObserver(render).observe(rail); } catch (_) {}
    }
    // Images can expand scrollWidth after first paint
    rail.querySelectorAll('img').forEach(function (img) {
      if (!img.complete) img.addEventListener('load', render, { once: true });
    });
    render();
    setTimeout(render, 120);
    setTimeout(render, 480);
  }

  document.querySelectorAll('[data-hscroll]').forEach(bindHScroll);
})();

(function () {
  if (!navigator.geolocation) return;

  function postLocation(lat, lng, city) {
    var body = new URLSearchParams();
    body.set('lat', String(lat));
    body.set('lng', String(lng));
    if (city) body.set('city', city);
    return fetch('/Account/Location', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: body,
      credentials: 'same-origin'
    });
  }

  function reverseCity(lat, lng, done) {
    if (!(window.google && google.maps && google.maps.Geocoder)) {
      done(null);
      return;
    }
    try {
      var geocoder = new google.maps.Geocoder();
      geocoder.geocode({ location: { lat: lat, lng: lng } }, function (results, status) {
        if (status !== 'OK' || !results || !results[0]) {
          done(null);
          return;
        }
        var comps = results[0].address_components || [];
        var city = '';
        var state = '';
        comps.forEach(function (c) {
          var t = c.types || [];
          if (t.indexOf('locality') >= 0) city = c.long_name;
          if (t.indexOf('sublocality') >= 0 && !city) city = c.long_name;
          if (t.indexOf('administrative_area_level_1') >= 0) state = c.short_name;
        });
        done([city, state].filter(Boolean).join(', ') || null);
      });
    } catch (_) {
      done(null);
    }
  }

  navigator.geolocation.getCurrentPosition(function (pos) {
    var lat = pos.coords.latitude;
    var lng = pos.coords.longitude;
    var send = function (city) {
      postLocation(lat, lng, city).catch(function () { });
    };
    var tries = 0;
    (function waitMaps() {
      if (window.google && google.maps && google.maps.Geocoder) {
        reverseCity(lat, lng, send);
        return;
      }
      if (++tries > 20) {
        send(null);
        return;
      }
      setTimeout(waitMaps, 250);
    })();
  });
})();

(function () {
  const chip = document.getElementById('species-other-chip');
  const panel = document.getElementById('other-species-panel');
  const form = document.getElementById('other-species-form');
  const input = document.getElementById('customType');
  const err = document.getElementById('other-species-error');
  if (!chip || !panel || !form || !input) return;

  function showOther() {
    chip.classList.add('selected');
    chip.setAttribute('aria-expanded', 'true');
    panel.hidden = false;
    input.focus();
  }

  function hideOther() {
    chip.classList.remove('selected');
    chip.setAttribute('aria-expanded', 'false');
    panel.hidden = true;
    if (err) err.hidden = true;
    input.value = '';
  }

  chip.addEventListener('click', () => {
    if (panel.hidden) showOther();
    else hideOther();
  });

  form.addEventListener('submit', (e) => {
    const v = (input.value || '').trim();
    if (!v) {
      e.preventDefault();
      if (err) err.hidden = false;
      input.focus();
      return;
    }
    input.value = v;
    if (err) err.hidden = true;
  });
})();
</script>
<partial name="_GooglePlaces" />
}
