@page
@model WebAppPet.Pages.Pets.CreateModel
@{
    ViewData["Title"] = L["Pets_Add"].Value;
    ViewData["HideNav"] = true;
    var en = CultureCookie.IsEnglish();
}
<div class="page-header">
    <a class="back-btn" asp-page="./Index">←</a>
    <h1>@L["Pets_Add"]</h1>
</div>
<main class="app-main no-nav">
    <form method="post" id="pet-create-form" enctype="multipart/form-data"
          data-validate-i18n="1"
          data-msg-required="@L["Pets_NameRequired"]">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="form-group">
            <label>@L["Pets_Species"]</label>
            <div class="species-grid">
                @foreach (var sp in Model.SpeciesOptions)
                {
                    var speciesId = $"species-{sp.Value}";
                    <label class="species-opt @(Model.Species == sp.Value ? "selected" : "")">
                        <input type="radio" asp-for="Species" value="@sp.Value" id="@speciesId" />
                        <span class="species-emoji">@sp.Emoji</span>
                        <span class="species-label">@PetSpecies.DisplayLabel(sp.Value)</span>
                    </label>
                }
            </div>
            <span asp-validation-for="Species" class="field-error"></span>
        </div>

        <div class="form-group" id="other-type-group" @(Model.Species == PetSpecies.Other ? null : "hidden")>
            <label asp-for="CustomType">@L["Pets_OtherType"]</label>
            <input class="form-control" asp-for="CustomType" maxlength="80"
                   id="custom-type-input" placeholder="@L["Pets_OtherTypePlaceholder"]" />
            <span asp-validation-for="CustomType" class="field-error"></span>
        </div>

        <div class="form-group">
            <label>@L["Common_Name"]</label>
            <input class="form-control" asp-for="Name" required maxlength="80" autocomplete="nickname" />
            <span asp-validation-for="Name" class="field-error"></span>
        </div>

        <div class="form-group" id="breed-group" @(Model.Species == PetSpecies.Other ? "hidden" : null)>
            <label for="breed-select">@L["Pets_Breed"]</label>
            <select class="form-control" id="breed-select" name="Breed"
                    data-msg-required="@L["Pets_BreedSelect"]">
                <option value="">@L["Pets_BreedSelect"]</option>
            </select>
            <input class="form-control" asp-for="CustomBreed" maxlength="80" id="custom-breed-input"
                   placeholder="@L["Pets_BreedOtherPlaceholder"]" hidden style="margin-top:8px" />
            <span asp-validation-for="Breed" class="field-error"></span>
            <span asp-validation-for="CustomBreed" class="field-error"></span>
        </div>

        <div class="form-group">
            <label>@L["Pets_Age"]</label>
            <input class="form-control" asp-for="AgeYears" type="number" min="0" max="40" required
                   data-msg-required="@L["Pets_AgeRequired"]"
                   inputmode="numeric" />
            <span asp-validation-for="AgeYears" class="field-error"></span>
        </div>

        <div class="form-group">
            <label>@L["Pets_Size"]</label>
            <div class="size-grid">
                @foreach (var opt in Model.SizeOptions)
                {
                    <label>
                        <input type="radio" asp-for="Size" value="@opt.Value" />
                        <div class="size-opt"><span class="emoji">@opt.Emoji</span>@opt.Label</div>
                    </label>
                }
            </div>
        </div>

        <div class="form-group">
            <label for="temperament-select">@L["Pets_Temperament"]</label>
            <select class="form-control" asp-for="Temperament" id="temperament-select" required
                    data-msg-required="@L["Pets_TemperamentRequired"]">
                <option value="">@L["Pets_TemperamentSelect"]</option>
                @foreach (var t in Model.TemperamentOptions)
                {
                    <option value="@t.Value">@PetCatalog.Display(t.Value, t.LabelEn)</option>
                }
            </select>
            <span asp-validation-for="Temperament" class="field-error"></span>
        </div>

        <div class="form-group pet-photo-field">
            <label>@L["Pets_Photo"]</label>
            <p class="field-hint">@L["Pets_PhotoHint"]</p>
            <div class="pet-photo-upload">
                <img id="photo-preview" class="pet-photo-preview" alt="" hidden />
                <label class="pet-photo-pick btn btn-outline">
                    @L["Pets_PhotoChoose"]
                    <input type="file" asp-for="PhotoFile" id="photo-file" accept="image/*" capture="environment" />
                </label>
            </div>
            <span asp-validation-for="PhotoFile" class="field-error"></span>
            <details class="pet-photo-url-fallback">
                <summary>@L["Pets_PhotoOrUrl"]</summary>
                <input class="form-control" asp-for="PhotoUrl" placeholder="https://…" />
            </details>
        </div>

        <div class="toggle-row">
            <span>@L["Pets_Senior"]</span>
            <input asp-for="IsSenior" type="checkbox" />
        </div>
        <div class="toggle-row">
            <span>
                @L["Pets_Anxious"]
                <span class="field-hint" style="display:block;font-weight:400;margin-top:2px">@L["Pets_AnxiousHint"]</span>
            </span>
            <input asp-for="IsAnxious" type="checkbox" />
        </div>
        <div class="toggle-row">
            <span>@L["Pets_SpecialNeeds"]</span>
            <input asp-for="HasSpecialNeeds" type="checkbox" />
        </div>

        <div class="form-group" style="margin-top:14px">
            <label>@L["Common_Notes"]</label>
            <textarea class="form-control" asp-for="Notes" rows="3"></textarea>
        </div>

        <button class="btn btn-primary btn-block" type="submit">@L["Common_Save"]</button>
    </form>
</main>

<script>
(() => {
@{
    var breedsPayload = Model.SpeciesOptions
        .Where(s => s.Value != PetSpecies.Other)
        .ToDictionary(
            s => s.Value,
            s => PetCatalog.BreedsFor(s.Value)
                .Select(b => new { value = b.Value, label = PetCatalog.Display(b.Value, b.LabelEn) })
                .ToList());
}
  const breedsBySpecies = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(breedsPayload));
  const otherBreedValue = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(PetCatalog.OtherBreed));
  const otherBreedLabel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Pets_BreedOther"].Value));
  const initialBreed = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Breed ?? ""));
  const breedSelect = document.getElementById('breed-select');
  const breedGroup = document.getElementById('breed-group');
  const customBreed = document.getElementById('custom-breed-input');
  const otherGroup = document.getElementById('other-type-group');
  const customType = document.getElementById('custom-type-input');
  const otherValue = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(PetSpecies.Other));

  function fillBreeds(species, keepValue) {
    if (!breedSelect) return;
    const list = breedsBySpecies[species] || [];
    const current = keepValue || '';
    const keep = current && list.some(b => b.value === current) ? current
      : (current === otherBreedValue ? current : '');
    breedSelect.innerHTML = '';
    const placeholder = document.createElement('option');
    placeholder.value = '';
    placeholder.textContent = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Pets_BreedSelect"].Value));
    breedSelect.appendChild(placeholder);
    const seen = new Set();
    list.forEach(function (b) {
      const key = String(b.value || '').trim().toLowerCase();
      if (!key || seen.has(key)) return;
      seen.add(key);
      const opt = document.createElement('option');
      opt.value = b.value;
      opt.textContent = b.label;
      if (b.value === keep) opt.selected = true;
      breedSelect.appendChild(opt);
    });
    const otherOpt = document.createElement('option');
    otherOpt.value = otherBreedValue;
    otherOpt.textContent = otherBreedLabel;
    if (keep === otherBreedValue) otherOpt.selected = true;
    breedSelect.appendChild(otherOpt);
    syncCustomBreed();
  }

  function syncCustomBreed() {
    if (!customBreed || !breedSelect) return;
    const show = breedSelect.value === otherBreedValue;
    customBreed.hidden = !show;
    if (!show) customBreed.value = '';
  }

  function syncSpecies(species, keepBreed) {
    const isOther = species === otherValue;
    if (otherGroup) otherGroup.hidden = !isOther;
    if (breedGroup) breedGroup.hidden = isOther;
    if (!isOther && customType) customType.value = '';
    document.querySelectorAll('.species-opt').forEach(el => el.classList.remove('selected'));
    const checkedInput = document.querySelector('input[name="Species"]:checked');
    checkedInput?.closest('.species-opt')?.classList.add('selected');
    if (!isOther) fillBreeds(species, keepBreed ? keepBreed : '');
  }

  breedSelect?.addEventListener('change', syncCustomBreed);

  document.querySelectorAll('input[name="Species"]').forEach(r => {
    r.addEventListener('change', () => syncSpecies(r.value, ''));
  });

  const checked = document.querySelector('input[name="Species"]:checked');
  syncSpecies(checked ? checked.value : '', initialBreed);

  const fileInput = document.getElementById('photo-file');
  const preview = document.getElementById('photo-preview');
  let objectUrl = null;
  fileInput?.addEventListener('change', () => {
    if (objectUrl) {
      URL.revokeObjectURL(objectUrl);
      objectUrl = null;
    }
    const f = fileInput.files && fileInput.files[0];
    if (!f || !preview) {
      if (preview) preview.hidden = true;
      return;
    }
    objectUrl = URL.createObjectURL(f);
    preview.src = objectUrl;
    preview.hidden = false;
  });
})();
</script>
