@page
@model WebAppPet.Pages.Pets.IndexModel
@{
    ViewData["Title"] = L["Pets_Title"].Value;
    ViewData["LangCompact"] = true;
    ViewData["BodyClass"] = "page-pets";
}
<div class="onboard onboard-app pets-index">
    <partial name="_OnboardTop" />
    <div class="home-body">
        <header class="pets-index-head">
            <div class="pets-index-head-text">
                <h1 class="app-page-heading">@L["Pets_Title"]</h1>
                <p class="muted small pets-index-lead">@CatalogLocalizer.Loc("Tu manada en un solo lugar", "Your pack in one place")</p>
            </div>
            @if (!Model.IsGuest && Model.Pets.Any())
            {
                <a class="btn btn-primary btn-sm pets-index-add" asp-page="./Create">+ @L["Pets_AddShort"]</a>
            }
        </header>

        @if (Model.IsGuest)
        {
            <div class="empty-chombly">
                <img src="~/images/chombly-empty-pets-v3.png" asp-append-version="true" alt="" class="empty-illu" />
                <h2>@L["Pets_GuestTitle"]</h2>
                <p>@L["Pets_GuestSub"]</p>
                <a class="btn btn-primary btn-block" asp-page="/Account/Login" asp-route-returnUrl="/Pets">@L["Login_Title"]</a>
                <a class="btn btn-outline btn-block" asp-page="/Account/Register" asp-route-returnUrl="/Pets" style="margin-top:10px">@L["Register_Title"]</a>
            </div>
        }
        else if (Model.Pets.Any())
        {
            <div class="pets-list">
            @foreach (var p in Model.Pets)
            {
                <article class="pet-card">
                    <a class="pet-card-edit"
                       asp-page="./Create"
                       asp-route-id="@p.Id"
                       asp-route-returnUrl="/Pets"
                       aria-label="@CatalogLocalizer.Loc($"Editar {p.Name}", $"Edit {p.Name}")">
                        <partial name="_PetAvatar" model="(p.PhotoUrl, p.Species, p.Name, (string?)null)" />
                        <div class="pet-info">
                            <strong>@PetSpecies.Emoji(p.Species) @p.Name</strong>
                            <div class="muted small">@PetSpecies.Label(p.Species) · @PetCatalog.DisplayBreed(p.Species, p.Breed) · @Model.SizeLabel(p.Size) · @p.AgeYears @L["Pets_Years"]</div>
                            <div class="muted small">@PetCatalog.DisplayTemperament(p.Temperament)</div>
                            @if (p.IsSenior || p.IsAnxious || p.HasSpecialNeeds)
                            {
                                <div class="chip-row pet-care-badges">
                                    @if (p.IsSenior) { <span class="badge badge-orange">@L["Pets_Senior"]</span> }
                                    @if (p.IsAnxious) { <span class="badge badge-orange">@L["Pets_Anxious"]</span> }
                                    @if (p.HasSpecialNeeds) { <span class="badge badge-orange">@L["Pets_SpecialNeeds"]</span> }
                                </div>
                            }
                        </div>
                    </a>
                    <div class="pet-actions">
                        <a class="icon-btn" asp-page="./Care" asp-route-id="@p.Id" title="@CatalogLocalizer.Loc("Control", "Care")">🩺</a>
                        <a class="icon-btn" asp-page="./Reminders" asp-route-id="@p.Id" title="@CatalogLocalizer.Loc("Recordatorios", "Reminders")">⏰</a>
                        <a class="icon-btn" asp-page="./History" asp-route-id="@p.Id" title="@L["Appt_History"]">📋</a>
                        <form method="post" asp-page-handler="Delete"
                              data-confirm
                              data-confirm-title="@L["Pets_DeleteTitle"]"
                              data-confirm-message="@string.Format(L["Pets_DeleteConfirm"].Value, p.Name)"
                              data-confirm-cancel="@L["Pets_DeleteCancel"]"
                              data-confirm-ok="@L["Pets_DeleteOk"]">
                            <input type="hidden" name="id" value="@p.Id" />
                            <button type="submit" class="icon-btn" title="@L["Common_Delete"]">🗑️</button>
                        </form>
                    </div>
                </article>
            }
            </div>

            <aside class="trust-banner pets-trust" data-trust-banner aria-label="@CatalogLocalizer.Loc("Cuidado Chombly", "Chombly care")">
                <div class="pets-tip-orb" aria-hidden="true"></div>
                <div class="pets-tip-orb pets-tip-orb--2" aria-hidden="true"></div>
                <p class="pets-tip-kicker">@CatalogLocalizer.Loc("Tip Chombly", "Chombly tip")</p>
                <div class="trust-banner-viewport">
                    <div class="trust-banner-item is-active" data-trust-item aria-hidden="false">
                        <span class="trust-banner-ico" aria-hidden="true">🩺</span>
                        <span class="trust-banner-copy">
                            <strong>@CatalogLocalizer.Loc("Control al día", "Care up to date")</strong>
                            <small>@CatalogLocalizer.Loc("Revisa historial y próximos cuidados", "Check history and upcoming care")</small>
                        </span>
                    </div>
                    <div class="trust-banner-item" data-trust-item aria-hidden="true">
                        <span class="trust-banner-ico" aria-hidden="true">⏰</span>
                        <span class="trust-banner-copy">
                            <strong>@CatalogLocalizer.Loc("Recordatorios útiles", "Helpful reminders")</strong>
                            <small>@CatalogLocalizer.Loc("Vacunas, baños y citas sin olvidar", "Vaccines, baths, and visits on time")</small>
                        </span>
                    </div>
                    <div class="trust-banner-item" data-trust-item aria-hidden="true">
                        <span class="trust-banner-ico" aria-hidden="true">🌿</span>
                        <span class="trust-banner-copy">
                            <strong>@CatalogLocalizer.Loc("Perfil listo para agendar", "Profile ready to book")</strong>
                            <small>@CatalogLocalizer.Loc("Temperamento y cuidados llegan al negocio", "Temperament and care notes reach the provider")</small>
                        </span>
                    </div>
                </div>
                <div class="trust-banner-dots" data-trust-dots aria-hidden="true"></div>
            </aside>
        }
        else
        {
            <div class="empty-chombly">
                <img src="~/images/chombly-empty-pets-v3.png" asp-append-version="true" alt="" class="empty-illu" />
                <h2>@L["Pets_EmptyTitle"]</h2>
                <p>@L["Pets_EmptySub"]</p>
                <a class="btn btn-primary btn-block" asp-page="./Create">+ @L["Pets_Add"]</a>
            </div>
        }
    </div>
    <div class="bottom-nav-clearance" aria-hidden="true"></div>
</div>
