@page "{id:int}"
@model WebAppPet.Pages.Pets.RemindersModel
@using WebAppPet.Localization
@using WebAppPet.Domain
@{
    ViewData["Title"] = CatalogLocalizer.Loc($"Recordatorios · {Model.Pet?.Name}", $"Reminders · {Model.Pet?.Name}");
    ViewData["LangCompact"] = true;
    ViewData["OnboardBackHref"] = Url.Page("/Pets/Index");
    var HideNav = ViewData["HideNav"] as bool? == true;
    var minDueDate = AppTimeZones.TodayLocalDate().ToString("yyyy-MM-dd");
    string ReminderTypeLabel(ReminderType t) => t switch
    {
        ReminderType.Vaccine => CatalogLocalizer.Loc("Vacuna", "Vaccine"),
        ReminderType.Medication => CatalogLocalizer.Loc("Medicamento", "Medication"),
        ReminderType.Appointment => CatalogLocalizer.Loc("Cita", "Appointment"),
        _ => CatalogLocalizer.Loc("Personalizado", "Custom")
    };
}
<div class="onboard onboard-app">
    <partial name="_OnboardTop" />
    <div class="home-body @(HideNav ? "no-nav" : "")">
    <h1 class="app-page-heading">@CatalogLocalizer.Loc("Recordatorios", "Reminders")</h1>
    <p class="muted small">@Model.Pet?.Name · @CatalogLocalizer.Loc("vacunas, medicinas y citas", "vaccines, meds, and appointments")</p>
    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert alert-info">@Model.Message</div>
    }

    <section style="margin-bottom:16px">
        <h2 class="section-title">@CatalogLocalizer.Loc("Activos", "Active")</h2>
        @if (Model.Schedules.Count == 0)
        {
            <p class="muted small">@CatalogLocalizer.Loc("No hay recordatorios activos.", "No active reminders.")</p>
        }
        else
        {
            @foreach (var s in Model.Schedules)
            {
                <div class="card card-pad" style="margin-bottom:8px">
                    <strong>@NotificationLocalizer.Reminder(s.Title)</strong>
                    <span class="badge badge-green" style="margin-left:6px">@ReminderTypeLabel(s.Type)</span>
                    <span class="muted small" style="display:block">
                        @CatalogLocalizer.Loc("Próximo", "Next"): @AppTimeZones.FormatShort(s.NextDueUtc)
                        @if (s.FrequencyDays is int d) { <text>· @CatalogLocalizer.Loc($"cada {d} días", $"every {d} days")</text> }
                    </span>
                    @if (s.QuietHoursStartLocal is TimeSpan qs && s.QuietHoursEndLocal is TimeSpan qe)
                    {
                        <span class="muted small" style="display:block">
                            @CatalogLocalizer.Loc("No molestar", "Do not disturb"): @qs.ToString(@"hh\:mm")–@qe.ToString(@"hh\:mm")
                        </span>
                    }
                    <form method="post" asp-page-handler="Deactivate" style="margin-top:8px">
                        <input type="hidden" name="Id" value="@Model.Id" />
                        <input type="hidden" name="scheduleId" value="@s.Id" />
                        <button class="btn btn-outline btn-sm" type="submit">@CatalogLocalizer.Loc("Desactivar", "Deactivate")</button>
                    </form>
                </div>
            }
        }
    </section>

    <section class="card card-pad care-hero">
        <h2 class="section-title" style="margin-top:0">@CatalogLocalizer.Loc("Nuevo recordatorio", "New reminder")</h2>
        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="alert alert-warn">@Model.Error</div>
        }
        <form method="post" asp-page-handler="Create"
              data-validate-i18n
              data-msg-required="@CatalogLocalizer.Loc("Completa los campos obligatorios.", "Fill in the required fields.")">
            <input type="hidden" name="Id" value="@Model.Id" />
            <div class="form-group">
                <label>@CatalogLocalizer.Loc("Tipo", "Type")</label>
                <select class="form-control" asp-for="Type" required>
                    <option value="">@CatalogLocalizer.Loc("Elige tipo", "Choose type")</option>
                    <option value="@((int)ReminderType.Vaccine)">@ReminderTypeLabel(ReminderType.Vaccine)</option>
                    <option value="@((int)ReminderType.Medication)">@ReminderTypeLabel(ReminderType.Medication)</option>
                    <option value="@((int)ReminderType.Appointment)">@ReminderTypeLabel(ReminderType.Appointment)</option>
                    <option value="@((int)ReminderType.Custom)">@ReminderTypeLabel(ReminderType.Custom)</option>
                </select>
            </div>
            <div class="form-group">
                <label>@CatalogLocalizer.Loc("Título", "Title")</label>
                <input class="form-control" asp-for="Title" placeholder="@CatalogLocalizer.Loc("Vacuna antirrábica", "Rabies vaccine")" />
            </div>
            <div class="form-group">
                <label>@CatalogLocalizer.Loc("Notas", "Notes")</label>
                <input class="form-control" asp-for="Notes" />
            </div>
            <div class="form-group">
                <label>@CatalogLocalizer.Loc("Cada (días)", "Every (days)")</label>
                <input class="form-control" type="number" asp-for="FrequencyDays" min="1" placeholder="@CatalogLocalizer.Loc("Opcional", "Optional")" />
            </div>
            <div class="reminder-when">
                <div class="form-group">
                    <label for="NextDueLocal">@CatalogLocalizer.Loc("Próxima fecha", "Next due date")</label>
                    <input class="form-control" type="date" asp-for="NextDueLocal" required min="@minDueDate" />
                </div>
                <div class="form-group">
                    <label for="DueTime">@CatalogLocalizer.Loc("Hora del aviso", "Reminder time")</label>
                    <input class="form-control" type="time" asp-for="DueTime" required
                           data-msg-required="@CatalogLocalizer.Loc("Elige la hora del aviso.", "Choose the reminder time.")" />
                </div>
            </div>
            <details class="reminder-dnd" id="reminder-dnd" @(string.IsNullOrWhiteSpace(Model.QuietStart) && string.IsNullOrWhiteSpace(Model.QuietEnd) ? null : "open")>
                <summary>@CatalogLocalizer.Loc("Opcional: no molestar", "Optional: do not disturb")</summary>
                <p class="muted small">@CatalogLocalizer.Loc(
                    "No te enviamos avisos entre estas dos horas. Si el recordatorio cae en ese horario, te avisamos cuando termine (en tu hora local).",
                    "We won't send alerts between these two times. If the reminder falls in that window, we'll notify you when it ends (in your local time).")</p>
                <div class="reminder-dnd-times">
                    <div class="form-group">
                        <label for="QuietStart">@CatalogLocalizer.Loc("Desde", "From")</label>
                        <input class="form-control" type="time" asp-for="QuietStart" data-dnd-time
                               data-msg-required="@CatalogLocalizer.Loc("Indica también la hora desde.", "Also enter the from time.")" />
                    </div>
                    <div class="form-group">
                        <label for="QuietEnd">@CatalogLocalizer.Loc("Hasta", "Until")</label>
                        <input class="form-control" type="time" asp-for="QuietEnd" data-dnd-time
                               data-msg-required="@CatalogLocalizer.Loc("Indica también la hora hasta.", "Also enter the until time.")" />
                    </div>
                </div>
            </details>
            <button class="btn btn-primary btn-block" type="submit">@CatalogLocalizer.Loc("Crear", "Create")</button>
        </form>
        <script>
          (function () {
            var times = document.querySelectorAll('#reminder-dnd [data-dnd-time]');
            if (times.length !== 2) return;
            function sync() {
              var any = times[0].value !== '' || times[1].value !== '';
              times.forEach(function (t) { t.required = any; });
            }
            times.forEach(function (t) { t.addEventListener('input', sync); t.addEventListener('change', sync); });
            sync();
          })();
        </script>
    </section>
    </div>
    @if (!HideNav) { <div class="bottom-nav-clearance" aria-hidden="true"></div> }
</div>
