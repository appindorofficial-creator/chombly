@page
@model WebAppPet.Pages.Professional.Onboarding.InternationalModel
@using WebAppPet.Localization
@{
    ViewData["Title"] = CatalogLocalizer.Loc("Onboarding internacional", "International onboarding");
    ViewData["GroomerTab"] = "onboarding";
    ViewData["LangCompact"] = true;
    ViewData["OnboardBackHref"] = Url.Page("/Professional/Onboarding");
}
<div class="onboard onboard-app">
    <partial name="_OnboardTop" />
    <div class="home-body">
    <partial name="/Pages/Groomer/_GroomerNav.cshtml" />
    <h1 class="app-page-heading">@CatalogLocalizer.Loc("Asesor internacional", "International advisor")</h1>
    <p class="muted small">@CatalogLocalizer.Loc("No afirmas licencia veterinaria de EE.UU. Orientación por país / raza.", "You are not claiming a US veterinary license. Country / breed guidance.")</p>

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert alert-warn">@Model.Error</div>
    }

    <form method="post" enctype="multipart/form-data" class="card card-pad"
          data-validate-i18n
          data-msg-required="@L["Validation_Required"]">
        <div class="form-group">
            <label>@CatalogLocalizer.Loc("Nombre legal", "Legal name")</label>
            <input class="form-control" asp-for="LegalName" required />
            <span class="field-error" hidden></span>
        </div>
        <div class="form-group">
            <label>@CatalogLocalizer.Loc("Práctica / clínica", "Practice / clinic")</label>
            <input class="form-control" asp-for="ClinicOrPracticeName" />
        </div>
        <div class="form-group">
            <label>@CatalogLocalizer.Loc("País", "Country")</label>
            <div class="places-field">
                <input class="form-control" asp-for="CountrySearch" id="CountrySearch"
                       data-country-suggest data-country-iso="#LicenseJurisdiction"
                       autocomplete="off" required
                       placeholder="@CatalogLocalizer.Loc("Busca tu país…", "Search your country…")" />
                <input type="hidden" asp-for="LicenseJurisdiction" id="LicenseJurisdiction" />
            </div>
            <p class="muted small biz-hint">@CatalogLocalizer.Loc("Escribe y elige el país de tu credencial.", "Type and pick the country of your credential.")</p>
            <span class="field-error" hidden></span>
        </div>
        <div class="form-group">
            <label>@CatalogLocalizer.Loc("Nº credencial / licencia local", "Local credential / license #")</label>
            <input class="form-control" asp-for="LicenseNumber" />
        </div>
        <div class="form-group">
            <label>@CatalogLocalizer.Loc("Vencimiento", "Expiry")</label>
            <input class="form-control" type="date" asp-for="LicenseExpiry" />
        </div>
        <div class="form-group">
            <label>@CatalogLocalizer.Loc("Idiomas (coma)", "Languages (comma)")</label>
            <input class="form-control" asp-for="Languages" required />
            <span class="field-error" hidden></span>
        </div>
        <div class="form-group">
            <label>@CatalogLocalizer.Loc("Especialidades", "Specialties")</label>
            <input class="form-control" asp-for="Specialties" />
        </div>
        <div class="form-group">
            <label>@CatalogLocalizer.Loc("Expertise de razas (CSV)", "Breed expertise (CSV)")</label>
            <input class="form-control" asp-for="BreedExpertiseCsv" placeholder="French Bulldog, Chihuahua" />
        </div>
        <label class="check-row">
            <input type="checkbox" asp-for="AcceptsInternationalClients" />
            <span>@CatalogLocalizer.Loc("Acepto clientes internacionales", "I accept international clients")</span>
        </label>
        <div class="form-group">
            <label>@CatalogLocalizer.Loc("Nota de documentos", "Documents note")</label>
            <textarea class="form-control" asp-for="DocumentsNote" rows="2"></textarea>
        </div>
        <div class="form-group">
            <label>@L["Onboard_UploadOptional"]</label>
            <div class="file-pick-row">
                <label class="pet-photo-pick btn btn-outline">
                    @L["Common_ChooseFile"]
                    <input type="file" asp-for="DocumentUpload" accept=".pdf,.jpg,.jpeg,.png" />
                </label>
                <span class="muted small file-pick-name"
                      data-file-name
                      data-file-empty="@L["Common_NoFileChosen"]">@L["Common_NoFileChosen"]</span>
                <button type="button" class="btn btn-outline btn-sm file-pick-clear" data-file-clear hidden>
                    @L["Common_RemoveFile"]
                </button>
            </div>
        </div>
        <button class="btn btn-outline btn-block" type="submit" asp-page-handler="Draft">@CatalogLocalizer.Loc("Guardar borrador", "Save draft")</button>
        <button class="btn btn-primary btn-block" type="submit" asp-page-handler="Submit" style="margin-top:8px">@CatalogLocalizer.Loc("Enviar a revisión", "Submit for review")</button>
    </form>
    </div>
    <div class="bottom-nav-clearance" aria-hidden="true"></div>
</div>

@section Scripts {
    <script src="~/js/country-suggest.js" asp-append-version="true"></script>
    <script>
        (function () {
            var input = document.getElementById('DocumentUpload');
            var nameEl = document.querySelector('[data-file-name]');
            var clearBtn = document.querySelector('[data-file-clear]');
            if (!input || !nameEl) return;
            var empty = nameEl.getAttribute('data-file-empty') || '';
            function sync() {
                var has = !!(input.files && input.files[0]);
                nameEl.textContent = has ? input.files[0].name : empty;
                if (clearBtn) clearBtn.hidden = !has;
            }
            input.addEventListener('change', sync);
            if (clearBtn) {
                clearBtn.addEventListener('click', function () {
                    input.value = '';
                    sync();
                });
            }
            sync();
        })();
    </script>
}
