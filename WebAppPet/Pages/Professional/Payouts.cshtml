@page
@model WebAppPet.Pages.Professional.PayoutsModel
@using WebAppPet.Localization
@using WebAppPet.Services
@{
    ViewData["Title"] = CatalogLocalizer.Loc("Mis pagos", "My payouts");
    ViewData["GroomerTab"] = "payouts";
}
<header class="topbar">
    <partial name="_Brand" />
</header>
<main class="app-main">
    <partial name="/Pages/Groomer/_GroomerNav.cshtml" />
    <h1 class="page-title">@CatalogLocalizer.Loc("Mis pagos", "My payouts")</h1>
    <p class="muted small">@CatalogLocalizer.Loc("Comisiones y resúmenes de período (simulado, sin Stripe real).", "Commissions and period summaries (simulated, no real Stripe).")</p>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert alert-info">@Model.Message</div>
    }
    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert alert-warn">@Model.Error</div>
    }

    <section class="card card-pad vet-vcpr-ok" style="margin-bottom:14px">
        <h2 class="section-title" style="margin-top:0">@CatalogLocalizer.Loc("Reglas de comisión", "Commission rules")</h2>
        @if (Model.Rules.Count == 0)
        {
            <p class="muted small mb-0">@CatalogLocalizer.Loc("Aún no hay reglas. Completa el onboarding profesional.", "No rules yet. Complete professional onboarding.")</p>
        }
        else
        {
            @foreach (var r in Model.Rules)
            {
                <div style="margin-bottom:8px">
                    <strong>@r.ServiceType</strong>
                    <span class="muted small"> · @r.CommissionPercent.ToString("0.##")% · @r.PayoutCurrency
                        @if (r.ProviderUserId is null) { <text>· @CatalogLocalizer.Loc("default plataforma", "platform default")</text> }
                    </span>
                </div>
            }
        }
    </section>

    <section class="card card-pad" style="margin-bottom:14px">
        <h2 class="section-title" style="margin-top:0">@CatalogLocalizer.Loc("Generar resumen de período", "Generate period summary")</h2>
        <form method="post" asp-page-handler="Generate">
            <div class="form-group">
                <label>@CatalogLocalizer.Loc("Desde", "From")</label>
                <input class="form-control" type="date" asp-for="PeriodStart" />
            </div>
            <div class="form-group">
                <label>@CatalogLocalizer.Loc("Hasta", "To")</label>
                <input class="form-control" type="date" asp-for="PeriodEnd" />
            </div>
            <button class="btn btn-primary btn-block" type="submit">@CatalogLocalizer.Loc("Generar (simulado)", "Generate (simulated)")</button>
        </form>
    </section>

    <section>
        <h2 class="section-title">@CatalogLocalizer.Loc("Historial", "History")</h2>
        @if (Model.History.Count == 0)
        {
            <p class="muted small">@CatalogLocalizer.Loc("Sin payouts aún.", "No payouts yet.")</p>
        }
        else
        {
            @foreach (var p in Model.History)
            {
                <div class="card card-pad" style="margin-bottom:8px">
                    <strong>@p.Status</strong>
                    <span class="muted small" style="display:block">
                        @AppTimeZones.FormatDate(p.PeriodStart) – @AppTimeZones.FormatDate(p.PeriodEnd)
                        · @p.ConsultationCount @CatalogLocalizer.Loc("ítems", "items")
                    </span>
                    <span class="muted small" style="display:block">
                        Gross $@p.GrossAmountUsd.ToString("0.00") · Comm $@p.CommissionAmountUsd.ToString("0.00")
                        · <strong class="price-tag">Net $@p.NetAmountUsd.ToString("0.00")</strong>
                    </span>
                    @if (!string.IsNullOrEmpty(p.ExternalReference))
                    {
                        <span class="muted small" style="display:block">Ref: @p.ExternalReference</span>
                    }
                </div>
            }
        }
    </section>
</main>
