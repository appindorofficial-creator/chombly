@page
@model WebAppPet.Pages.Professional.PayoutsModel
@using WebAppPet.Localization
@using WebAppPet.Models
@{
    ViewData["Title"] = L["Groomer_Payouts"].Value;
    ViewData["GroomerTab"] = "payouts";
    ViewData["LangCompact"] = true;
    string ServiceLabel(CompensationServiceType t) => t switch
    {
        CompensationServiceType.LocalVet => L["Payout_Service_LocalVet"].Value,
        CompensationServiceType.InternationalVet => L["Payout_Service_InternationalVet"].Value,
        CompensationServiceType.Behavior => L["Payout_Service_Behavior"].Value,
        _ => t.ToString()
    };
    string StatusLabel(ProviderPayoutStatus s) => s switch
    {
        ProviderPayoutStatus.Pending => L["Payout_Status_Pending"].Value,
        ProviderPayoutStatus.Processing => L["Payout_Status_Processing"].Value,
        ProviderPayoutStatus.Paid => L["Payout_Status_Paid"].Value,
        ProviderPayoutStatus.Failed => L["Payout_Status_Failed"].Value,
        ProviderPayoutStatus.Held => L["Payout_Status_Held"].Value,
        _ => s.ToString()
    };
    string PurposeLabel(PaymentPurpose p) => p switch
    {
        PaymentPurpose.BookingDeposit => CatalogLocalizer.Loc("Anticipo de reserva", "Booking deposit"),
        PaymentPurpose.VetConsultation => CatalogLocalizer.Loc("Consulta veterinaria", "Vet consultation"),
        PaymentPurpose.BehaviorSession => CatalogLocalizer.Loc("Sesión de comportamiento", "Behavior session"),
        PaymentPurpose.CareSubscription => "Chombly Care",
        _ => p.ToString()
    };
}
<div class="onboard onboard-app">
    <partial name="_OnboardTop" />
    <div class="home-body">
    <partial name="/Pages/Groomer/_GroomerNav.cshtml" />
    <h1 class="page-title">@L["Groomer_Payouts"]</h1>
    <p class="muted small">@L["Payout_Lead"]</p>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert alert-info">@Model.Message</div>
    }
    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert alert-warn">@Model.Error</div>
    }

    <section class="card card-pad vet-vcpr-ok" style="margin-bottom:14px">
        <h2 class="section-title" style="margin-top:0">@L["Payout_CommissionRules"]</h2>
        @if (Model.Rules.Count == 0)
        {
            <p class="muted small mb-0">@L["Payout_NoRules"]</p>
        }
        else
        {
            @foreach (var r in Model.Rules)
            {
                <div style="margin-bottom:8px">
                    <strong>@ServiceLabel(r.ServiceType)</strong>
                    <span class="muted small"> · @r.CommissionPercent.ToString("0.##")% · @AppMoney.Code()
                        @if (r.ProviderUserId is null) { <text>· @L["Payout_PlatformDefault"]</text> }
                    </span>
                </div>
            }
        }
    </section>

    <section style="margin-bottom:18px">
        <h2 class="section-title">@CatalogLocalizer.Loc("Pagos de clientes", "Customer payments")</h2>
        <p class="muted small" style="margin-top:-6px;margin-bottom:10px">
            @CatalogLocalizer.Loc(
                "Lo que tus clientes pagaron con tarjeta en Chombly. En las reservas solo se cobra el anticipo; el saldo lo cobras tú en el negocio. La comisión se calcula sobre el total del servicio y se descuenta de lo cobrado en línea.",
                "What your customers paid by card on Chombly. Bookings only charge the deposit; you collect the balance at your business. Commission is on the full service price and is deducted from the online amount.")
        </p>
        @if (Model.RecentPayments.Count == 0)
        {
            <p class="muted small">@CatalogLocalizer.Loc("Aún no hay pagos de clientes.", "No customer payments yet.")</p>
        }
        else
        {
            @foreach (var pay in Model.RecentPayments)
            {
                var refunded = pay.Status == PaymentTransactionStatus.Refunded;
                <div class="card card-pad" style="margin-bottom:8px@(refunded ? ";opacity:.7" : "")">
                    <div style="display:flex;justify-content:space-between;gap:10px;align-items:flex-start">
                        <div>
                            <strong>@pay.PetName · @pay.ServiceName</strong>
                            <span class="muted small" style="display:block">@pay.ClientName · @PurposeLabel(pay.Purpose)</span>
                            <span class="muted small" style="display:block">
                                @CatalogLocalizer.Loc("Pagado", "Paid") @AppTimeZones.FormatShort(pay.PaidAtUtc)
                                @if (pay.ScheduledAtUtc is DateTime visit)
                                {
                                    <text>· @CatalogLocalizer.Loc("Cita", "Visit") @AppTimeZones.FormatShort(visit)</text>
                                }
                            </span>
                            @if (refunded)
                            {
                                <span class="muted small" style="display:block">
                                    <strong>@CatalogLocalizer.Loc("Reembolsado", "Refunded")</strong>
                                    @if (pay.RefundedAtUtc is DateTime r) { <text>@AppTimeZones.FormatShort(r)</text> }
                                </span>
                            }
                        </div>
                        <strong class="price-tag">@AppMoney.FormatCurrency(pay.ChargedOnline, pay.Currency)</strong>
                    </div>
                    <span class="muted small" style="display:block;margin-top:6px">
                        @CatalogLocalizer.Loc("Total del servicio", "Service total") @AppMoney.FormatCurrency(pay.ServiceTotal, pay.Currency)
                        @if (pay.BalanceAtBusiness > 0)
                        {
                            <text>· @CatalogLocalizer.Loc("Saldo a cobrar en el negocio", "Balance to collect in person") @AppMoney.FormatCurrency(pay.BalanceAtBusiness, pay.Currency)</text>
                        }
                    </span>
                    @if (!refunded)
                    {
                        <span class="muted small" style="display:block">
                            @CatalogLocalizer.Loc("Comisión", "Comm") @AppMoney.FormatCurrency(pay.Commission, pay.Currency)
                            · <strong>@CatalogLocalizer.Loc("Neto a liquidar", "Net payout") @AppMoney.FormatCurrency(pay.Net, pay.Currency)</strong>
                        </span>
                    }
                    <span class="muted small" style="display:block">@CatalogLocalizer.Loc("Ref:", "Ref:") @pay.Reference</span>
                </div>
            }
        }
    </section>

    <section class="card card-pad" style="margin-bottom:14px">
        <h2 class="section-title" style="margin-top:0">@L["Payout_GenerateTitle"]</h2>
        <form method="post" asp-page-handler="Generate">
            <div class="form-group">
                <label>@L["Payout_From"]</label>
                <input class="form-control" type="date" asp-for="PeriodStart" />
            </div>
            <div class="form-group">
                <label>@L["Payout_To"]</label>
                <input class="form-control" type="date" asp-for="PeriodEnd" />
            </div>
            <button class="btn btn-primary btn-block" type="submit">@L["Payout_Generate"]</button>
        </form>
    </section>

    <section>
        <h2 class="section-title">@L["Payout_History"]</h2>
        @if (Model.History.Count == 0)
        {
            <p class="muted small">@L["Payout_Empty"]</p>
        }
        else
        {
            @foreach (var p in Model.History)
            {
                <div class="card card-pad" style="margin-bottom:8px">
                    <strong>@StatusLabel(p.Status)</strong>
                    <span class="muted small" style="display:block">
                        @AppTimeZones.FormatDate(p.PeriodStart) – @AppTimeZones.FormatDate(p.PeriodEnd)
                        · @p.ConsultationCount @L["Payout_Items"]
                    </span>
                    <span class="muted small" style="display:block">
                        @CatalogLocalizer.Loc("Bruto", "Gross") @AppMoney.Format(p.GrossAmountUsd) · @CatalogLocalizer.Loc("Comisión", "Comm") @AppMoney.Format(p.CommissionAmountUsd)
                        · <strong class="price-tag">@CatalogLocalizer.Loc("Neto", "Net") @AppMoney.Format(p.NetAmountUsd)</strong>
                    </span>
                    @if (!string.IsNullOrEmpty(p.ExternalReference))
                    {
                        <span class="muted small" style="display:block">@CatalogLocalizer.Loc("Ref:", "Ref:") @p.ExternalReference</span>
                    }
                </div>
            }
        }
    </section>
    </div>
    <div class="bottom-nav-clearance" aria-hidden="true"></div>
</div>
