@model WebAppPet.Pages.Shared.BookingSummarySheetModel
@using WebAppPet.Application.Bookings.Shared
@{
    ViewData["TermsChecked"] = Model.AcceptTerms;
    var payReturn = Model.ContinueHref
        ?? $"{Context.Request.Path}{Context.Request.QueryString}";
    if (string.IsNullOrWhiteSpace(payReturn) || payReturn == "/")
        payReturn = "/Index";
    var editHref = Model.EditHref;
    var isSticky = Model.Presentation == BookingCheckoutPresentation.StickyContinue;
}

@if (isSticky)
{
    <aside class="checkout-sticky @(Model.ExtraClass)" data-checkout-sticky data-hotel-summary>
        <div class="checkout-sticky-inner">
            <div class="checkout-sticky-meta">
                <span class="checkout-sticky-label">@CatalogLocalizer.Loc("Anticipo hoy", "Deposit today")</span>
                <strong class="checkout-sticky-price">@AppMoney.Format(Model.Deposit)</strong>
                <small class="checkout-sticky-biz">
                    @CatalogLocalizer.Loc("Total", "Total") @AppMoney.Format(Model.Estimate) · @Model.BusinessName
                </small>
            </div>
            <a class="btn btn-primary checkout-sticky-cta"
               href="@(Model.ContinueHref ?? "#")">
                @CatalogLocalizer.Loc(Model.ContinueLabelEs, Model.ContinueLabelEn)
            </a>
        </div>
    </aside>
}
else
{
    <div class="checkout-page @(Model.ExtraClass)" data-checkout-page data-hotel-summary>
        <section class="checkout-hero card card-pad">
            <div class="checkout-merchant">
                <img src="@(Model.ImageUrl ?? Model.FallbackImage)" alt="" />
                <div>
                    <p class="checkout-kicker">@CatalogLocalizer.Loc("Estás reservando en", "You're booking at")</p>
                    <h2>@Model.BusinessName</h2>
                    <p class="muted small mb-0">@Model.Subtitle</p>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(editHref))
            {
                <a class="apple-text-link checkout-edit" href="@editHref">
                    ← @CatalogLocalizer.Loc(Model.EditHintEs, Model.EditHintEn)
                </a>
            }
        </section>

        @if (Model.Lines is { Count: > 0 } || !string.IsNullOrWhiteSpace(Model.CustomerNotes))
        {
            <section class="checkout-card card card-pad">
                <h3 class="checkout-card-title">@CatalogLocalizer.Loc("Resumen del pedido", "Order summary")</h3>
                @if (Model.Lines is { Count: > 0 })
                {
                    <div class="checkout-lines">
                        @foreach (var line in Model.Lines)
                        {
                            <div class="checkout-line">
                                <span>@CatalogLocalizer.Loc(line.LabelEs, line.LabelEn)</span>
                                <strong>@line.Value</strong>
                            </div>
                        }
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.CustomerNotes))
                {
                    <div class="checkout-line checkout-notes">
                        <span>@CatalogLocalizer.Loc("Notas", "Notes")</span>
                        <strong>@Model.CustomerNotes</strong>
                    </div>
                }
            </section>
        }

        <form method="post" class="checkout-form">
            @foreach (var h in Model.HiddenFields)
            {
                <input type="hidden" name="@h.Name" value="@h.Value" />
            }
            @foreach (var group in Model.MultiHiddenFields)
            {
                foreach (var v in group.Values)
                {
                    <input type="hidden" name="@group.Name" value="@v" />
                }
            }
            <input type="hidden" name="Pay" value="true" />

            <section class="checkout-card card card-pad">
                <h3 class="checkout-card-title">@CatalogLocalizer.Loc("Cupón", "Promo code")</h3>
                <partial name="_PromoCode" />
            </section>

            <section class="checkout-card card card-pad">
                <h3 class="checkout-card-title">@CatalogLocalizer.Loc(Model.PaymentHeadingEs, Model.PaymentHeadingEn)</h3>
                @if (Model.DefaultPayment != null)
                {
                    <div class="checkout-pay-row">
                        <div class="checkout-pay-card">
                            <span class="checkout-pay-ico" aria-hidden="true">💳</span>
                            <div>
                                <strong>@Model.DefaultPayment.Brand</strong>
                                <div class="muted small">•••• @Model.DefaultPayment.Last4</div>
                            </div>
                        </div>
                        <a class="apple-text-link" href="/Account/PaymentMethods?returnUrl=@Uri.EscapeDataString(payReturn)">
                            @CatalogLocalizer.Loc("Cambiar", "Change")
                        </a>
                    </div>
                    <input type="hidden" name="PaymentMethodId" value="@Model.DefaultPayment.Id" />
                }
                else
                {
                    <a class="btn btn-outline btn-block"
                       href="/Account/PaymentMethods?returnUrl=@Uri.EscapeDataString(payReturn)">
                        @CatalogLocalizer.Loc("Agregar método de pago", "Add payment method")
                    </a>
                }
            </section>

            <section class="checkout-card card card-pad checkout-totals">
                <div class="checkout-total-row">
                    <span>@CatalogLocalizer.Loc(Model.TotalLabelEs, Model.TotalLabelEn)</span>
                    <strong>@AppMoney.Format(Model.Estimate)</strong>
                </div>
                <div class="checkout-total-row" data-deposit-row>
                    <span>@CatalogLocalizer.Loc("Anticipo a pagar hoy", "Deposit due today")</span>
                    <strong>@AppMoney.Format(Model.Deposit)</strong>
                </div>
                @if (Model.BalanceAtBusiness > 0)
                {
                    <div class="checkout-total-row" data-balance-row>
                        <span>@CatalogLocalizer.Loc("Saldo a pagar en el negocio", "Balance due at the business")</span>
                        <strong>@AppMoney.Format(Model.BalanceAtBusiness)</strong>
                    </div>
                }
                <p class="summary-note">
                    @if (Model.BalanceAtBusiness > 0)
                    {
                        @CatalogLocalizer.Loc(
                            $"Hoy solo se cobra a tu tarjeta el anticipo del {BookingPricing.DepositRate * 100:0}% para apartar tu cupo. El saldo lo pagas directamente en {Model.BusinessName} el día del servicio. Si cancelas o el negocio no acepta la reserva, te reembolsamos el anticipo completo.",
                            $"Only the {BookingPricing.DepositRate * 100:0}% deposit is charged to your card today to hold your spot. You pay the balance directly at {Model.BusinessName} on the day of the service. If you cancel or the business declines, the full deposit is refunded.")
                    }
                    else
                    {
                        @CatalogLocalizer.Loc(
                            "Por el valor del servicio, hoy se cobra el total a tu tarjeta. Si cancelas o el negocio no acepta la reserva, te lo reembolsamos completo.",
                            "Because of the service price, the full amount is charged to your card today. If you cancel or the business declines, it is fully refunded.")
                    }
                </p>
                @if (!string.IsNullOrEmpty(Model.NoteEs) && !string.IsNullOrEmpty(Model.NoteEn))
                {
                    <p class="summary-note">@CatalogLocalizer.Loc(Model.NoteEs, Model.NoteEn)</p>
                }
                <partial name="_AcceptTerms" />
            </section>

            <div class="checkout-submit-bar">
                <button class="btn btn-primary btn-block" type="submit" asp-page-handler="Book"
                        data-terms-submit
                        disabled="@(Model.AcceptTerms ? null : "disabled")"
                        aria-describedby="AcceptTerms-error">
                    @if (Model.ShowSecureLockOnSubmit)
                    {
                        <text>🔒 </text>
                    }
                    @CatalogLocalizer.Loc(Model.SubmitLabelEs, Model.SubmitLabelEn)
                </button>
                @if (Model.ShowSecureFooter)
                {
                    <p class="muted small center" style="margin-top:8px">
                        @CatalogLocalizer.Loc("Pago seguro y encriptado", "Secure encrypted payment")
                    </p>
                }
            </div>
        </form>
    </div>
}
