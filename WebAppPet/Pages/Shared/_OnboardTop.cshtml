@{
    var backHref = ViewData["OnboardBackHref"] as string;
    var showNotif = ViewData["OnboardShowNotif"] as bool? == true;
    var notifReturn = ViewData["OnboardNotifReturn"] as string ?? "/Index";
    var showLang = ViewData["OnboardShowLang"] as bool? ?? true;
    var ctaPage = ViewData["OnboardCtaPage"] as string;
    var ctaText = ViewData["OnboardCtaText"] as string;
    var ctaHref = ViewData["OnboardCtaHref"] as string;
}
<header class="onboard-top">
    @if (!string.IsNullOrWhiteSpace(backHref))
    {
        <a class="onboard-top-back" href="@backHref" aria-label="Back">←</a>
    }
    <div class="onboard-brand">
        <img src="~/brand/v2/chombly-mark-lime.png" alt="Chombly" class="onboard-mark" asp-append-version="true" />
        <strong class="onboard-word">Chombly</strong>
    </div>
    <div class="home-top-actions">
        @if (showLang)
        {
            <partial name="_LanguageSwitch" />
        }
        @if (showNotif)
        {
            <a class="home-notif-btn" asp-page="/Account/Notifications" asp-route-returnUrl="@notifReturn"
               title="@L["Profile_Notifications"]" aria-label="@L["Profile_Notifications"]">
                <svg class="ui-ico" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 22a2.5 2.5 0 0 0 2.45-2h-4.9A2.5 2.5 0 0 0 12 22zm7-6V11a7 7 0 1 0-14 0v5l-2 2v1h18v-1l-2-2z"/></svg>
            </a>
        }
        @if (!string.IsNullOrWhiteSpace(ctaPage) && !string.IsNullOrWhiteSpace(ctaText))
        {
            <a class="btn btn-enter btn-sm onboard-top-cta" asp-page="@ctaPage">@ctaText</a>
        }
        else if (!string.IsNullOrWhiteSpace(ctaHref) && !string.IsNullOrWhiteSpace(ctaText))
        {
            <a class="btn btn-enter btn-sm onboard-top-cta" href="@ctaHref">@ctaText</a>
        }
    </div>
</header>
