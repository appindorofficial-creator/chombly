@* Shared rotating trust banner for booking flows (Hotel, Walkers, Trainers, Daycare, etc.). *@
<aside class="trust-banner" data-trust-banner aria-label="@CatalogLocalizer.Loc("Confianza Chombly", "Chombly trust")">
    <div class="trust-banner-glow" aria-hidden="true"></div>
    <div class="trust-banner-viewport">
        <div class="trust-banner-item is-active" data-trust-item aria-hidden="false">
            <span class="trust-banner-ico" aria-hidden="true">🔒</span>
            <span class="trust-banner-copy">
                <strong>@CatalogLocalizer.Loc("Reservas seguras", "Secure bookings")</strong>
                <small>@CatalogLocalizer.Loc("Tu pago y datos quedan protegidos", "Your payment and data stay protected")</small>
            </span>
        </div>
        <div class="trust-banner-item" data-trust-item aria-hidden="true">
            <span class="trust-banner-ico" aria-hidden="true">✓</span>
            <span class="trust-banner-copy">
                <strong>@CatalogLocalizer.Loc("Proveedores verificados", "Verified providers")</strong>
                <small>@CatalogLocalizer.Loc("Negocios revisados por Chombly", "Businesses reviewed by Chombly")</small>
            </span>
        </div>
        <div class="trust-banner-item" data-trust-item aria-hidden="true">
            <span class="trust-banner-ico" aria-hidden="true">💬</span>
            <span class="trust-banner-copy">
                <strong>@CatalogLocalizer.Loc("Soporte 24/7", "24/7 support")</strong>
                <small>@CatalogLocalizer.Loc("Ayuda cuando la necesites", "Help whenever you need it")</small>
            </span>
        </div>
        <div class="trust-banner-item" data-trust-item aria-hidden="true">
            <span class="trust-banner-ico" aria-hidden="true">🌿</span>
            <span class="trust-banner-copy">
                <strong>@CatalogLocalizer.Loc("Para tu tranquilidad", "For your peace of mind")</strong>
                <small>@CatalogLocalizer.Loc("Cuidado pensado para tu mascota", "Care designed for your pet")</small>
            </span>
        </div>
    </div>
    <div class="trust-banner-dots" data-trust-dots aria-hidden="true"></div>
</aside>
