@page
@model WebAppPet.Pages.Trainers.IndexModel
@{
    ViewData["Title"] = L["Trainers_Title"].Value;
    ViewData["LangCompact"] = true;
    ViewData["OnboardBackHref"] = Url.Page("/Index");
    var minDate = AppTimeZones.TodayLocalDate().ToString("yyyy-MM-dd");
}
<div class="onboard onboard-app">
    <partial name="_OnboardTop" />
    <div class="home-body hotel-flow @(Model.GroomerId.HasValue ? "has-summary" : "")">
        <h1 class="app-page-heading">@L["Trainers_Title"]</h1>
        <p class="muted small">@L["Book_AllInOne"]</p>
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    <form method="get" id="trainers-filter-form">
        <input type="hidden" name="groomerId" value="@(Model.CanSelectTrainer ? Model.GroomerId : null)" />
        <input type="hidden" name="More" value="@(Model.More ? "true" : "false")" />

        <h3 class="section-title" style="margin-top:0">@CatalogLocalizer.Loc("1. ¿Qué tipo de entrenamiento necesitas?", "1. What kind of training do you need?")</h3>
        <div class="filter-bar filter-bar-wrap">
            @foreach (var n in WebAppPet.Pages.Trainers.IndexModel.TrainingTypes)
            {
                <label class="chip @(Model.Need == n.Key ? "active" : "")">
                    <input type="radio" name="Need" value="@n.Key" @(Model.Need == n.Key ? "checked" : "")
                           onchange="this.form.submit()" style="display:none" />
                    @CatalogLocalizer.Text(n.Label)
                </label>
            }
        </div>

        <h3 class="section-title">@CatalogLocalizer.Loc("2. ¿Qué fecha?", "2. What date?")</h3>
        <partial name="_BookingDateField" model="new BookingDateFieldModel { Date = Model.Date, MinDate = minDate }" />

        <h3 class="section-title">@CatalogLocalizer.Loc("3. ¿A qué hora?", "3. What time?")</h3>
        <div class="when-row" style="flex-wrap:wrap">
            @foreach (var t in WebAppPet.Pages.Trainers.IndexModel.TimeSlots)
            {
                var taken = Model.OccupiedSlots.Contains(t);
                <label class="when-chip @(Model.Slot == t ? "active" : "") @(taken ? "is-disabled" : "")">
                    <input type="radio" name="Slot" value="@t" @(Model.Slot == t ? "checked" : "") @(taken ? "disabled" : null)
                           onchange="this.form.submit()" />
                    @t@(taken ? CatalogLocalizer.Loc(" · ocupado", " · taken") : "")
                </label>
            }
        </div>

        <h3 class="section-title">@CatalogLocalizer.Loc("4. ¿Dónde prefieres las clases?", "4. Where do you prefer classes?")</h3>
        <div class="filter-bar" style="flex-direction:column;align-items:stretch">
            @foreach (var p in WebAppPet.Pages.Trainers.IndexModel.PlaceOptions)
            {
                var on = Model.Place == p.Key;
                <label class="radio-card" style="margin-bottom:8px">
                    <input type="radio" name="Place" value="@p.Key" @(on ? "checked" : "") onchange="this.form.submit()" />
                    <div class="inner"><strong>@CatalogLocalizer.Text(p.Label)</strong></div>
                </label>
            }
        </div>

        <h3 class="section-title">@CatalogLocalizer.Loc("5. ¿Cuántas sesiones?", "5. How many sessions?")</h3>
        <div class="filter-bar" style="flex-direction:column;align-items:stretch">
            @foreach (var pkg in WebAppPet.Pages.Trainers.IndexModel.PackageOptions)
            {
                var on = Model.Sessions == pkg.Sessions;
                <label class="radio-card" style="margin-bottom:8px">
                    <input type="radio" name="Sessions" value="@pkg.Sessions" @(on ? "checked" : "") onchange="this.form.submit()" />
                    <div class="inner">
                        <strong>@CatalogLocalizer.Text(pkg.Label)</strong>
                        @if (!string.IsNullOrEmpty(pkg.Badge))
                        {
                            <div class="muted small" style="color:var(--brand)">@CatalogLocalizer.Text(pkg.Badge) — @CatalogLocalizer.Loc("mejores resultados", "best results")</div>
                        }
                    </div>
                </label>
            }
        </div>

        <h3 class="section-title">@CatalogLocalizer.Loc("6. Selecciona tu mascota", "6. Select your pet")</h3>
        <partial name="_BookingPetPicker" model="new BookingPetPickerModel { Pets = Model.Pets, PetId = Model.PetId }" />

        <h3 class="section-title">@CatalogLocalizer.Loc("7. Preferencias", "7. Preferences") <span class="muted small">@CatalogLocalizer.Loc("(opcional)", "(optional)")</span></h3>
        <div class="filter-bar filter-bar-wrap">
            @foreach (var pref in WebAppPet.Pages.Trainers.IndexModel.PrefOptions)
            {
                var on = Model.Prefs.Contains(pref.Key);
                <label class="chip filter-check @(on ? "active" : "")">
                    <input type="checkbox" name="Prefs" value="@pref.Key" @(on ? "checked" : "") onchange="this.form.submit()" />
                    @(on ? "✓ " : "")@CatalogLocalizer.Text(pref.Label)
                </label>
            }
        </div>

        <h3 class="section-title" id="trainers-results">@CatalogLocalizer.Loc("8. Entrenadores disponibles cerca de ti", "8. Trainers available near you")</h3>
        @if (!Model.CanSelectTrainer)
        {
            var trainersGate = new BookingGateNoteModel
            {
                Id = "trainers-need-basics",
                TextEs = "Completa tipo, fecha, hora, lugar, sesiones y mascota (pasos 1–6) para poder elegir un entrenador.",
                TextEn = "Complete type, date, time, place, sessions, and pet (steps 1–6) before choosing a trainer."
            };
            <partial name="_BookingGateNote" model="trainersGate" />
        }
        @if (!Model.Results.Any())
        {
            <div class="empty">@CatalogLocalizer.Loc("No hay entrenadores con esos filtros en la base de datos.", "No trainers match these filters.")</div>
        }
        @foreach (var item in Model.Results)
        {
            var t = item.Trainer;
            var selected = Model.CanSelectTrainer && Model.GroomerId == t.Id;
            <div class="hotel-card @(selected ? "selected" : "") @(Model.CanSelectTrainer ? "" : "is-locked")">
                @if (item.AvailableToday)
                {
                    <span class="badge badge-green hotel-reco">@CatalogLocalizer.Text(item.AvailabilityLabel)</span>
                }
                <div class="hotel-card-main">
                    <img src="@(t.ImageUrl ?? "/images/categories/cat-trainers-v2.png")" alt="@t.BusinessName" />
                    <div class="info">
                        <h3>@t.BusinessName</h3>
                        <div class="meta-row">
                            @if (t.ReviewCount > 0)
                            {
                                <span class="stars">★ @t.Rating.ToString("0.0")</span>
                                <span class="muted small">(@t.ReviewCount)</span>
                            }
                            @if (!string.IsNullOrEmpty(item.DistanceLabel))
                            {
                                <span class="muted small">@item.DistanceLabel</span>
                            }
                        </div>
                        <div class="muted small">@CatalogLocalizer.Text(item.AvailabilityLabel)</div>
                        <div class="price">@CatalogLocalizer.Loc("Desde", "From") $@item.UnitPrice.ToString("0") <span class="muted small">@CatalogLocalizer.Text("/ sesión")</span></div>
                    </div>
                </div>
                @{
                    var trainerChoose = new BookingChooseActionModel
                    {
                        CanSelect = Model.CanSelectTrainer,
                        Selected = selected,
                        ChooseUrl = Url.Page("./Index", new
                        {
                            Need = Model.Need,
                            Place = Model.Place,
                            Sessions = Model.Sessions,
                            When = Model.When,
                            Slot = Model.Slot,
                            Date = Model.Date,
                            PetId = Model.PetId,
                            groomerId = t.Id,
                            Notes = Model.Notes,
                            More = Model.More
                        }),
                        GateAnchorId = "trainers-need-basics",
                        ChooseLabelEs = "Elegir entrenador",
                        ChooseLabelEn = "Choose trainer"
                    };
                }
                <partial name="_BookingChooseAction" model="trainerChoose" />
            </div>
        }
        @if (Model.HasMore)
        {
            <a class="link-btn" style="display:block;text-align:center;margin:8px 0 16px"
               asp-page="./Index"
               asp-route-Need="@Model.Need"
               asp-route-Place="@Model.Place"
               asp-route-Sessions="@Model.Sessions"
               asp-route-When="@Model.When"
               asp-route-Slot="@Model.Slot"
               asp-route-Date="@Model.Date"
               asp-route-PetId="@Model.PetId"
               asp-route-groomerId="@Model.GroomerId"
               asp-route-More="true">@CatalogLocalizer.Loc("Ver más entrenadores", "See more trainers")</a>
        }
    </form>

    @if (Model.SelectedTrainer != null && Model.SelectedService != null)
    {
        <div class="card card-pad" style="margin-bottom:14px">
            <h3 class="section-title" style="margin-top:0">@CatalogLocalizer.Loc("9. Resumen", "9. Summary")</h3>
            <p><strong>@Model.SelectedTrainer.BusinessName</strong> — @Model.NeedLabel — @Model.PackageLabel</p>
            <p class="muted small">@Model.DateLabel</p>
            <p class="muted small">@Model.PlaceLabel · @CatalogLocalizer.Loc("1 sesión / semana", "1 session / week")</p>
            @if (Model.SelectedPet != null)
            {
                <p class="muted small">@CatalogLocalizer.Loc("Mascota:", "Pet:") @Model.SelectedPet.Name</p>
            }
            <div class="summary-total" style="margin-top:8px">
                <span>@CatalogLocalizer.Loc("Total estimado", "Estimated total")</span>
                <strong>$@Model.Estimate.ToString("0")</strong>
            </div>
            <p class="muted small">$@Model.UnitPrice.ToString("0") × @Model.Sessions @CatalogLocalizer.Loc("sesiones", "sessions")</p>
        </div>

        <form method="get" style="margin-bottom:8px">
            <input type="hidden" name="Need" value="@Model.Need" />
            <input type="hidden" name="Place" value="@Model.Place" />
            <input type="hidden" name="Sessions" value="@Model.Sessions" />
            <input type="hidden" name="When" value="@Model.When" />
            <input type="hidden" name="Slot" value="@Model.Slot" />
            <input type="hidden" name="Date" value="@Model.Date" />
            <input type="hidden" name="PetId" value="@Model.PetId" />
            <input type="hidden" name="groomerId" value="@Model.GroomerId" />
            <input type="hidden" name="More" value="@(Model.More ? "true" : "false")" />
            @foreach (var p in Model.Prefs)
            {
                <input type="hidden" name="Prefs" value="@p" />
            }

            <h3 class="section-title">@CatalogLocalizer.Loc("10. Notas para el entrenador", "10. Notes for the trainer") <span class="muted small">@CatalogLocalizer.Loc("(opcional)", "(optional)")</span></h3>
            <textarea class="form-control" name="Notes" rows="3" maxlength="200"
                      placeholder="@CatalogLocalizer.Loc("Objetivos, problemas de conducta, experiencia previa…", "Goals, behavior issues, prior experience…")"
                      onchange="this.form.submit()">@Model.Notes</textarea>
            <p class="muted small">@CatalogLocalizer.Loc("Máx. 200 caracteres", "Max. 200 characters")</p>
        </form>
    }

    <partial name="_TrustBanner" />
    </div>
    <div class="bottom-nav-clearance" aria-hidden="true"></div>
</div>

@if (Model.SelectedTrainer != null && Model.SelectedService != null)
{
    ViewData["PromoCode"] = Model.PromoCode;
    ViewData["PromoSubtotal"] = Model.PromoSubtotal > 0 ? Model.PromoSubtotal : Model.Estimate;
    ViewData["PromoDiscount"] = Model.DiscountAmount;
    ViewData["PromoError"] = Model.PromoError;
    ViewData["TermsStep"] = "12. ";
    ViewData["TermsChecked"] = Model.AcceptTerms;
    <aside class="hotel-summary">
        <div class="hotel-summary-inner">
            <h3>@L["Book_ConfirmTitle"]</h3>
            <div class="summary-hotel">
                <img src="@(Model.SelectedTrainer.ImageUrl ?? "/images/categories/cat-trainers-v2.png")" alt="" />
                <div>
                    <strong>@Model.SelectedTrainer.BusinessName</strong>
                    <div class="muted small">@Model.NeedLabel · @Model.PackageLabel</div>
                </div>
            </div>
            <div class="summary-total">
                <span>@CatalogLocalizer.Loc("Total", "Total")</span>
                <strong>$@Model.Estimate.ToString("0")</strong>
            </div>

            <form method="post">
                <input type="hidden" name="Need" value="@Model.Need" />
                <input type="hidden" name="Place" value="@Model.Place" />
                <input type="hidden" name="Sessions" value="@Model.Sessions" />
                <input type="hidden" name="When" value="@Model.When" />
                <input type="hidden" name="Slot" value="@Model.Slot" />
                <input type="hidden" name="Date" value="@Model.Date" />
                <input type="hidden" name="PetId" value="@Model.PetId" />
                <input type="hidden" name="GroomerId" value="@Model.GroomerId" />
                <input type="hidden" name="Notes" value="@Model.Notes" />
                @foreach (var p in Model.Prefs)
                {
                    <input type="hidden" name="Prefs" value="@p" />
                }

                <partial name="_PromoCode" />

                <h4 class="summary-sub">@CatalogLocalizer.Loc("11. Método de pago", "11. Payment method")</h4>
                @if (Model.DefaultPayment != null)
                {
                    <div class="pay-row">
                        <span>💳 @Model.DefaultPayment.Brand •••• @Model.DefaultPayment.Last4</span>
                        <a asp-page="/Account/PaymentMethods">@CatalogLocalizer.Loc("Cambiar", "Change")</a>
                    </div>
                    <input type="hidden" name="PaymentMethodId" value="@Model.DefaultPayment.Id" />
                }
                else
                {
                    <a class="btn btn-outline btn-block btn-sm" asp-page="/Account/PaymentMethods" style="margin-bottom:10px">@CatalogLocalizer.Loc("+ Agregar método de pago", "+ Add payment method")</a>
                }

                <partial name="_AcceptTerms" />

                <button class="btn btn-primary btn-block" type="submit" asp-page-handler="Book" style="margin-top:10px"
                        aria-describedby="AcceptTerms-error">
                    @CatalogLocalizer.Loc("Confirmar reserva", "Confirm booking") · $@Model.Estimate.ToString("0")
                </button>
                <p class="muted small" style="text-align:center;margin-top:8px">@CatalogLocalizer.Loc("Pago seguro y encriptado", "Secure encrypted payment")</p>
            </form>
        </div>
    </aside>
}
