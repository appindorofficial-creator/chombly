@page "/Vet"
@model WebAppPet.Pages.Vet.IndexModel
@{
    ViewData["Title"] = L["Vet_Title"].Value;
    ViewData["LangCompact"] = true;
    ViewData["OnboardBackHref"] = Model.BackHref;
}
<div class="onboard onboard-app">
    <partial name="_OnboardTop" />
    <div class="home-body hotel-flow">
        <h1 class="app-page-heading">@L["Vet_Title"]</h1>
        <p class="muted small">@CatalogLocalizer.Loc("Elige una opción", "Pick one option")</p>
        <p class="muted" style="margin-bottom:16px">
            @(Model.ShowUsLocalConsult
                ? CatalogLocalizer.Loc(
                    "Orientación online, consulta local o clínica. Emergencia: gratis con Care (sin reserva en la app).",
                    "Online guidance, local consult, or clinic. Emergency: free with Care (no in-app booking).")
                : CatalogLocalizer.Loc(
                    "Orientación online o clínica presencial. Emergencia: gratis con Care (sin reserva en la app).",
                    "Online guidance or in-clinic visit. Emergency: free with Care (no in-app booking)."))
        </p>

        <div class="vet-modality-grid">
            <form method="post" asp-page-handler="StartGuidance" class="vet-modality-card">
                @if (Model.PetId is int pid)
                {
                    <input type="hidden" name="PetId" value="@pid" />
                }
                <button type="submit" class="vet-modality-btn">
                    <span class="vet-modality-icon" aria-hidden="true">🌍</span>
                    <strong>@CatalogLocalizer.Loc("Virtual", "Virtual")</strong>
                    <span class="muted small">
                        @(Model.ShowUsLocalConsult
                            ? CatalogLocalizer.Loc("Veterinario online · sin receta de EE.UU.", "Online vet · no U.S. prescription")
                            : CatalogLocalizer.Loc("Veterinario online · orientación a distancia", "Online vet · remote guidance"))
                    </span>
                </button>
            </form>

            @if (Model.ShowUsLocalConsult)
            {
            <form method="post" asp-page-handler="StartLocal" class="vet-modality-card">
                @if (Model.PetId is int pid2)
                {
                    <input type="hidden" name="PetId" value="@pid2" />
                }
                <button type="submit" class="vet-modality-btn">
                    <span class="vet-modality-icon" aria-hidden="true">💻</span>
                    <strong>@CatalogLocalizer.Loc("Consulta local", "Local consult")</strong>
                    <span class="muted small">@CatalogLocalizer.Loc("Teleconsulta en tu estado (puede requerir VCPR)", "Teleconsult in your state (may need VCPR)")</span>
                </button>
            </form>
            }

            <a class="vet-modality-card vet-modality-btn" asp-page="/Groomers/Index" asp-route-category="vet">
                <span class="vet-modality-icon" aria-hidden="true">🏥</span>
                <strong>@CatalogLocalizer.Loc("Clínica presencial", "In-clinic visit")</strong>
                <span class="muted small">@CatalogLocalizer.Loc("Buscar clínicas cerca", "Find clinics nearby")</span>
            </a>

            <a class="vet-modality-card vet-modality-btn vet-modality-emergency" asp-page="/Vet/Emergency">
                <span class="vet-modality-icon" aria-hidden="true">🚨</span>
                <strong>@CatalogLocalizer.Loc("Emergencia", "Emergency")</strong>
                <span class="muted small">@CatalogLocalizer.Loc("Llamar y ruta 24/7 · gratis con Care", "Call & directions 24/7 · free with Care")</span>
            </a>
        </div>
    </div>
    <div class="bottom-nav-clearance" aria-hidden="true"></div>
</div>
