@page
@model WebAppPet.Pages.Vet.International.BreedMatchModel
@{
    ViewData["Title"] = CatalogLocalizer.Loc("Experiencia con la raza", "Breed experience");
    ViewData["LangCompact"] = true;
    ViewData["OnboardBackHref"] = Url.Page("/Vet/International/MatchMode", new { consultationId = Model.ConsultationId });
    var hasBreed = !string.IsNullOrWhiteSpace(Model.Breed);
}
<div class="onboard onboard-app">
    <partial name="_OnboardTop" />
    <div class="home-body hotel-flow intl-breed-page">
        <p class="intl-home-kicker">@CatalogLocalizer.Loc("Orientación internacional", "International guidance")</p>
        <h1 class="app-page-heading intl-breed-title">
            @CatalogLocalizer.Loc("¿Qué experiencia de raza buscas?", "What breed experience do you need?")
        </h1>
        <p class="muted intl-breed-lead">
            @CatalogLocalizer.Loc(
                "Priorizamos veterinarios con especialidad verificada — no por nacionalidad.",
                "We prioritize vets with verified specialty — not by nationality.")
        </p>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }

        @if (hasBreed)
        {
            <div class="intl-match-breed" role="status">
                <span class="intl-match-breed-label">@CatalogLocalizer.Loc("En el perfil de tu mascota", "On your pet’s profile")</span>
                <strong class="intl-match-breed-value">@Model.Breed</strong>
            </div>
        }

        <form method="post" class="intl-breed-form" data-intl-breed-form>
            <input type="hidden" asp-for="ConsultationId" />

            <label class="intl-field intl-breed-field">
                <span>@CatalogLocalizer.Loc("Raza", "Breed")</span>
                <input
                    class="input intl-breed-input"
                    asp-for="Breed"
                    list="breed-list"
                    placeholder="@CatalogLocalizer.Loc("Ej. Pastor alemán", "e.g. German Shepherd")"
                    autocomplete="off" />
                <datalist id="breed-list">
                    @foreach (var b in Model.SuggestedBreeds)
                    {
                        <option value="@b"></option>
                    }
                </datalist>
            </label>

            @if (Model.SuggestedBreeds.Count > 0)
            {
                <div class="intl-breed-suggestions" role="group" aria-label="@CatalogLocalizer.Loc("Razas con experiencia verificada", "Breeds with verified experience")">
                    <p class="intl-breed-suggestions-label">
                        @CatalogLocalizer.Loc("Sugerencias verificadas", "Verified suggestions")
                    </p>
                    <div class="intl-breed-chips">
                        @foreach (var b in Model.SuggestedBreeds.Take(10))
                        {
                            var active = string.Equals(Model.Breed, b, StringComparison.OrdinalIgnoreCase);
                            <button type="button" class="intl-breed-chip @(active ? "is-active" : null)" data-breed="@b">@b</button>
                        }
                    </div>
                </div>
            }

            <p class="muted small intl-breed-note">
                @CatalogLocalizer.Loc(
                    "El origen de la raza es contexto cultural; la coincidencia usa especialidad verificada.",
                    "Breed origin is cultural context; matching uses verified specialty.")
            </p>

            <div class="intl-breed-cta">
                <button type="submit" class="btn btn-primary btn-block btn-lg">
                    @CatalogLocalizer.Loc("Buscar coincidencias", "Find matches")
                </button>
            </div>
        </form>
    </div>
    <div class="bottom-nav-clearance" aria-hidden="true"></div>
</div>
@section Scripts {
<script>
(function () {
  var form = document.querySelector('[data-intl-breed-form]');
  if (!form) return;
  var input = form.querySelector('.intl-breed-input');
  form.querySelectorAll('[data-breed]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var breed = btn.getAttribute('data-breed') || '';
      if (input) {
        input.value = breed;
        input.focus();
      }
      form.querySelectorAll('.intl-breed-chip').forEach(function (chip) {
        chip.classList.toggle('is-active', chip === btn);
      });
    });
  });
})();
</script>
}
