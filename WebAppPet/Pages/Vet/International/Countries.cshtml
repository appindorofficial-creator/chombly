@page
@model WebAppPet.Pages.Vet.International.CountriesModel
@using WebAppPet.Services
@{
    ViewData["Title"] = CatalogLocalizer.Loc("Países", "Countries");
    ViewData["LangCompact"] = true;
    ViewData["OnboardBackHref"] = Url.Page("/Vet/International/MatchMode", new { consultationId = Model.ConsultationId });
    var available = Model.Countries.Where(c => c.Status == CountryMarketStatus.Available).ToList();
    var upcoming = Model.Countries.Where(c => c.Status != CountryMarketStatus.Available).ToList();
}
<div class="onboard onboard-app">
    <partial name="_OnboardTop" />
    <div class="home-body hotel-flow intl-countries-page">
        <p class="intl-home-kicker">@CatalogLocalizer.Loc("Orientación internacional", "International guidance")</p>
        <h1 class="app-page-heading intl-countries-title">
            @CatalogLocalizer.Loc("Elige el país de tu veterinario", "Choose your vet’s country")
        </h1>
        <p class="muted intl-countries-lead">
            @CatalogLocalizer.Loc(
                "Solo los mercados Disponibles permiten reservar ahora.",
                "Only Available markets can be booked now.")
        </p>

        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <div class="alert alert-success">@Model.Message</div>
        }
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }

        <form method="get" class="intl-countries-search" role="search">
            <input type="hidden" name="consultationId" value="@Model.ConsultationId" />
            <label class="intl-countries-search-field">
                <svg class="intl-countries-search-ico" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
                <input class="input intl-countries-search-input" name="q" value="@Model.Q" placeholder="@CatalogLocalizer.Loc("Buscar país…", "Search country…")" autocomplete="off" aria-label="@CatalogLocalizer.Loc("Buscar país", "Search country")" />
            </label>
            <button type="submit" class="btn btn-primary intl-countries-search-btn">@L["Common_Search"]</button>
        </form>

        <form method="post" asp-page-handler="Select" class="intl-countries-form" data-intl-countries-form>
            <input type="hidden" asp-for="ConsultationId" />
            <input type="hidden" name="Q" value="@Model.Q" />

            <section class="intl-countries-section" aria-labelledby="intl-available-heading">
                <div class="intl-countries-section-head">
                    <h2 id="intl-available-heading" class="intl-countries-section-title">
                        @CatalogLocalizer.Loc("Disponibles", "Available")
                    </h2>
                    <span class="intl-countries-count">@available.Count</span>
                </div>

                @if (available.Count == 0)
                {
                    <p class="muted small intl-countries-empty">
                        @CatalogLocalizer.Loc("No hay mercados disponibles con ese filtro.", "No available markets match that filter.")
                    </p>
                }
                else
                {
                    <div class="intl-countries-list" role="radiogroup" aria-label="@CatalogLocalizer.Loc("Países disponibles", "Available countries")">
                        @foreach (var c in available)
                        {
                            var selected = string.Equals(Model.SelectedIso, c.Iso2, StringComparison.OrdinalIgnoreCase);
                            <label class="intl-country-option @(selected ? "is-selected" : null)">
                                <input type="radio" name="SelectedIso" value="@c.Iso2" checked="@selected" />
                                <span class="intl-country-option-inner">
                                    <span class="intl-country-code" aria-hidden="true">@c.Iso2</span>
                                    <span class="intl-country-copy">
                                        <span class="intl-country-title-row">
                                            <strong>@CountryCatalogService.DisplayName(c)</strong>
                                            <span class="intl-country-pill is-available">@CountryCatalogService.StatusLabel(c.Status)</span>
                                        </span>
                                        <span class="intl-country-meta">@(c.PrimaryLanguage?.ToUpperInvariant())</span>
                                    </span>
                                    <span class="intl-match-check" aria-hidden="true"></span>
                                </span>
                            </label>
                        }
                    </div>
                }
            </section>

            <div class="intl-countries-cta">
                <button type="submit" class="btn btn-primary btn-block btn-lg" @(available.Count == 0 ? "disabled" : null)>
                    @L["Common_Continue"]
                </button>
            </div>
        </form>

        @if (upcoming.Count > 0)
        {
            <section class="intl-countries-section intl-countries-upcoming" aria-labelledby="intl-upcoming-heading">
                <div class="intl-countries-section-head">
                    <h2 id="intl-upcoming-heading" class="intl-countries-section-title">
                        @CatalogLocalizer.Loc("Próximamente", "Coming soon")
                    </h2>
                    <span class="intl-countries-count is-muted">@upcoming.Count</span>
                </div>
                <ul class="intl-countries-soon-list">
                    @foreach (var c in upcoming.Take(12))
                    {
                        <li class="intl-country-soon">
                            <span class="intl-country-code is-muted" aria-hidden="true">@c.Iso2</span>
                            <span class="intl-country-copy">
                                <strong>@CountryCatalogService.DisplayName(c)</strong>
                                <span class="intl-country-meta">@(c.PrimaryLanguage?.ToUpperInvariant())</span>
                            </span>
                            <span class="intl-country-pill is-soon">@CountryCatalogService.StatusLabel(c.Status)</span>
                        </li>
                    }
                </ul>
                @if (upcoming.Count > 12)
                {
                    <p class="muted small intl-countries-more">
                        @CatalogLocalizer.Loc($"+{upcoming.Count - 12} más", $"+{upcoming.Count - 12} more")
                    </p>
                }
            </section>
        }
    </div>
    <div class="bottom-nav-clearance" aria-hidden="true"></div>
</div>
@section Scripts {
<script>
(function () {
  var form = document.querySelector('[data-intl-countries-form]');
  if (!form) return;
  form.querySelectorAll('.intl-country-option input[type="radio"]').forEach(function (input) {
    input.addEventListener('change', function () {
      form.querySelectorAll('.intl-country-option').forEach(function (opt) {
        opt.classList.toggle('is-selected', opt.querySelector('input') === input && input.checked);
      });
    });
  });
})();
</script>
}
