@page
@model WebAppPet.Pages.Vet.International.MatchModeModel
@{
    ViewData["Title"] = CatalogLocalizer.Loc("Cómo buscar", "How to search");
    ViewData["LangCompact"] = true;
    ViewData["OnboardBackHref"] = Url.Page("/Vet/International/Home", new { consultationId = Model.ConsultationId });
    var hasCountry = !string.IsNullOrWhiteSpace(Model.PreferredCountry);
    var hasBreed = !string.IsNullOrWhiteSpace(Model.MatchBreed);
    var langLabel = string.Equals(Model.PreferredLanguage, "en", StringComparison.OrdinalIgnoreCase)
        ? "English"
        : "Español";
}
<div class="onboard onboard-app">
    <partial name="_OnboardTop" />
    <div class="home-body hotel-flow intl-match-page">
        <p class="intl-home-kicker">@CatalogLocalizer.Loc("Orientación internacional", "International guidance")</p>
        <h1 class="app-page-heading intl-match-title">
            @CatalogLocalizer.Loc("Encuentra a tu veterinario", "Find your veterinarian")
        </h1>
        <p class="muted intl-match-lead">
            @CatalogLocalizer.Loc(
                "Usamos tu idioma y la raza de tu mascota. País y raza se pueden ajustar si quieres.",
                "We use your language and your pet’s breed. Country and breed can be adjusted if you want.")
        </p>

        <div class="intl-match-context">
            <div class="intl-match-breed" role="status">
                <span class="intl-match-breed-label">@CatalogLocalizer.Loc("Idioma", "Language")</span>
                <strong class="intl-match-breed-value">@langLabel</strong>
            </div>
            @if (hasBreed)
            {
                <div class="intl-match-breed" role="status">
                    <span class="intl-match-breed-label">@CatalogLocalizer.Loc("Raza", "Breed")</span>
                    <strong class="intl-match-breed-value">@Model.MatchBreed</strong>
                </div>
            }
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }

        <div class="intl-match-actions">
            <form method="post" class="intl-match-primary">
                <input type="hidden" asp-for="ConsultationId" />
                <input type="hidden" name="Mode" value="@IntlMatchMode.Best" />
                <button type="submit" class="btn btn-primary btn-block btn-lg intl-match-primary-btn">
                    @CatalogLocalizer.Loc("Ver mejores coincidencias", "See best matches")
                </button>
                <p class="muted small intl-match-primary-hint">
                    @CatalogLocalizer.Loc(
                        "Ranking con idioma y raza · país solo si lo elegiste.",
                        "Ranking with language and breed · country only if you chose one.")
                </p>
            </form>

            <p class="intl-match-divider" role="presentation">
                <span>@CatalogLocalizer.Loc("Opcional", "Optional")</span>
            </p>

            <div class="intl-match-filters">
                <form method="post">
                    <input type="hidden" asp-for="ConsultationId" />
                    <input type="hidden" name="Mode" value="@IntlMatchMode.Country" />
                    <button type="submit" class="intl-match-filter @(hasCountry ? "is-done" : null)">
                        <span class="intl-match-filter-ico" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg>
                        </span>
                        <span class="intl-match-filter-copy">
                            <strong>@CatalogLocalizer.Loc("País", "Country")</strong>
                            <span>
                                @(hasCountry
                                    ? CatalogLocalizer.Loc("Cambiar país preferido", "Change preferred country")
                                    : CatalogLocalizer.Loc("Seleccionar un país (opcional)", "Select a country (optional)"))
                            </span>
                        </span>
                        <span class="intl-match-filter-chev" aria-hidden="true">›</span>
                    </button>
                </form>

                <form method="post">
                    <input type="hidden" asp-for="ConsultationId" />
                    <input type="hidden" name="Mode" value="@IntlMatchMode.Breed" />
                    <button type="submit" class="intl-match-filter @(hasBreed ? "is-done" : null)">
                        <span class="intl-match-filter-ico" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M8 14c-1.2 0-2.5.8-2.5 2.2S7.2 19 9 19c2.2 0 4.5-1.4 5.5-3.2.6-1.1.7-2.3.3-3.3-.5-1.2-1.8-1.8-3.1-1.5C9.8 11.4 8.6 12.6 8 14z"/><circle cx="7.2" cy="8.2" r="1.6"/><circle cx="11.5" cy="6.8" r="1.6"/><circle cx="16" cy="8.5" r="1.6"/><circle cx="17.5" cy="12.8" r="1.5"/></svg>
                        </span>
                        <span class="intl-match-filter-copy">
                            <strong>@CatalogLocalizer.Loc("Raza", "Breed")</strong>
                            <span>
                                @(hasBreed
                                    ? CatalogLocalizer.Loc($"Cambiar raza ({Model.MatchBreed})", $"Change breed ({Model.MatchBreed})")
                                    : CatalogLocalizer.Loc("Elegir o cambiar raza (opcional)", "Choose or change breed (optional)"))
                            </span>
                        </span>
                        <span class="intl-match-filter-chev" aria-hidden="true">›</span>
                    </button>
                </form>
            </div>
        </div>

        <p class="muted small intl-match-fineprint">
            @if (MarketCountry.IsUnitedStates(AppTimeZones.CurrentCountryCode))
            {
                @CatalogLocalizer.Loc(
                    "Orientación remota · no emergencia · no receta de EE.UU.",
                    "Remote guidance · not emergency · no U.S. prescription")
            }
            else
            {
                @CatalogLocalizer.Loc(
                    "Orientación remota · no emergencia · no sustituye consulta local",
                    "Remote guidance · not an emergency · does not replace local care")
            }
        </p>
    </div>
    <div class="bottom-nav-clearance" aria-hidden="true"></div>
</div>
