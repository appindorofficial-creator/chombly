@page
@model WebAppPet.Pages.Vet.Virtual.EligibilityModel
@{
    ViewData["Title"] = CatalogLocalizer.Loc("Sin VCPR", "No VCPR");
    ViewData["LangCompact"] = true;
    ViewData["OnboardBackHref"] = Url.Page("/Vet/Virtual/Pet", new { consultationId = Model.ConsultationId });
}
<div class="onboard onboard-app">
    <partial name="_OnboardTop" />
    <div class="home-body hotel-flow">
        <h1 class="app-page-heading">@CatalogLocalizer.Loc("Falta revisión presencial", "In-person exam needed")</h1>
        <p class="muted small">@CatalogLocalizer.Loc("Para teleconsulta clínica local con receta", "For local clinical teleconsult with prescriptions")</p>
        <div class="card card-pad" style="margin-bottom:16px">
            <p>
                @CatalogLocalizer.Loc(
                    "La telemedicina veterinaria local con receta en EE.UU. requiere una VCPR previa presencial. Puedes seguir con orientación virtual, ir a una clínica, o volver al inicio.",
                    "U.S. local veterinary telemedicine with prescriptions needs a prior in-person VCPR. You can continue with virtual guidance, visit a clinic, or go back.")
            </p>
        </div>

        <div class="stack" style="gap:12px">
            <a class="btn btn-primary btn-block" asp-page="/Vet/International/Matches" asp-route-consultationId="@Model.ConsultationId">
                @CatalogLocalizer.Loc("Continuar con orientación virtual", "Continue with virtual guidance")
            </a>
            <a class="btn btn-outline btn-block" asp-page="/Groomers/Index" asp-route-category="vet">
                @CatalogLocalizer.Loc("Buscar clínica cercana", "Find a nearby clinic")
            </a>
            <a class="btn btn-outline btn-block" asp-page="/Vet/Index">
                @CatalogLocalizer.Loc("Elegir otro tipo de atención", "Choose another type of care")
            </a>
            <p class="muted small">
                @CatalogLocalizer.Loc(
                    "Una visita de vacunas presencial puede activar VCPR para futuras consultas locales en EE.UU.",
                    "An in-person vaccine visit can activate a VCPR for future U.S. local consults.")
            </p>
        </div>
    </div>
    <div class="bottom-nav-clearance" aria-hidden="true"></div>
</div>
