@page
@model WebAppPet.Pages.Vet.Virtual.SafetyModel
@{
    ViewData["Title"] = CatalogLocalizer.Loc("Seguridad y VCPR", "Safety & VCPR");
    ViewData["LangCompact"] = true;
    ViewData["OnboardBackHref"] = Url.Page("/Vet/Virtual/Pet", new { consultationId = Model.ConsultationId });
}
<div class="onboard onboard-app">
    <partial name="_OnboardTop" />
    <div class="home-body hotel-flow vet-safety-page">
        <header class="vet-safety-hero">
            <p class="vet-safety-kicker">@CatalogLocalizer.Loc("Paso de seguridad", "Safety step")</p>
            <h1 class="app-page-heading">@CatalogLocalizer.Loc("Antes de continuar", "Before you continue")</h1>
            <p class="muted small vet-safety-lead">
                @CatalogLocalizer.Loc(
                    "Revisamos signos graves y tu VCPR para orientar la consulta virtual.",
                    "We screen for red flags and your VCPR before virtual care.")
            </p>
        </header>

        <div class="vet-safety-vcpr @(Model.HasVcpr ? "is-ok" : "is-missing")" role="status">
            <span class="vet-safety-vcpr-ico" aria-hidden="true">@(Model.HasVcpr ? "✓" : "!")</span>
            <div class="vet-safety-vcpr-copy">
                @if (Model.HasVcpr)
                {
                    <strong>@CatalogLocalizer.Loc("VCPR activa registrada", "Active VCPR on file")</strong>
                    <p class="muted small mb-0">@CatalogLocalizer.Loc("Hay evidencia de revisión presencial en este estado (últimos 12 meses).", "There is evidence of an in-person exam in this state (last 12 months).")</p>
                }
                else
                {
                    <strong>@CatalogLocalizer.Loc("Sin VCPR verificable", "No verifiable VCPR")</strong>
                    <p class="muted small mb-0">
                        @if (string.Equals(Model.Consultation?.ContextCountry, "CO", StringComparison.OrdinalIgnoreCase) ||
                            string.Equals(Model.Consultation?.PetUsState, "Other", StringComparison.OrdinalIgnoreCase))
                        {
                            @CatalogLocalizer.Loc(
                                "En Colombia puedes continuar con orientación o clínica presencial. La VCPR aplica sobre todo a telemedicina clínica local en EE.UU.",
                                "In Colombia you can continue with guidance or an in-clinic visit. VCPR mainly applies to local U.S. clinical telemedicine.")
                        }
                        else
                        {
                            @CatalogLocalizer.Loc(
                                "En EE.UU. la telemedicina clínica local requiere relación veterinario-cliente-paciente previa presencial.",
                                "In the U.S., local clinical telemedicine requires a prior in-person VCPR.")
                        }
                    </p>
                }
            </div>
        </div>

        <form method="post" class="vet-safety-form" data-vet-safety>
            <input type="hidden" asp-for="ConsultationId" />

            <div class="vet-safety-section-head">
                <h2 class="section-title">@CatalogLocalizer.Loc("¿Hay alguna bandera roja ahora?", "Any red flags right now?")</h2>
                <p class="muted small">
                    @CatalogLocalizer.Loc(
                        "Marca lo que está ocurriendo, o “Ninguna de estas”. Si hay una bandera roja, te llevamos a emergencia (sin cobro en la app).",
                        "Check what is happening, or “None of these”. A red flag sends you to emergency care (no in-app charge).")
                </p>
            </div>

            <div class="vet-safety-flags" role="group" aria-label="@CatalogLocalizer.Loc("Signos de alerta", "Warning signs")">
                <label class="vet-safety-flag">
                    <input type="checkbox" asp-for="BreathingTrouble" data-safety-flag />
                    <span class="vet-safety-flag-ico" aria-hidden="true">😮‍💨</span>
                    <span class="vet-safety-flag-text">@CatalogLocalizer.Loc("Dificultad para respirar", "Breathing trouble")</span>
                    <span class="vet-safety-flag-tick" aria-hidden="true"></span>
                </label>
                <label class="vet-safety-flag">
                    <input type="checkbox" asp-for="Seizures" data-safety-flag />
                    <span class="vet-safety-flag-ico" aria-hidden="true">⚡</span>
                    <span class="vet-safety-flag-text">@CatalogLocalizer.Loc("Convulsiones", "Seizures")</span>
                    <span class="vet-safety-flag-tick" aria-hidden="true"></span>
                </label>
                <label class="vet-safety-flag">
                    <input type="checkbox" asp-for="Unconscious" data-safety-flag />
                    <span class="vet-safety-flag-ico" aria-hidden="true">💫</span>
                    <span class="vet-safety-flag-text">@CatalogLocalizer.Loc("Inconsciente o colapso", "Unconscious or collapsed")</span>
                    <span class="vet-safety-flag-tick" aria-hidden="true"></span>
                </label>
                <label class="vet-safety-flag">
                    <input type="checkbox" asp-for="SevereBleeding" data-safety-flag />
                    <span class="vet-safety-flag-ico" aria-hidden="true">🩸</span>
                    <span class="vet-safety-flag-text">@CatalogLocalizer.Loc("Sangrado severo", "Severe bleeding")</span>
                    <span class="vet-safety-flag-tick" aria-hidden="true"></span>
                </label>
                <label class="vet-safety-flag">
                    <input type="checkbox" asp-for="ToxinIngestion" data-safety-flag />
                    <span class="vet-safety-flag-ico" aria-hidden="true">☠️</span>
                    <span class="vet-safety-flag-text">@CatalogLocalizer.Loc("Ingesta de tóxico / veneno", "Toxin / poison ingestion")</span>
                    <span class="vet-safety-flag-tick" aria-hidden="true"></span>
                </label>
                <label class="vet-safety-flag">
                    <input type="checkbox" asp-for="ExtremePain" data-safety-flag />
                    <span class="vet-safety-flag-ico" aria-hidden="true">😣</span>
                    <span class="vet-safety-flag-text">@CatalogLocalizer.Loc("Dolor extremo", "Extreme pain")</span>
                    <span class="vet-safety-flag-tick" aria-hidden="true"></span>
                </label>
                <label class="vet-safety-flag">
                    <input type="checkbox" asp-for="CannotUrinate" data-safety-flag />
                    <span class="vet-safety-flag-ico" aria-hidden="true">🚫</span>
                    <span class="vet-safety-flag-text">@CatalogLocalizer.Loc("No puede orinar", "Cannot urinate")</span>
                    <span class="vet-safety-flag-tick" aria-hidden="true"></span>
                </label>
                <label class="vet-safety-flag vet-safety-flag-none">
                    <input type="checkbox" asp-for="NoRedFlags" data-safety-none />
                    <span class="vet-safety-flag-ico" aria-hidden="true">✓</span>
                    <span class="vet-safety-flag-text">@CatalogLocalizer.Loc("Ninguna de estas", "None of these")</span>
                    <span class="vet-safety-flag-tick" aria-hidden="true"></span>
                </label>
            </div>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger" style="margin:0 0 14px">@Model.ErrorMessage</div>
            }

            <div class="vet-safety-notes">
                <label class="vet-safety-notes-label" for="SafetyNotes">@CatalogLocalizer.Loc("Notas adicionales", "Additional notes") <span class="muted">@CatalogLocalizer.Loc("(opcional)", "(optional)")</span></label>
                <textarea class="vet-safety-notes-input" asp-for="SafetyNotes" id="SafetyNotes" rows="3"
                          placeholder="@CatalogLocalizer.Loc("Algo más que deba saber el equipo…", "Anything else the care team should know…")"></textarea>
            </div>

            <div class="vet-safety-emergency-hint" data-safety-emergency-hint hidden role="status">
                <strong>@CatalogLocalizer.Loc("Atención inmediata", "Immediate care")</strong>
                <p class="muted small mb-0">@CatalogLocalizer.Loc("Con una bandera roja te llevamos a emergencia: llamada y ruta, sin reserva ni pago en la app.", "A red flag routes you to emergency: call and directions, with no in-app booking or payment.")</p>
            </div>

            <button type="submit"
                    class="btn btn-primary btn-block vet-safety-submit"
                    data-safety-submit
                    disabled
                    aria-disabled="true"
                    data-label-continue="@CatalogLocalizer.Loc("Continuar con la consulta", "Continue to consultation")"
                    data-label-emergency="@CatalogLocalizer.Loc("Ir a emergencia", "Go to emergency")"
                    data-label-pick="@CatalogLocalizer.Loc("Elige una opción para continuar", "Choose an option to continue")">
                @CatalogLocalizer.Loc("Elige una opción para continuar", "Choose an option to continue")
            </button>
        </form>
    </div>
    <div class="bottom-nav-clearance" aria-hidden="true"></div>
</div>
<script>
(function () {
  var form = document.querySelector('[data-vet-safety]');
  if (!form) return;
  var btn = form.querySelector('[data-safety-submit]');
  var hint = form.querySelector('[data-safety-emergency-hint]');
  var none = form.querySelector('[data-safety-none]');
  var flags = form.querySelectorAll('[data-safety-flag]');
  if (!btn) return;
  var labelContinue = btn.getAttribute('data-label-continue') || btn.textContent;
  var labelEmergency = btn.getAttribute('data-label-emergency') || btn.textContent;
  var labelPick = btn.getAttribute('data-label-pick') || labelContinue;
  var syncing = false;

  function anyFlag() {
    return Array.prototype.some.call(flags, function (c) { return c.checked; });
  }

  function sync(from) {
    if (syncing) return;
    syncing = true;
    try {
      if (from === 'none' && none && none.checked) {
        flags.forEach(function (c) { c.checked = false; });
      } else if (from === 'flag' && anyFlag() && none) {
        none.checked = false;
      }

      var red = anyFlag();
      var ready = red || !!(none && none.checked);
      btn.disabled = !ready;
      btn.setAttribute('aria-disabled', ready ? 'false' : 'true');
      btn.textContent = !ready ? labelPick : (red ? labelEmergency : labelContinue);
      btn.classList.toggle('is-emergency', red);
      form.classList.toggle('has-red-flag', red);
      if (hint) hint.hidden = !red;
    } finally {
      syncing = false;
    }
  }

  form.addEventListener('change', function (e) {
    var t = e.target;
    if (!t) return;
    if (t.hasAttribute('data-safety-none')) sync('none');
    else if (t.hasAttribute('data-safety-flag')) sync('flag');
    else sync();
  });
  sync();
})();
</script>
