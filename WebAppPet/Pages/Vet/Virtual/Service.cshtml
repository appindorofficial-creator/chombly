@page
@model WebAppPet.Pages.Vet.Virtual.ServiceModel
@using WebAppPet.Services
@{
    ViewData["Title"] = CatalogLocalizer.Loc("Servicio y precio", "Service & price");
    ViewData["LangCompact"] = true;
    ViewData["OnboardBackHref"] = Url.Page("/Vet/Virtual/Safety", new { consultationId = Model.ConsultationId });
    var hasVcpr = Model.Consultation?.HasActiveVcpr == true;
}
<div class="onboard onboard-app">
    <partial name="_OnboardTop" />
    <div class="home-body hotel-flow vet-service-page">
        <header class="vet-service-hero">
            <p class="vet-service-kicker">@CatalogLocalizer.Loc("Paso de servicio", "Service step")</p>
            <h1 class="app-page-heading">@CatalogLocalizer.Loc("Servicio y precio", "Service & price")</h1>
            <p class="muted small vet-service-lead">
                @(Model.ShowUsLocal
                    ? CatalogLocalizer.Loc(
                        "Elige el alcance: orientación, conducta o consulta local (esta última puede requerir VCPR).",
                        "Pick the scope: guidance, behavior, or local consult (local may need a VCPR).")
                    : CatalogLocalizer.Loc(
                        "Elige el alcance: orientación virtual o sesión de conducta.",
                        "Pick the scope: virtual guidance or a behavior session."))
            </p>
        </header>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger" style="margin:0 0 14px">@Model.ErrorMessage</div>
        }

        @if (Model.HasCare && Model.CareRemaining > 0)
        {
            <section class="vet-service-care" aria-label="@CatalogLocalizer.Loc("Beneficio Care", "Care benefit")">
                <div class="vet-service-care-copy">
                    <strong>@CatalogLocalizer.Loc("Tienes Care activo", "You have active Care")</strong>
                    <p class="muted small mb-0">
                        @CatalogLocalizer.Loc(
                            $"Puedes usar 1 consulta rápida internacional ({Model.CareRemaining} restante) sin pagar de nuevo.",
                            $"You can use 1 international quick consult ({Model.CareRemaining} left) without paying again.")
                    </p>
                </div>
                <form method="post" asp-page-handler="UseCare">
                    <input type="hidden" asp-for="ConsultationId" />
                    <button type="submit" class="btn btn-outline btn-block">
                        @CatalogLocalizer.Loc("Usar consulta de Care", "Use Care consult")
                    </button>
                </form>
                <p class="muted small" style="margin:10px 0 0;text-align:center">
                    <a asp-page="/Plans/ChomblyCare" asp-route-consultationId="@Model.ConsultationId">
                        @CatalogLocalizer.Loc("Gestionar plan Care", "Manage Care plan")
                    </a>
                </p>
            </section>
        }

        <form method="post" class="vet-service-form" data-vet-service>
            <input type="hidden" asp-for="ConsultationId" />

            <div class="vet-service-section-head">
                <h2 class="section-title">@CatalogLocalizer.Loc("Elige un servicio", "Choose a service")</h2>
                <p class="muted small">@CatalogLocalizer.Loc("Toca una opción para continuar.", "Tap an option to continue.")</p>
            </div>

            <div class="vet-service-options" role="radiogroup" aria-label="@CatalogLocalizer.Loc("Servicios", "Services")">
                @foreach (var item in Model.Items)
                {
                    var isCare = item.Code == ServiceCatalogCodes.ChomblyCare;
                    if (isCare && Model.HasCare) { continue; }
                    var isLocal = item.Code == ServiceCatalogCodes.VetLocal30;
                    var isIntl = item.Code == ServiceCatalogCodes.VetIntl30;
                    var isBehavior = item.Code == ServiceCatalogCodes.BehaviorSession;
                    var selected = string.Equals(Model.ServiceCode, item.Code, StringComparison.Ordinal);
                    var icon = isCare ? "💚" : isIntl ? "🌍" : isBehavior ? "🧩" : isLocal ? "🏥" : "•";
                    var priceSuffix = isCare
                        ? CatalogLocalizer.Loc("/mes", "/mo")
                        : CatalogLocalizer.Loc("/30 min", "/30 min");
                    <label class="vet-service-option@(selected ? " is-selected" : "")">
                        <input type="radio"
                               name="ServiceCode"
                               value="@item.Code"
                               data-service-option
                               @(selected ? "checked" : null) />
                        <span class="vet-service-option-inner">
                            <span class="vet-service-option-ico" aria-hidden="true">@icon</span>
                            <span class="vet-service-option-body">
                                <span class="vet-service-option-top">
                                    <strong class="vet-service-option-name">@ServiceCatalogService.DisplayName(item)</strong>
                                    <span class="vet-service-option-price">$@item.Price.ToString("0.##")<span class="vet-service-option-unit">@priceSuffix</span></span>
                                </span>
                                <span class="vet-service-option-scope">@ServiceCatalogService.DisplayScope(item)</span>
                                <span class="vet-service-option-badges">
                                    @if (isCare)
                                    {
                                        <span class="vet-service-badge">@CatalogLocalizer.Loc("Membresía", "Membership")</span>
                                    }
                                    @if (isLocal && !hasVcpr)
                                    {
                                        <span class="vet-service-badge vet-service-badge-warn">@CatalogLocalizer.Loc("Requiere VCPR", "Needs VCPR")</span>
                                    }
                                    @if (isLocal && hasVcpr)
                                    {
                                        <span class="vet-service-badge vet-service-badge-ok">@CatalogLocalizer.Loc("VCPR activa", "Active VCPR")</span>
                                    }
                                    @if (isIntl && MarketCountry.IsUnitedStates(AppTimeZones.CurrentCountryCode))
                                    {
                                        <span class="vet-service-badge">@CatalogLocalizer.Loc("Sin receta EE.UU.", "No U.S. Rx")</span>
                                    }
                                    else if (isIntl)
                                    {
                                        <span class="vet-service-badge">@CatalogLocalizer.Loc("Orientación", "Guidance")</span>
                                    }
                                </span>
                            </span>
                            <span class="vet-service-option-tick" aria-hidden="true"></span>
                        </span>
                    </label>
                }
            </div>

            <button type="submit"
                    class="btn btn-primary btn-block vet-service-submit"
                    data-service-submit
                    disabled
                    aria-disabled="true"
                    data-label-continue="@L["Common_Continue"].Value"
                    data-label-pick="@CatalogLocalizer.Loc("Elige un servicio para continuar", "Choose a service to continue")">
                @CatalogLocalizer.Loc("Elige un servicio para continuar", "Choose a service to continue")
            </button>
        </form>
    </div>
    <div class="bottom-nav-clearance" aria-hidden="true"></div>
</div>
<script>
(function () {
  var form = document.querySelector('[data-vet-service]');
  if (!form) return;
  var btn = form.querySelector('[data-service-submit]');
  var options = form.querySelectorAll('[data-service-option]');
  if (!btn) return;
  var labelContinue = btn.getAttribute('data-label-continue') || btn.textContent;
  var labelPick = btn.getAttribute('data-label-pick') || labelContinue;

  function sync() {
    var selected = Array.prototype.some.call(options, function (r) { return r.checked; });
    btn.disabled = !selected;
    btn.setAttribute('aria-disabled', selected ? 'false' : 'true');
    btn.textContent = selected ? labelContinue : labelPick;
    form.querySelectorAll('.vet-service-option').forEach(function (lab) {
      var input = lab.querySelector('[data-service-option]');
      lab.classList.toggle('is-selected', !!(input && input.checked));
    });
  }

  form.addEventListener('change', function (e) {
    if (e.target && e.target.hasAttribute('data-service-option')) sync();
  });
  form.addEventListener('submit', function (e) {
    sync();
    if (btn.disabled) {
      e.preventDefault();
      e.stopPropagation();
    }
  });
  sync();
})();
</script>
