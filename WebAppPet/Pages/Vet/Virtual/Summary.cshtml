@page "{id:int}"
@model WebAppPet.Pages.Vet.Virtual.SummaryModel
@{
    ViewData["Title"] = CatalogLocalizer.Loc("Resumen", "Summary");
    ViewData["LangCompact"] = true;
    ViewData["OnboardBackHref"] = Model.BackHref;
    var c = Model.Consultation;
    var when = c?.ScheduledAt is DateTime dt ? AppTimeZones.FormatShort(dt) : "—";
    var statusLabel = c is null ? "" : VetDisplay.StatusLabel(c.Status);
}
<div class="onboard onboard-app">
    <partial name="_OnboardTop" />
    <div class="home-body hotel-flow vet-summary-page">
        <header class="vet-summary-hero">
            <p class="vet-matches-kicker">@CatalogLocalizer.Loc("Virtual", "Virtual")</p>
            <div class="vet-summary-check" aria-hidden="true">✓</div>
            <h1 class="app-page-heading">@CatalogLocalizer.Loc("Consulta confirmada", "Consult confirmed")</h1>
            <p class="muted small vet-summary-lead">
                @CatalogLocalizer.Loc(
                    "Tu reserva quedó lista. El veterinario añadirá la nota clínica al historial.",
                    "Your booking is set. The vet will add the clinical note to the history.")
            </p>
        </header>

        <article class="vet-summary-card">
            <div class="vet-summary-card-top">
                <div>
                    <strong class="vet-summary-provider">@(c?.Provider?.BusinessName ?? "—")</strong>
                    <p class="muted small mb-0">
                        @(c?.Pet?.Name ?? "—") · @when
                    </p>
                </div>
                @if (Model.UsingCare)
                {
                    <span class="vet-match-badge vet-match-badge-care">@CatalogLocalizer.Loc("Care · $0", "Care · $0")</span>
                }
                else if (c != null)
                {
                    <span class="vet-match-badge">$@c.PriceCharged.ToString("0.##")</span>
                }
            </div>

            <div class="vet-summary-meta">
                @if (!string.IsNullOrEmpty(statusLabel))
                {
                    <span class="vet-summary-pill">@statusLabel</span>
                }
                @if (Model.IsIntl)
                {
                    <span class="vet-summary-pill">@CatalogLocalizer.Loc("Orientación", "Guidance")</span>
                }
                <span class="vet-summary-pill vet-summary-pill-muted">#@Model.Id</span>
            </div>

            @if (Model.CatalogItem != null)
            {
                <p class="vet-summary-service">
                    <strong>@ServiceCatalogService.DisplayName(Model.CatalogItem)</strong>
                </p>
                <p class="muted small mb-0">@ServiceCatalogService.DisplayScope(Model.CatalogItem)</p>
            }

            <div class="vet-summary-video" role="status">
                <span class="vet-summary-video-ico" aria-hidden="true">📹</span>
                <div>
                    <strong>@CatalogLocalizer.Loc("Sala de video", "Video room")</strong>
                    <p class="muted small mb-0">@CatalogLocalizer.Loc("Disponible pronto — te avisamos antes de la cita.", "Coming soon — we’ll notify you before the appointment.")</p>
                </div>
            </div>
        </article>

        <section class="vet-summary-notes">
            <h2 class="section-title">@CatalogLocalizer.Loc("Nota del veterinario", "Vet note")</h2>
            @if (Model.HasProviderNotes)
            {
                <div class="vet-history-note">@c!.ClinicalNotes</div>
                <p class="muted small" style="margin-top:8px;margin-bottom:0">
                    @CatalogLocalizer.Loc("Visible en el historial de la mascota.", "Visible in the pet’s history.")
                </p>
            }
            else
            {
                <p class="muted small mb-0">
                    @CatalogLocalizer.Loc(
                        "Aún no hay nota clínica. El negocio la escribe después de la consulta.",
                        "No clinical note yet. The business adds it after the consult.")
                </p>
            }
        </section>

        <div class="vet-summary-actions">
            @if (!string.IsNullOrEmpty(Model.PetHistoryHref))
            {
                <a class="btn btn-outline btn-block" href="@Model.PetHistoryHref">
                    @CatalogLocalizer.Loc($"Ver historial de {c?.Pet?.Name}", $"View {c?.Pet?.Name}'s history")
                </a>
            }
            @if (c?.AppointmentId is int aid)
            {
                <a class="btn btn-outline btn-block" asp-page="/Appointments/Details" asp-route-id="@aid">
                    @CatalogLocalizer.Loc("Ver cita", "View appointment")
                </a>
            }
            <a class="btn btn-outline btn-block" asp-page="/Vet/Index">
                @CatalogLocalizer.Loc("Volver a Veterinaria", "Back to Veterinary")
            </a>
        </div>
    </div>
    <div class="bottom-nav-clearance" aria-hidden="true"></div>
</div>
