@page
@using WebAppPet.Pages.Shared
@model WebAppPet.Pages.Walkers.IndexModel
@{
    var configureHref = BookingCheckoutUrls.ForPage(ViewContext, pay: false);
    var checkoutHref = BookingCheckoutUrls.ForPage(ViewContext, pay: true);
    var showCheckout = Model.Pay && (Model.GroomerId.HasValue && Model.SelectedPet != null && Model.HasDate && Model.HasSlot && Model.HasDuration);
    var showSticky = !Model.Pay && (Model.GroomerId.HasValue && Model.SelectedPet != null && Model.HasDate && Model.HasSlot && Model.HasDuration);

    ViewData["Title"] = L["Walkers_Title"].Value;
    ViewData["LangCompact"] = true;
    ViewData["OnboardBackHref"] = Model.Pay ? configureHref : Url.Page("/Index");
    var minDate = AppTimeZones.TodayLocalDate().ToString("yyyy-MM-dd");
}
<div class="onboard onboard-app">
    <partial name="_OnboardTop" />
    <div class="home-body hotel-flow @(showSticky ? "has-checkout-sticky" : null) @(showCheckout ? "is-checkout" : null)">
        @if (showCheckout)
        {
            <h1 class="app-page-heading">@CatalogLocalizer.Loc("Confirmar y pagar", "Confirm and pay")</h1>
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger">@Model.ErrorMessage</div>
            }
        }
        else
        {
        <h1 class="app-page-heading">@L["Walkers_Title"]</h1>
        <p class="muted small">@L["Book_AllInOne"]</p>
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    <form method="get" id="walkers-filter-form">
        <input type="hidden" name="groomerId" value="@(Model.CanSelectWalker ? Model.GroomerId : null)" />
        <input type="hidden" name="More" value="@(Model.More ? "true" : "false")" />

        <h3 class="section-title" style="margin-top:0">@CatalogLocalizer.Loc("1. ¿Qué fecha necesitas?", "1. What date do you need?")</h3>
        <partial name="_BookingDateField" model="new BookingDateFieldModel { Date = Model.Date, MinDate = minDate }" />

        <h3 class="section-title">@CatalogLocalizer.Loc("2. ¿A qué hora?", "2. What time?")</h3>
        <partial name="_BookingTimeSlots" model="new BookingTimeSlotsModel {
            Slots = WebAppPet.Pages.Walkers.IndexModel.TimeSlots,
            Selected = Model.Slot,
            PastSlots = Model.PastSlots,
            OccupiedSlots = Model.OccupiedSlots
        }" />
        @if (Model.HasDate && Model.PastSlots.Count == IndexModel.TimeSlots.Length)
        {
            <p class="field-error" role="alert">@CatalogLocalizer.Loc("No quedan horarios para esa fecha. Elige otro día.", "No times left for that date. Choose another day.")</p>
        }

        <h3 class="section-title">@CatalogLocalizer.Loc("3. ¿Cuánto tiempo?", "3. How long?")</h3>
        <div class="when-row">
            @foreach (var d in WebAppPet.Pages.Walkers.IndexModel.DurationOptions)
            {
                <label class="when-chip @(Model.Duration == d ? "active" : "")">
                    <input type="radio" name="Duration" value="@d" @(Model.Duration == d ? "checked" : "") />
                    @d @CatalogLocalizer.Loc("min", "min")
                </label>
            }
        </div>

        @{
            var walkersPetPicker = new BookingPetMultiPickerModel
            {
                Pets = Model.Pets,
                PetIds = Model.PetIds,
                PrimaryPetId = Model.PetId,
                AllowedSpecies = new[] { PetSpecies.Dog },
                TitleEs = "4. ¿Para qué mascotas?",
                TitleEn = "4. Which pets?",
                HintEs = "Solo perros. Activa uno o varios (máx. 6).",
                HintEn = "Dogs only. Turn on one or more (max 6).",
                ReturnUrl = ViewContext.HttpContext.Request.Path + ViewContext.HttpContext.Request.QueryString
            };
        }
        <partial name="_BookingPetMultiPicker" model="walkersPetPicker" />

        <h3 class="section-title">@CatalogLocalizer.Loc("5. Preferencias", "5. Preferences") <span class="muted small">@CatalogLocalizer.Loc("(opcional)", "(optional)")</span></h3>
        <div class="filter-bar">
            @foreach (var pref in WebAppPet.Pages.Walkers.IndexModel.PrefOptions)
            {
                var on = Model.Prefs.Contains(pref.Key);
                <label class="chip filter-check @(on ? "active" : "")">
                    <input type="checkbox" name="Prefs" value="@pref.Key" @(on ? "checked" : "") />
                    @(on ? "✓ " : "")@CatalogLocalizer.Text(pref.Label)
                </label>
            }
        </div>

        <h3 class="section-title" id="walkers-results">@CatalogLocalizer.Loc("6. Paseadores disponibles cerca de ti", "6. Walkers available near you")</h3>
        @if (!Model.CanSelectWalker)
        {
            var walkersGate = new BookingGateNoteModel
            {
                Id = "walkers-need-basics",
                TextEs = "Completa fecha, hora, duración y mascota (pasos 1–4) para poder elegir un paseador.",
                TextEn = "Complete date, time, duration, and pet (steps 1–4) before choosing a walker."
            };
            <partial name="_BookingGateNote" model="walkersGate" />
        }
        else if (!Model.Results.Any())
        {
            <div class="empty">@CatalogLocalizer.Loc("No hay paseadores con esos filtros en la base de datos.", "No walkers match these filters.")</div>
        }
        @foreach (var item in Model.Results)
        {
            var w = item.Walker;
            var selected = Model.CanSelectWalker && Model.GroomerId == w.Id;
            <div class="hotel-card @(selected ? "selected" : "") @(Model.CanSelectWalker ? "" : "is-locked")">
                @if (item.AvailableToday)
                {
                    <span class="badge badge-green hotel-reco">@L["Search_AvailableToday"]</span>
                }
                <div class="hotel-card-main">
                    <img src="@(w.ImageUrl ?? "/images/categories/cat-walkers-v2.png")" alt="@w.BusinessName" />
                    <div class="info">
                        <h3>@w.BusinessName</h3>
                        <div class="meta-row">
                            @if (w.ReviewCount > 0)
                            {
                                <span class="stars">★ @w.Rating.ToString("0.0")</span>
                                <span class="muted small">(@w.ReviewCount)</span>
                            }
                            @if (!string.IsNullOrEmpty(item.DistanceLabel))
                            {
                                <span class="muted small">@item.DistanceLabel</span>
                            }
                        </div>
                        <div class="price">@AppMoney.Format(item.Price) <span class="muted small">/ @Model.DisplayDuration min</span></div>
                    </div>
                </div>
                @{
                    var walkerChooseBase = Url.Page("./Index", new
                    {
                        When = Model.When,
                        Date = Model.Date,
                        Slot = Model.Slot,
                        Duration = Model.Duration,
                        PetId = Model.PetId,
                        groomerId = w.Id,
                        Notes = Model.Notes,
                        More = Model.More
                    }) ?? "";
                    var walkerChoose = new BookingChooseActionModel
                    {
                        CanSelect = Model.CanSelectWalker,
                        Selected = selected,
                        ChooseUrl = walkerChooseBase + string.Concat(Model.PetIds.Select(id => $"&PetIds={id}")),
                        GateAnchorId = "walkers-need-basics",
                        ChooseLabelEs = "Elegir paseador",
                        ChooseLabelEn = "Choose walker"
                    };
                }
                <partial name="_BookingChooseAction" model="walkerChoose" />
            </div>
        }
        @if (Model.HasMore)
        {
            <a class="link-btn" style="display:block;text-align:center;margin:8px 0 16px"
               asp-page="./Index"
               asp-route-When="@Model.When"
               asp-route-Date="@Model.Date"
               asp-route-Slot="@Model.Slot"
               asp-route-Duration="@Model.Duration"
               asp-route-PetId="@Model.PetId"
               asp-route-groomerId="@Model.GroomerId"
               asp-route-More="true">@CatalogLocalizer.Loc("Ver más paseadores", "See more walkers")</a>
        }

        @if (Model.SelectedWalker != null && Model.SelectedService != null)
        {
            <div class="card card-pad" style="margin-bottom:14px">
                <h3 class="section-title" style="margin-top:0">@CatalogLocalizer.Loc("7. Resumen", "7. Summary")</h3>
                <p><strong>@Model.SelectedWalker.BusinessName</strong></p>
                <p>@(Model.DateLabel ?? "—") · @(Model.TimeLabel ?? "—") · @(Model.HasDuration ? $"{Model.Duration} min" : "—")</p>
                @if (Model.SelectedPets.Count > 0)
                {
                    <p class="muted small">@(Model.SelectedPets.Count == 1
                        ? CatalogLocalizer.Loc("Mascota:", "Pet:")
                        : CatalogLocalizer.Loc("Mascotas:", "Pets:")) @BookingPetSelection.NamesSummary(Model.SelectedPets)</p>
                }
                <div class="summary-total" style="margin-top:8px">
                    <span>@CatalogLocalizer.Loc("Total estimado", "Estimated total")</span>
                    <strong>@AppMoney.Format(Model.Estimate)</strong>
                </div>
            </div>

            <h3 class="section-title">@CatalogLocalizer.Loc("8. Notas para el paseador", "8. Notes for the walker") <span class="muted small">@CatalogLocalizer.Loc("(opcional)", "(optional)")</span></h3>
            <textarea class="form-control" name="Notes" rows="3" maxlength="200"
                      placeholder="@CatalogLocalizer.Loc("Comportamiento, llaves, correa especial…", "Behavior, keys, special leash…")"
                     >@Model.Notes</textarea>
            <p class="muted small">@CatalogLocalizer.Loc("Máx. 200 caracteres", "Max. 200 characters")</p>
        }
    </form>

    <partial name="_TrustBanner" />
        }

@if (Model.SelectedWalker != null && Model.SelectedService != null)
{
    ViewData["PromoCode"] = Model.PromoCode;
    ViewData["PromoSubtotal"] = Model.PromoSubtotal > 0 ? Model.PromoSubtotal : Model.Estimate;
    ViewData["PromoDiscount"] = Model.DiscountAmount;
    ViewData["PromoError"] = Model.PromoError;
    var multi = new List<BookingSummaryMultiHidden>
    {
        new() { Name = "PetIds", Values = Model.PetIds.Select(id => id.ToString()) }
    };
    if (Model.Prefs.Count > 0)
        multi.Add(new BookingSummaryMultiHidden { Name = "Prefs", Values = Model.Prefs });
    <partial name="_BookingSummarySheet" model="@(new BookingSummarySheetModel
    {
        BodyId = "walkers-summary-body",
        Presentation = showCheckout ? BookingCheckoutPresentation.FullPage : BookingCheckoutPresentation.StickyContinue,
        ContinueHref = checkoutHref,
        EditHref = configureHref,
        TitleEs = "Confirmar paseo",
        TitleEn = "Confirm walk",
        EditHintEs = "Seguir editando el paseo",
        EditHintEn = "Keep editing the walk",
        BusinessName = Model.SelectedWalker.BusinessName,
        ImageUrl = Model.SelectedWalker.ImageUrl,
        FallbackImage = "/images/categories/cat-walkers-v2.png",
        Subtitle = $"{Model.DateLabel ?? "—"} · {Model.TimeLabel ?? "—"} · {(Model.HasDuration ? $"{Model.Duration} min" : "—")}",
        Estimate = Model.Estimate,
        CustomerNotes = Model.Notes,
        PaymentHeadingEs = "Método de pago",
        PaymentHeadingEn = "Payment method",
        DefaultPayment = Model.DefaultPayment,
        AcceptTerms = Model.AcceptTerms,
        SubmitLabelEs = $"Confirmar paseo · {AppMoney.Format(Model.Estimate)}",
        SubmitLabelEn = $"Confirm walk · {AppMoney.Format(Model.Estimate)}",
        HiddenFields =
        [
            new BookingSummaryHidden { Name = "When", Value = Model.When },
            new BookingSummaryHidden { Name = "Date", Value = Model.Date },
            new BookingSummaryHidden { Name = "Slot", Value = Model.Slot },
            new BookingSummaryHidden { Name = "Duration", Value = Model.Duration.ToString() },
            new BookingSummaryHidden { Name = "PetId", Value = Model.PetId.ToString() },
            new BookingSummaryHidden { Name = "GroomerId", Value = Model.GroomerId?.ToString() },
            new BookingSummaryHidden { Name = "Notes", Value = Model.Notes }
        ],
        MultiHiddenFields = multi
    })" />
}
    </div>
    <div class="bottom-nav-clearance" aria-hidden="true"></div>
</div>
